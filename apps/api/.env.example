# Datos de tu app en https://developers.eveonline.com
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:3000/auth/callback

# Clave de 32 bytes en base64 para cifrar los refresh tokens. Generar con:
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
ENC_KEY=

# ESI
ESI_COMPAT_DATE=2025-12-16
ESI_USER_AGENT=eve-ledger/0.1 (tu-email@dominio.com)

PORT=3000

# Dashboard web: tras vincular un personaje, el navegador vuelve a ${WEB_URL}/pilotos
WEB_URL=http://localhost:4321

# Sync automático de todos los personajes cada N minutos (0 = desactivado).
# ESI cachea el journal ~1 h: bajarlo de 60 no trae datos más frescos.
SYNC_INTERVAL_MIN=60

# Indicador «Omega de todas las cuentas» (pestaña Indicadores): cuántas cuentas quieres mantener
# en Omega y cuántos PLEX cuesta un mes de cada una.
OMEGA_ACCOUNTS=5
OMEGA_PLEX_PER_MONTH=500
