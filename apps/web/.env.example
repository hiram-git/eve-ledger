# URL de la API (apps/api)
API_URL=http://localhost:3000

# Número de personajes que quieres vincular (plazas en la página de pilotos)
PILOT_SLOTS=5

# Nombres extra que el dashboard acepta en la cabecera Host (separados por comas). Por defecto solo localhost,
# 127.0.0.1 y [::1]: una web que apunte su dominio a tu equipo (DNS rebinding) recibe 403
# ALLOWED_HOSTS=
