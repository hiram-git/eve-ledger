---
// Barras horizontales ordenadas: una serie por lista, el título la nombra
import { isk, iskFull } from '../lib/format';

export type BarRow = { label: string; value: number; detail?: string };

interface Props {
  title: string;
  kind: 'income' | 'expenses' | 'inventory';
  rows: BarRow[];
  limit?: number;
}
const { title, kind, rows, limit = 8 } = Astro.props;

const sorted = rows.filter((r) => r.value > 0).sort((a, b) => b.value - a.value);
const shown = sorted.slice(0, limit);
const rest = sorted.slice(limit);
if (rest.length) {
  shown.push({ label: `Otros (${rest.length})`, value: rest.reduce((n, r) => n + r.value, 0) });
}
const max = Math.max(1, ...shown.map((r) => r.value));
const total = sorted.reduce((n, r) => n + r.value, 0);
---

<section class="panel">
  <div class="panel-heading">
    <h3>{title}</h3>
    {total > 0 && <span class="meta" title={iskFull(total)}>Total {isk(total)}</span>}
  </div>
  <div class="panel-body">
    {
      shown.length === 0 ? (
        <p class="empty">Sin datos.</p>
      ) : (
        <ul>
          {shown.map((r) => (
            <li title={[r.detail ?? r.label, iskFull(r.value)].join(' · ')}>
              <span class="label">{r.label}</span>
              <span class="track">
                <span class:list={['bar', kind]} style={`width:calc((100% - 4.5rem) * ${r.value / max})`} />
                <span class="value">{isk(r.value)}</span>
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }
  .label {
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Pista tenue detrás de la barra: da escala sin añadir tinta de datos */
  .track {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 4.5rem;
    height: 12px;
    border-radius: 0 4px 4px 0;
    background: #ffffff05;
  }
  .bar {
    position: relative;
    height: 12px;
    min-width: 2px;
    border-radius: 0 4px 4px 0;
    flex-shrink: 0;
  }
  .bar.income {
    background: var(--income);
  }
  .bar.expenses {
    background: var(--expenses);
  }
  .bar.inventory {
    background: var(--inventory);
  }
  li:hover .bar {
    filter: brightness(1.2);
  }
  .value {
    position: relative;
    flex-shrink: 0;
    font: 12px var(--mono);
    color: var(--text-primary);
  }
  .empty {
    color: var(--text-muted);
    font-size: 13px;
  }
  @media (max-width: 480px) {
    li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
