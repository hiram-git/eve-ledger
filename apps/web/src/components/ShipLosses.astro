---
// Naves perdidas del período y cómo tocan el wallet. La nave se pagó al comprarla: perderla no mueve el wallet.
// Lo que lo mueve, por pérdida: el seguro (+), reponer casco y equipo (−, lo compre el piloto que sea) y el courier
// que lo lleva (−). El efecto en el wallet es la cifra titular y la suma exacta de las filas; el valor perdido es
// contexto, y las primas del período van aparte (también aseguran naves que sigues volando)
import type { Losses } from '../lib/api';
import { isk, iskFull, remaining, shortDate, shortDateTime } from '../lib/format';
import { getLang, t } from '../lib/i18n';

interface Props {
  losses: Losses;
  days: number;
  // Vista de un piloto: su nombre (la fila no repite quién la perdió)
  pilotName?: string;
}
const { losses, days, pilotName } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const fullNet = (v: number) => iskFull(v, lang, true);
// «25 sept, 09:47» no se parte entre líneas
const nbsp = (text: string) => text.replace(/ /g, ' ');
const when = (iso: string) => nbsp(shortDateTime(iso, lang));
const day = (iso: string) => nbsp(shortDate(iso, lang));
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
const tot = losses.totals;
const d = losses.replacementDays;

// Sin permiso de killmails en ningún piloto de la vista: no se sabe nada de sus pérdidas (no es «cero pérdidas»)
const noScope = losses.pilots > 0 && losses.missingScope.length === losses.pilots;
const missingNames = losses.missingScope.map((p) => p.name).join(', ');
const noContracts = losses.missingContracts.map((p) => p.name).join(', ');
// «Amamake 0.4»: la seguridad del sistema, como en el juego
const where = (l: Losses['losses'][number]) =>
  [l.system ?? `#${l.systemId}`, l.security === null ? null : l.security.toFixed(1)].filter(Boolean).join(' ');
// El porqué de cada fila, visible: quién la repuso y dónde, si la ventana sigue abierta, el courier, el seguro
const status = (l: Losses['losses'][number]) => {
  const who = l.replacedBy?.name ?? '?';
  const parts = [
    l.shipReplacedAt
      ? m.lossReplaced(who, l.replacedIn, day(l.shipReplacedAt))
      : l.replacement
        ? m.lossFitOnly(who)
        : l.open
          ? null
          : m.lossNotReplaced(d),
    l.courier?.by ? m.lossCourier(l.courier.by) : null,
    l.open ? m.lossOpen(nbsp(remaining(l.windowEndsAt, lang))) : null,
    l.insurance ? null : m.lossNoInsurance,
  ];
  return parts.filter(Boolean).join(' · ');
};
// Los componentes de la cuenta, en positivo con su operador (el lector de pantalla oye «más»/«menos»)
const parts = [
  { label: m.lossesInsurance, op: '+', word: m.opPlus, value: tot.insurance },
  { label: m.lossesReplacement, op: '−', word: m.opMinus, value: tot.replacement },
  { label: m.lossesTransport, op: '−', word: m.opMinus, value: tot.transport },
];
// Notas que cuantifican: de quién faltan pérdidas y las primas del período (aparte de la cuenta)
const notes = [
  !noScope && losses.missingScope.length > 0 ? m.lossesMissing(missingNames) : null,
  tot.premiums > 0 ? m.lossesPremiums(fmt(tot.premiums)) : null,
].filter(Boolean);
---

{
  noScope ? (
    /* Sin permiso: una franja compacta, no un panel entero para una frase */
    <section class="panel losses compact" id="perdidas" aria-labelledby="losses-title">
      <div class="panel-heading">
        <h2 id="losses-title">{m.lossesPeriod(days)}</h2>
        <span class="meta">{pilotName ? m.lossesNoScopePilot(pilotName) : m.lossesNoScopeAll}</span>
      </div>
    </section>
  ) : tot.count === 0 ? (
    <section class="panel losses compact" id="perdidas" aria-labelledby="losses-title">
      <div class="panel-heading">
        <h2 id="losses-title">{m.lossesPeriod(days)}</h2>
        <span class="meta">{m.lossesNone(days)}</span>
      </div>
      {notes.length > 0 && (
        <div class="panel-note">
          {notes.map((n) => (
            <p>{n}</p>
          ))}
        </div>
      )}
    </section>
  ) : (
    <section class="panel losses" id="perdidas" aria-labelledby="losses-title">
      <div class="panel-heading">
        <h2 id="losses-title">{m.lossesPeriod(days)}</h2>
      </div>
      <div class="panel-body losses-head">
        <div class="effect">
          <span class="label">{m.lossesWallet}</span>
          <span class:list={['value', sign(tot.walletEffect)]} title={fullNet(tot.walletEffect)}>
            {fmt(tot.walletEffect, { sign: true })}
            <small>ISK</small>
          </span>
          <p class="bridge">{m.lossesBridge(fmt(tot.value), fmt(tot.shipValue), fmt(tot.fitValue))}</p>
          {tot.open > 0 && <p class="provisional">{m.lossesProvisional(tot.open, d)}</p>}
        </div>
        {/* De dónde sale la cifra: valores en positivo, el operador en su columna */}
        <table class="breakdown">
          <caption class="sr-only">{m.lossesWallet}</caption>
          <tbody>
            {parts.map((p) => (
              <tr>
                <th scope="row">{p.label}</th>
                <td class="op">
                  <span aria-hidden="true">{p.op}</span>
                  <span class="sr-only">{p.word}</span>
                </td>
                <td title={full(p.value)}>{p.value ? fmt(p.value) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <table class="loss-table" aria-labelledby="losses-title">
        <thead>
          <tr>
            <th>{m.lossShip}</th>
            <th>{m.lossValue}</th>
            <th>{m.lossInsurance}</th>
            <th>{m.lossReplacement}</th>
            <th>{m.lossTransport}</th>
            <th>{m.lossWallet}</th>
          </tr>
        </thead>
        <tbody>
          {losses.losses.map((l) => (
            <tr class:list={{ open: l.open }}>
              <th scope="row">
                <span class="ship">{l.ship ?? `#${l.shipTypeId}`}</span>
                <span class="meta">
                  {[pilotName ? null : l.pilot, where(l), m.lossAttackers(l.attackers)].filter(Boolean).join(' · ')}
                  {' · '}
                  <time datetime={l.time}>{when(l.time)}</time>
                </span>
                <span class="status">{status(l)}</span>
              </th>
              <td data-label={m.lossValue} title={m.lossSplit(full(l.shipValue), full(l.fitValue))}>
                {fmt(l.value)}
              </td>
              <td data-label={m.lossInsurance} title={l.insurance ? full(l.insurance) : undefined}>
                {l.insurance ? fmt(l.insurance, { sign: true }) : '—'}
              </td>
              <td data-label={m.lossReplacement} title={l.replacement ? full(-l.replacement) : undefined}>
                {l.replacement ? fmt(-l.replacement) : '—'}
              </td>
              <td data-label={m.lossTransport} title={l.transport ? full(-l.transport) : undefined}>
                {l.transport ? fmt(-l.transport) : '—'}
              </td>
              <td
                data-label={m.lossWallet}
                class:list={['signed', sign(l.walletEffect)]}
                title={l.walletEffect ? fullNet(l.walletEffect) : m.lossZero}
              >
                {fmt(l.walletEffect, { sign: true })}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="panel-note losses-note">
        {notes.map((n) => (
          <p>{n}</p>
        ))}
        <p>
          {m.lossesNote}
          {tot.unpricedTypes > 0 && m.lossesUnpriced(tot.unpricedTypes)}
          {noContracts && <> {m.lossesNoContracts(noContracts)}</>}
        </p>
      </div>
    </section>
  )
}

<style>
  /* Sin permiso o sin pérdidas: el panel es una franja con su frase */
  .compact .panel-heading {
    flex-wrap: wrap;
    gap: 4px 16px;
    border-bottom: 0;
  }
  .compact .meta {
    font-size: 13px;
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: 0;
  }
  .compact .panel-note {
    border-top: 0;
    padding-top: 0;
  }
  /* El efecto en el wallet (lo que preguntas) a la izquierda y grande; de dónde sale, a la derecha */
  .losses-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    align-items: start;
    gap: 16px 40px;
  }
  .effect {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .effect .label {
    font-size: 13px;
    color: var(--text-secondary);
  }
  .effect .value {
    font: 500 32px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .effect .value.pos {
    color: var(--positive);
  }
  .effect .value.neg {
    color: var(--critical);
  }
  .effect .value small {
    margin-left: 4px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .bridge,
  .provisional {
    max-width: 58ch;
    font-size: 13px;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .provisional {
    color: var(--text-muted);
  }
  .breakdown {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
  }
  .breakdown th,
  .breakdown td {
    padding: 8px 0;
    border-top: 1px solid var(--line);
    border-bottom: 0;
    vertical-align: baseline;
  }
  .breakdown tr:first-child th,
  .breakdown tr:first-child td {
    border-top: 0;
  }
  .breakdown th {
    width: 100%;
    white-space: normal;
    padding-right: 16px;
    font: 400 13px var(--font);
    color: var(--text-secondary);
    text-align: left;
    text-transform: none;
    letter-spacing: 0;
  }
  .breakdown td {
    font: 15px var(--mono);
    color: var(--text);
    text-align: right;
    white-space: nowrap;
  }
  .breakdown td:last-child {
    padding-left: 10px;
  }
  .breakdown td.op {
    position: relative;
    width: 2ch;
    padding-left: 12px;
    color: var(--text-muted);
    text-align: center;
  }
  .loss-table {
    width: 100%;
    border-collapse: collapse;
  }
  .loss-table thead th:not(:first-child),
  .loss-table td {
    text-align: right;
  }
  .loss-table th:first-child {
    padding-left: 22px;
  }
  .loss-table th:last-child,
  .loss-table td:last-child {
    padding-right: 22px;
  }
  .loss-table tbody th {
    border-bottom-color: var(--line);
    font: inherit;
    text-align: left;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
  }
  .loss-table td {
    font: 14px var(--mono);
    color: var(--text);
    white-space: nowrap;
  }
  /* El signo del efecto en el wallet, como el del neto (más específico que la regla de la tabla) */
  .loss-table td.signed.pos {
    color: var(--positive);
  }
  .loss-table td.signed.neg {
    color: var(--critical);
  }
  .loss-table td.signed.zero {
    color: var(--text-muted);
  }
  .ship {
    display: block;
    font-weight: 500;
    color: var(--text);
  }
  .meta,
  .status {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .status {
    color: var(--text-secondary);
  }
  .losses-note {
    display: grid;
    gap: 4px;
  }
  .losses-note p {
    max-width: 62ch;
  }
  @media (max-width: 720px) {
    .losses-head {
      grid-template-columns: 1fr;
    }
  }
  /* Móvil: cada pérdida es una tarjeta (nave y su porqué arriba, cinco cifras con su etiqueta debajo) */
  @media (max-width: 600px) {
    .loss-table thead {
      display: none;
    }
    .loss-table tr {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px 12px;
      padding: 12px 16px 14px;
      border-bottom: 1px solid var(--line);
    }
    .loss-table tbody th,
    .loss-table td {
      padding: 0 !important;
      border: 0;
      text-align: left;
    }
    .loss-table tbody th {
      grid-column: 1 / -1;
    }
    .loss-table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font: 12px var(--font);
      color: var(--text-muted);
    }
  }
</style>
