---
// Ships lost in the period and what they cost. The ship was paid for when bought: losing it doesn't move the wallet.
// What moves it, per loss: the insurance (+), replacing hull and fitting (−, whichever pilot buys it) and the courier
// that carries it (−); all of that is in the net, in PvP. What didn't come back (window closed) is lost net worth.
// The headline figure is the firm part (sum of the rows); what's still to replace with the window open is an
// estimate at the average price and goes separately, in grey and with «~»: green/red only for what can no longer change.
// In a pilot's view these are THEIR ships (whoever pays for them); their wallet goes as a secondary line
import type { Losses } from '../lib/api';
import Donut from './Donut.astro';
import { isk, iskFull, remaining, shortDate, shortDateTime } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { fold } from '../lib/shares';

interface Props {
  losses: Losses;
  days: number;
  // Pilot view: their name (the row doesn't repeat who lost it)
  pilotName?: string;
}
const { losses, days, pilotName } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const fullNet = (v: number) => iskFull(v, lang, true);
// «25 sept, 09:47» and «sin seguro» don't break across lines
const nbsp = (text: string) => text.replace(/ /g, ' ');
const when = (iso: string) => nbsp(shortDateTime(iso, lang));
const day = (iso: string) => nbsp(shortDate(iso, lang));
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
const tot = losses.totals;
type Loss = Losses['losses'][number];

// No killmails permission on any pilot in the view: nothing is known about their losses (it isn't «zero losses»)
const noScope = losses.pilots > 0 && losses.missingScope.length === losses.pilots;
const missingNames = losses.missingScope.map((p) => p.name).join(', ');
const noContracts = losses.missingContracts.map((p) => p.name).join(', ');
// The same pilots without killmails or contracts: a single sentence, not the same names twice
const sameMissing = !!missingNames && missingNames === noContracts;
// «Amamake 0.4»: the system's security, as in the game
const where = (l: Loss) => [l.system ?? `#${l.systemId}`, l.security === null ? null : l.security.toFixed(1)].filter(Boolean).join('\u00a0');
// What's missing, by part: «casco ~124 M y equipo ~34,7 M» (cargo isn't fitting: the Iteron carried MTUs)
const listFmt = new Intl.ListFormat(lang, { style: 'long', type: 'conjunction' });
const missingList = (l: Loss, estimate: boolean) => {
  const v = (x: number) => nbsp(`${estimate ? '~' : ''}${fmt(x)}`);
  return listFmt.format(
    [
      l.missing.hull >= 0.5 ? m.partHull(v(l.missing.hull)) : null,
      l.missing.fit >= 0.5 ? m.partFit(v(l.missing.fit)) : null,
      l.missing.cargo >= 0.5 ? m.partCargo(v(l.missing.cargo)) : null,
    ].filter((p): p is string => !!p),
  );
};
// Capsules can't be insured: «sin seguro» only where there could have been insurance
const CAPSULES = new Set([670, 33328]);
// The why of each row, in words that don't contradict each other: what was replaced (and with what), what's missing, the courier, the insurance
const status = (l: Loss) => {
  const who = l.replacedBy?.name ?? '?';
  const left = nbsp(remaining(l.windowEndsAt, lang));
  const parts = [
    l.shipReplacedAt ? m.lossHull(who, l.replacedIn, day(l.shipReplacedAt)) : l.replacement ? m.lossFitOnly(who) : null,
    l.substitutes ? m.lossSubstitutes(l.substitutes) : null,
    l.state === 'pending'
      ? m.lossMissingPending(missingList(l, true), left)
      : l.state === 'unreplaced'
        ? m.lossMissingClosed(missingList(l, false))
        : l.state === 'nohistory' && losses.historyFrom
          ? m.lossNoHistory(day(losses.historyFrom))
          : null,
    l.courier?.by ? m.lossCourier(l.courier.by) : null,
    l.insurance || l.trivial || CAPSULES.has(l.shipTypeId) ? null : m.lossNoInsurance,
  ];
  // Short fragments don't break («sin seguro», «faltan 27 h»)
  return parts
    .filter((p): p is string => !!p)
    .map((p) => (p.length <= 32 ? nbsp(p) : p))
    .join(' · ');
};
// Losses under 1 M (capsules, starter ships) are folded into one row: they're still in the totals
const shown = losses.losses.filter((l) => !l.trivial);
const folded = losses.losses.filter((l) => l.trivial);
const foldedCount = new Map<string, number>();
for (const l of folded) foldedCount.set(l.ship ?? `#${l.shipTypeId}`, (foldedCount.get(l.ship ?? `#${l.shipTypeId}`) ?? 0) + 1);
const foldedList = [...foldedCount]
  .map(([ship, n]) => (n > 1 ? `${ship} ×${n}` : ship))
  .join(', ');
// Events: losses in the same system with less than 15 min between one and the next (an ambush, a fleet)
const EVENT_GAP_MS = 15 * 60_000;
const groups: Loss[][] = [];
for (const l of shown) {
  const g = groups.at(-1);
  const prev = g?.at(-1);
  if (g && prev && prev.systemId === l.systemId && Math.abs(new Date(prev.time).getTime() - new Date(l.time).getTime()) <= EVENT_GAP_MS) g.push(l);
  else groups.push([l]);
}
const hhmm = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const eventHead = (g: Loss[]) => {
  const first = g.at(-1)!;
  const last = g[0];
  const cost = g.reduce((n, l) => n + l.cost, 0);
  const estimate = g.some((l) => l.state === 'pending');
  return {
    text: m.lossEvent(where(first), when(first.time), hhmm.format(new Date(last.time)), g.length),
    cost,
    estimate,
  };
};
// Where the cost comes from: values as positives, the operator in its own column (the reader hears «más»/«menos»), no
// zero rows, and the sum closes on «= Te costaron» (the firm part). What's still to replace goes after, in grey
const parts = [
  { label: m.lossesInsurance, op: '+', word: m.opPlus, value: tot.insurance },
  { label: m.lossesReplacement, op: '−', word: m.opMinus, value: tot.replacement },
  { label: m.lossesTransport, op: '−', word: m.opMinus, value: tot.transport },
  { label: m.lossesUnreplacedRow, op: '−', word: m.opMinus, value: tot.unreplaced },
].filter((p) => Math.abs(p.value) >= 0.5);
const firm = tot.firmCost;
const pending = tot.toReplace >= 0.5 ? tot.toReplace : 0;
// All estimated (only losses with the window open and nothing replaced yet): the figure is the estimate, in grey
const onlyEstimate = parts.length === 0 && pending > 0;
const headValue = onlyEstimate ? -pending : firm;
// Estimated figures: «~» in front (with a thin space: «~−» read as «~~») and «estimado» for the screen reader
const approx = (v: number) => `~\u2009${fmt(v, { sign: true })}`;
// Pilot view: where the money went (their wallet, who paid for their ships, what they paid for others')
const own = losses.ownWallet;
const ownLine =
  pilotName && own
    ? m.lossesOwnWallet(pilotName, fmt(own.total, { sign: true })) +
      (own.forOthers
        ? m.lossesOwnForOthers(
            fmt(-own.forOthers),
            losses.forOthers.map((f) => `${f.ship ?? '?'} · ${f.pilot ?? '?'}`).join(', '),
          )
        : '') +
      (losses.paidByOthers.length
        ? m.lossesOwnPaidBy(losses.paidByOthers.map((p) => `${p.name ?? '?'} (−${fmt(p.amount)})`).join(', '))
        : '') +
      '.'
    : null;
// A single coverage line: whose losses (and couriers) are missing, and the premiums, separate from the sum and whose they are
const coverage = [
  !noScope && losses.missingScope.length > 0 ? (sameMissing ? m.lossesMissingBoth(missingNames) : m.lossesMissing(missingNames)) : null,
  tot.premiums > 0 ? (pilotName ? m.lossesPremiumsPilot(pilotName, fmt(tot.premiums)) : m.lossesPremiums(fmt(tot.premiums))) : null,
  tot.noHistory > 0 && losses.historyFrom ? m.lossesNoHistoryNote(tot.noHistory, day(losses.historyFrom)) : null,
]
  .filter(Boolean)
  .join(' ');
const notes = coverage ? [coverage] : [];
// Donuts: which pilot and which ship the firm cost went to (without the estimate still to replace, so the centre is the
// headline «Te costaron»: before it read 435 M next to −385 M; a loss the insurance left positive counts as 0).
// Largest to smallest, 6 + «Otros». By pilot only in the consolidated view
const costOf = (l: Loss) => Math.max(0, -(l.cost + (l.state === 'pending' ? l.toReplace : 0)));
const sumBy = (key: (l: Loss) => string) => {
  const acc = new Map<string, { label: string; value: number; count: number }>();
  for (const l of losses.losses) {
    const k = key(l);
    const cur = acc.get(k) ?? { label: k, value: 0, count: 0 };
    cur.value += costOf(l);
    cur.count += 1;
    acc.set(k, cur);
  }
  return [...acc.values()].filter((x) => x.value > 0).sort((a, b) => b.value - a.value);
};
const byPilot = pilotName ? [] : sumBy((l) => l.pilot ?? `#${l.characterId}`);
const byShip = sumBy((l) => l.ship ?? `#${l.shipTypeId}`);
const foldCount = (items: { label: string; value: number; count: number }[], other: (n: number) => string) => {
  const folded = fold(items, other);
  const rest = items.slice(folded.length - 1);
  return folded.map((f, i) => ('count' in f ? f : { ...f, count: rest.reduce((n, r) => n + r.count, 0) })) as typeof items;
};
const pilotSlices = byPilot.length > 1 ? foldCount(byPilot, m.otherPilots) : [];
const shipSlices = byShip.length > 1 ? foldCount(byShip, m.otherShips) : [];
const shareCaption = (label: string) => label;
// View of a pilot who lost nothing but paid for someone else's replacement (the Jita alt): there's a sum too
const hasAccount = tot.count > 0 || (own?.forOthers ?? 0) > 0;
---

{
  noScope ? (
    /* No permission: a compact strip, not a whole panel for one sentence */
    <section class="panel losses compact" id="perdidas" aria-labelledby="losses-title">
      <div class="panel-heading">
        <h2 id="losses-title">{m.lossesPeriod(days)}</h2>
        <span class="meta">{pilotName ? m.lossesNoScopePilot(pilotName) : m.lossesNoScopeAll}</span>
      </div>
    </section>
  ) : !hasAccount ? (
    <section class="panel losses compact" id="perdidas" aria-labelledby="losses-title">
      <div class="panel-heading">
        <h2 id="losses-title">{m.lossesPeriod(days)}</h2>
        <span class="meta">{m.lossesNone(days)}</span>
      </div>
      {notes.length > 0 && (
        <div class="panel-note">
          {notes.map((n) => (
            <p>{n}</p>
          ))}
        </div>
      )}
    </section>
  ) : (
    <section class="panel losses" id="perdidas" aria-labelledby="losses-title">
      <div class="panel-heading">
        <h2 id="losses-title">{m.lossesPeriod(days)}</h2>
      </div>
      <div class="panel-body losses-head">
        <div class="effect">
          {/* The answer to «how much did losing them cost me?»: the wallet part plus what didn't come back */}
          <h3 class="label" id="losses-cost">{pilotName ? m.lossesCostPilot(pilotName) : m.lossesCost}</h3>
          <span class:list={['value', onlyEstimate ? 'estimate' : sign(headValue)]} title={fullNet(headValue)}>
            {onlyEstimate ? approx(headValue) : fmt(headValue, { sign: true })}
            <small> ISK</small>
            {onlyEstimate && <span class="sr-only"> ({m.lossEstimate})</span>}
          </span>
          {pending > 0 && !onlyEstimate && <p class="pending-line">{m.lossesPendingLine(fmt(pending))}</p>}
          {tot.count > 0 && (
            <p class="bridge">
              {m.lossesBridge(fmt(tot.value), fmt(tot.shipValue), fmt(tot.fitValue), tot.cargoValue >= 0.5 ? fmt(tot.cargoValue) : null)}
            </p>
          )}
          {ownLine && <p class="head-note">{ownLine}</p>}
          {/* How much of the cost is already in the net, under PvP (insurance, replacement, courier): it was in the Net card's
              foot, as a third figure next to the headline */}
          {!pilotName && !onlyEstimate && Math.abs(tot.walletEffect) >= 0.5 && Math.abs(tot.walletEffect - firm) >= 0.5 && (
            <p class="head-note">{m.lossesInNet(fmt(tot.walletEffect, { sign: true }))}</p>
          )}
        </div>
        <table class="breakdown" aria-labelledby="losses-cost">
          <tbody>
            {parts.map((p) => (
              <tr>
                <th scope="row">{p.label}</th>
                <td class="op">
                  <span aria-hidden="true">{p.op}</span>
                  <span class="sr-only">{p.word}</span>
                </td>
                <td title={full(p.value)}>{fmt(p.value)}</td>
              </tr>
            ))}
            {parts.length > 0 && (
              <tr class="equals">
                <th scope="row">{m.lossesCost}</th>
                <td class="op">
                  <span aria-hidden="true">=</span>
                  <span class="sr-only">{m.opEquals}</span>
                </td>
                <td class:list={[sign(firm)]} title={fullNet(firm)}>{fmt(firm, { sign: true })}</td>
              </tr>
            )}
            {pending > 0 && (
              <tr class="estimate">
                <th scope="row">{m.lossesPendingRow}</th>
                <td class="op">
                  <span aria-hidden="true">−</span>
                  <span class="sr-only">{m.opMinus}</span>
                </td>
                <td title={full(pending)}>~{fmt(pending)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
      {(pilotSlices.length > 0 || shipSlices.length > 0) && (
        <div class="panel-body shares">
          {[
            { slices: pilotSlices, label: m.shareCostPilot, col: m.pilot },
            { slices: shipSlices, label: m.shareCostShip, col: m.lossShip },
          ]
            .filter((f) => f.slices.length > 0)
            .map((f) => (
              <figure>
                <Donut slices={f.slices} label={shareCaption(f.label)} format={fmt} lang={lang} center={fmt(headValue, { sign: true })} centerSub="ISK" />
                <table class="mini">
                  <caption class="sr-only">{shareCaption(f.label)}</caption>
                  <thead>
                    <tr>
                      <th>{f.col}</th>
                      <th>{m.lossShipsCol}</th>
                      <th>{m.lossCost}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {f.slices.map((p, i) => (
                      <tr>
                        <th scope="row">
                          <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                          {p.label}
                        </th>
                        <td>{p.count}</td>
                        <td title={full(p.value)}>{fmt(p.value)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <figcaption class="sr-only">{shareCaption(f.label)}</figcaption>
              </figure>
            ))}
        </div>
      )}
      {tot.count > 0 && (
        <table class="loss-table" aria-labelledby="losses-title">
          <thead>
            <tr>
              <th>{m.lossShip}</th>
              <th>{m.lossInsurance}</th>
              <th>{m.lossReplacement}</th>
              <th>{m.lossTransport}</th>
              <th title={m.lossWalletTitle}>{m.lossWallet}</th>
              <th title={m.lossNotBackTitle}>{m.lossNotBack}</th>
              <th title={m.lossCostTitle}>{m.lossCost}</th>
            </tr>
          </thead>
          {groups.map((g) => {
            const head = g.length > 1 ? eventHead(g) : null;
            return (
              <tbody class:list={{ event: !!head }}>
                {head && (
                  /* Several losses together (same system, minutes apart): a header with what the event cost */
                  <tr class="event-head">
                    <th colspan="7" scope="colgroup">
                      <span>{head.text}</span>
                      <span class="sr-only"> · </span>
                      <span class:list={['event-cost', head.estimate ? 'estimate' : sign(head.cost)]} title={fullNet(head.cost)}>
                        {head.estimate ? approx(head.cost) : fmt(head.cost, { sign: true })}
                        {head.estimate && <span class="sr-only"> ({m.lossEstimate})</span>}
                      </span>
                    </th>
                  </tr>
                )}
                {g.map((l) => (
                  <tr>
                    {/* The row name is only the ship: the screen reader doesn't repeat metadata and state in every cell */}
                    <th scope="row" aria-labelledby={`loss-${l.killmailId}`}>
                      <span class="ship" id={`loss-${l.killmailId}`}>{l.ship ?? `#${l.shipTypeId}`}</span>
                      <span class="meta">
                        {[pilotName ? null : l.pilot, where(l), m.lossAttackers(l.attackers)].filter(Boolean).join(' · ')}
                        {' · '}
                        <time datetime={l.time}>{when(l.time)}</time>
                        <span title={m.lossSplit(full(l.shipValue), full(l.fitValue), l.cargoValue >= 0.5 ? full(l.cargoValue) : null)}>
                          {' · '}
                          {nbsp(`${m.lossValue} ${fmt(l.value)}`)}
                        </span>
                      </span>
                      <span class="status">{status(l)}</span>
                    </th>
                    {/* No data: «—» in the table; in the mobile card the cell disappears (.empty) */}
                    <td data-label={m.lossInsurance} class:list={{ empty: !l.insurance }} title={l.insurance ? full(l.insurance) : undefined}>
                      {l.insurance ? fmt(l.insurance, { sign: true }) : '—'}
                    </td>
                    <td data-label={m.lossReplacement} class:list={{ empty: !l.replacement }} title={l.replacement ? full(-l.replacement) : undefined}>
                      {l.replacement ? fmt(-l.replacement) : '—'}
                    </td>
                    <td data-label={m.lossTransport} class:list={{ empty: !l.transport }} title={l.transport ? full(-l.transport) : undefined}>
                      {l.transport ? fmt(-l.transport) : '—'}
                    </td>
                    <td data-label={m.lossWallet} class:list={{ empty: !l.walletEffect }} title={`${m.lossWalletTitle}: ${fullNet(l.walletEffect)}`}>
                      {l.walletEffect ? fmt(l.walletEffect, { sign: true }) : '—'}
                    </td>
                    {/* What didn't come back (firm) or what's still to replace (estimated, in grey with «~») */}
                    <td
                      data-label={m.lossNotBack}
                      class:list={{ empty: !l.toReplace, estimate: l.state === 'pending' }}
                      title={l.toReplace ? `${m.lossNotBackTitle}: ${full(-l.toReplace)}` : undefined}
                    >
                      {l.toReplace ? (l.state === 'pending' ? approx(-l.toReplace) : fmt(-l.toReplace)) : '—'}
                      {l.toReplace > 0 && l.state === 'pending' && <span class="sr-only"> ({m.lossEstimate})</span>}
                    </td>
                    {/* What it cost you (Wallet − No volvió): with its sign if firm; in grey with «~» while replacement is pending */}
                    <td
                      data-label={m.lossCost}
                      class:list={['total', l.state === 'pending' ? 'estimate' : sign(l.cost)]}
                      title={`${m.lossCostTitle}: ${fullNet(l.cost)}`}
                    >
                      {l.state === 'pending' ? approx(l.cost) : fmt(l.cost, { sign: true })}
                      {l.state === 'pending' && <span class="sr-only"> ({m.lossEstimate})</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            );
          })}
          {folded.length > 0 && (
            <tbody class="folded">
              <tr>
                <th colspan="7" scope="row" title={folded.map((l) => `${l.ship ?? ''} · ${when(l.time)}`).join('\n')}>
                  {m.lossesFolded(folded.length, foldedList, fmt(folded.reduce((n, l) => n + l.value, 0)))}
                </th>
              </tr>
            </tbody>
          )}
        </table>
      )}
      {/* Coverage only (who is left out, losses before the history, premiums, unpriced types): the lesson on what a loss
          costs is gone, the figures and the row texts say it */}
      {(notes.length > 0 || tot.unpricedTypes > 0 || (noContracts && !sameMissing)) && (
        <div class="panel-note losses-note">
          {notes.map((n) => (
            <p>{n}</p>
          ))}
          {(tot.unpricedTypes > 0 || (noContracts && !sameMissing)) && (
            <p>
              {tot.unpricedTypes > 0 && m.lossesUnpriced(tot.unpricedTypes).trim()}
              {noContracts && !sameMissing && <> {m.lossesNoContracts(noContracts)}</>}
            </p>
          )}
        </div>
      )}
    </section>
  )
}

<style>
  /* The glance's «Ver» links jump here: keep the title off the edge */
  .losses {
    scroll-margin-top: 16px;
  }
  /* No permission or no losses: the panel is a strip with its sentence */
  .compact .panel-heading {
    flex-wrap: wrap;
    gap: 4px 16px;
    border-bottom: 0;
  }
  .compact .meta {
    font-size: 13px;
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: 0;
  }
  .compact .panel-note {
    border-top: 0;
    padding-top: 0;
  }
  /* The wallet effect (what you ask) on the left and large; where it comes from, on the right */
  .losses-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    align-items: start;
    gap: 16px 40px;
  }
  .effect {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .effect .label {
    margin: 0;
    font: 400 13px var(--font);
    color: var(--text-secondary);
  }
  .effect .value {
    font: 500 32px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .effect .value.pos {
    color: var(--positive);
  }
  .effect .value.neg {
    color: var(--critical);
  }
  /* All estimated: the figure can still change, in grey */
  .effect .value.estimate {
    color: var(--text-muted);
  }
  .pending-line {
    font-size: 13px;
    color: var(--text-muted);
  }
  .effect .value small {
    font-size: 13px;
    letter-spacing: 0;
    color: var(--text-muted);
  }
  .bridge,
  .head-note {
    max-width: 58ch;
    font-size: 13px;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .head-note {
    color: var(--text-muted);
  }
  .breakdown {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
  }
  .breakdown th,
  .breakdown td {
    padding: 8px 0;
    border-top: 1px solid var(--line);
    border-bottom: 0;
    vertical-align: baseline;
  }
  .breakdown tr:first-child th,
  .breakdown tr:first-child td {
    border-top: 0;
  }
  .breakdown th {
    width: 100%;
    white-space: normal;
    padding-right: 16px;
    font: 400 13px var(--font);
    color: var(--text-secondary);
    text-align: left;
    text-transform: none;
    letter-spacing: 0;
  }
  .breakdown td {
    font: 15px var(--mono);
    color: var(--text);
    text-align: right;
    white-space: nowrap;
  }
  .breakdown td:last-child {
    padding-left: 10px;
  }
  /* What's still to replace is an estimate (average price): in grey */
  .breakdown tr.estimate th,
  .breakdown tr.estimate td {
    color: var(--text-muted);
  }
  /* The «=» row: the result of the sum, with its sign */
  .breakdown tr.equals th,
  .breakdown tr.equals td {
    border-top-color: var(--line-strong);
    font-weight: 500;
    color: var(--text);
  }
  .breakdown tr.equals td.pos {
    color: var(--positive);
  }
