---
// Tabla de ítems: nombre, cantidad, ISK total y precio unitario
import { isk, iskFull } from '../lib/format';

export type ItemRow = { typeId: number; name: string | null; quantity: number; isk: number; unitPrice: number };

interface Props {
  title: string;
  step?: string;
  items: ItemRow[];
  iskLabel?: string;
  priceLabel?: string;
  empty?: string;
}
const {
  title,
  step,
  items,
  iskLabel = 'ISK',
  priceLabel = 'Precio medio',
  empty = 'Sin transacciones en el período.',
} = Astro.props;
const qty = new Intl.NumberFormat('es');
---

<section class="panel">
  <div class="panel-heading">
    <h3>{step && <span class="step-label">{step}</span>}{title}</h3>
    {items.length > 0 && <span class="meta">TOP {items.length}</span>}
  </div>
  {
    items.length === 0 ? (
      <p class="empty panel-body">{empty}</p>
    ) : (
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Ítem</th>
              <th>Cantidad</th>
              <th>{iskLabel}</th>
              <th>{priceLabel}</th>
            </tr>
          </thead>
          <tbody>
            {items.map((it) => (
              <tr>
                <td>
                  <span class="item">
                    <span class="thumb">
                      <img
                        src={`https://images.evetech.net/types/${it.typeId}/icon?size=32`}
                        alt=""
                        width="24"
                        height="24"
                        loading="lazy"
                        onerror="this.style.visibility='hidden'"
                      />
                    </span>
                    <span class="name">{it.name ?? `#${it.typeId}`}</span>
                  </span>
                </td>
                <td>{qty.format(it.quantity)}</td>
                {it.unitPrice > 0 ? (
                  <>
                    <td title={`${iskFull(it.isk)} · ${iskFull(it.unitPrice)} c/u`}>{isk(it.isk)}</td>
                    <td title={iskFull(it.unitPrice)}>{isk(it.unitPrice)}</td>
                  </>
                ) : (
                  <>
                    <td class="muted" title="Sin precio">—</td>
                    <td class="muted" title="Sin precio en ESI o copia de blueprint">—</td>
                  </>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</section>

<style>
  table th:first-child,
  table td:first-child {
    padding-left: 22px;
  }
  table th:last-child,
  table td:last-child {
    padding-right: 22px;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 16rem;
  }
  .thumb {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border: 1px solid #2b4251;
    border-radius: 5px;
    background: #162834;
  }
  .name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .empty {
    color: var(--text-muted);
    font-size: 13px;
  }
  /* En móvil: sin precio unitario (queda en el tooltip del total) y celdas más compactas */
  @media (max-width: 480px) {
    th:nth-child(4),
    td:nth-child(4) {
      display: none;
    }
    th,
    td {
      padding: 8px 6px;
    }
    table th:first-child,
    table td:first-child {
      padding-left: 16px;
    }
    table th:nth-child(3),
    table td:nth-child(3) {
      padding-right: 16px;
    }
    .item {
      max-width: 9rem;
    }
  }
</style>
