---
// Donut chart (ring) for a breakdown: each slice is an arc with a 2 px gap between neighbors, in the
// categorical palette validated on the panel background (--cat-1…7, fixed order: slice i always gets
// color i, also in the table beside it, which acts as legend and table view). No labels on the ring:
// the name, figure and % go in the table; each arc has a <title> for hover and the svg an aria-label
import type { Lang } from '../lib/i18n';

interface Props {
  slices: { label: string; value: number }[];
  label: string;
  format: (v: number) => string;
  lang: Lang;
  // Center text (e.g. the total)
  center?: string;
  centerSub?: string;
}
const { slices, label, format, lang, center, centerSub } = Astro.props;

const R = 44;
const WIDTH = 16;
const GAP = 2 / R; // 2 px gap measured on the ring's radius (viewBox of 120, the svg scales)
const total = slices.reduce((n, s) => n + Math.max(0, s.value), 0);
const pct = new Intl.NumberFormat(lang, { style: 'percent', maximumFractionDigits: 0 });
const polar = (a: number) => [60 + R * Math.cos(a - Math.PI / 2), 60 + R * Math.sin(a - Math.PI / 2)];
let start = 0;
const arcs = slices
  .map((s, i) => {
    const share = total > 0 ? Math.max(0, s.value) / total : 0;
    const sweep = share * 2 * Math.PI;
    const a0 = start;
    start += sweep;
    if (share <= 0) return null;
    // A single slice: the whole ring (two semicircles, an arc can't go all the way around)
    if (share >= 0.9999) return { i, s, share, d: `M60,16 A44,44 0 1 1 60,104 A44,44 0 1 1 60,16` };
    // The gap is split on both sides; a slice thinner than the gap is drawn as a thread
    const g = Math.min(GAP, sweep / 2 - 0.004);
    const [x0, y0] = polar(a0 + g / 2);
    const [x1, y1] = polar(a0 + sweep - g / 2);
    const large = sweep - g > Math.PI ? 1 : 0;
    return { i, s, share, d: `M${x0.toFixed(2)},${y0.toFixed(2)} A44,44 0 ${large} 1 ${x1.toFixed(2)},${y1.toFixed(2)}` };
  })
  .filter((a): a is NonNullable<typeof a> => a !== null);
const summary = arcs.map((a) => `${a.s.label} ${pct.format(a.share)}`).join(', ');
---

<svg class="donut" viewBox="0 0 120 120" role="img" aria-label={`${label}: ${summary}`}>
  {arcs.map((a) => (
    <path d={a.d} fill="none" stroke={`var(--cat-${(a.i % 7) + 1})`} stroke-width={WIDTH}>
      <title>{`${a.s.label} · ${format(a.s.value)} · ${pct.format(a.share)}`}</title>
    </path>
  ))}
  {center && (
    <text x="60" y={centerSub ? 58 : 64} text-anchor="middle" class="center">
      {center}
    </text>
  )}
  {centerSub && (
    <text x="60" y="74" text-anchor="middle" class="center-sub">
      {centerSub}
    </text>
  )}
</svg>

<style is:global>
  /* Categorical palette for breakdowns (validated in dark mode on #111c27: lightness band, chroma, CVD
     separation ≥ 8.4 between neighbors, contrast ≥ 3:1). Fixed order; never for UI nor for income/expenses */
  :root {
    --cat-1: #3987e5;
    --cat-2: #d95926;
    --cat-3: #199e70;
    --cat-4: #c98500;
    --cat-5: #d55181;
    --cat-6: #9085e9;
    --cat-7: #e66767;
  }
  .donut {
    display: block;
    width: 100%;
    height: auto;
  }
  .donut .center {
    font: 500 13px var(--mono);
    fill: var(--text);
  }
  .donut .center-sub {
    font: 400 8px var(--font);
    fill: var(--text-muted);
  }
  .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 8px;
    border-radius: 2px;
    vertical-align: 0;
  }
</style>
