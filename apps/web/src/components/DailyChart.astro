---
// Diverging columns per day: income upward, expenses downward, a single axis
import type { Summary } from '../lib/api';
import { isk, iskFull, shortDate } from '../lib/format';
import { getLang, t } from '../lib/i18n';

interface Props {
  daily: Summary['daily'];
  // First day with history (YYYY-MM-DD): anything before it isn't «cero», it's «sin datos»
  firstDate?: string | null;
  // Day of a stuck pilot's last sync (YYYY-MM-DD): anything after it isn't «cero» either
  lastDate?: string | null;
}
const { daily, firstDate, lastDate } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const date = (iso: string) => shortDate(iso, lang);
// Signed expense, without «−0» on days with no expenses
const out = (v: number) => (v ? -v : 0);

const missing = firstDate ? daily.filter((d) => d.date < firstDate).length : 0;
const trailing = lastDate ? daily.filter((d) => d.date > lastDate).length : 0;
const known = (i: number) => i >= missing && i < daily.length - trailing;

function niceStep(range: number, count = 4) {
  if (range <= 0) return 1;
  const raw = range / count;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const norm = raw / mag;
  return (norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 2.5 ? 2.5 : norm <= 5 ? 5 : 10) * mag;
}

// The axis also covers the net dot (now it's always between the two bars; before, in a pilot's view, it
// included transfers with your other pilots and a day that received 6 B left the dot outside the chart)
const maxIn = Math.max(0, ...daily.map((d) => Math.max(d.income, d.net)));
const maxOut = Math.max(0, ...daily.map((d) => Math.max(d.expenses, -d.net)));
const step = niceStep(maxIn + maxOut, 8);
const top = Math.max(step, Math.ceil(maxIn / step) * step);
const bottom = Math.ceil(maxOut / step) * step;
const span = top + bottom;
const pct = (v: number) => (v / span) * 100;
const zero = pct(bottom); // baseline height from the bottom, in %

const ticks: number[] = [];
for (let v = -bottom; v <= top + step / 2; v += step) ticks.push(Math.round(v));

// Axis labels in a single unit and with the same decimals (before, «50,0 M», «150 M» and «0» were mixed)
const axisMax = Math.max(top, bottom);
const [unit, suffix] = axisMax >= 1e9 ? [1e9, ' B'] : axisMax >= 1e6 ? [1e6, ' M'] : axisMax >= 1e3 ? [1e3, ' k'] : [1, ''];
const axisDigits = Number.isInteger(step / unit) ? 0 : 1;
const axisNum = new Intl.NumberFormat(lang, { minimumFractionDigits: axisDigits, maximumFractionDigits: axisDigits });
const axisLabel = (v: number) => (v === 0 ? '0' : `${v < 0 ? '−' : ''}${axisNum.format(Math.abs(v) / unit)}${suffix}`);

// X-axis labels: first, last and one per week
const labelEvery = daily.length > 14 ? 7 : daily.length > 7 ? 2 : 1;
const showLabel = (i: number) => i === daily.length - 1 || (daily.length - 1 - i) % labelEvery === 0;

// A single Tab stop (roving tabindex): enters on the last day with entries and is navigated with the arrow keys
const hintId = 'daily-chart-hint';
const hasActivity = (d: (typeof daily)[number]) => d.income > 0 || d.expenses > 0;
const lastActive = daily.reduce((last, d, i) => (known(i) && hasActivity(d) ? i : last), -1);
const entry = lastActive >= 0 ? lastActive : Math.max(missing, daily.length - 1 - trailing);
// Abbreviated figures (k/M/B) in the tooltip and for screen readers; the full ones are in the table
const short = (v: number, o: { sign?: boolean } = {}) => `${fmt(v, o)} ISK`;
// Table: full figure without repeating «ISK» in every cell (the unit goes in the header)
const wholeIsk = new Intl.NumberFormat(lang, { maximumFractionDigits: 0 });
const plain = (v: number) => wholeIsk.format(v).replace('-', '−');
// PLEX (account cost, separate from the game result): the part of the bar that is PLEX is hatched
const hasPlex = daily.some((d) => Math.abs(d.accounts ?? 0) >= 0.5);
const plexShare = (part: number, whole: number) => Math.min(100, (Math.abs(part) / whole) * 100);
---

<div class="legend" aria-hidden="true">
  <span><i class="key income"></i>{m.income}</span>
  <span><i class="key expenses"></i>{m.expenses}</span>
  <span><i class="key net"></i>{m.net}</span>
  {hasPlex && <span><i class="key plex"></i>{m.chartPlex}</span>}
</div>

<div
  class="chart"
  role="group"
  aria-label={m.chartLabel}
  aria-describedby={hintId}
  data-l-income={m.income}
  data-l-expenses={m.expenses}
  data-l-net={m.net}
  data-l-plex={m.chartPlexTip}
>
  <div class="y-axis" aria-hidden="true">
    {ticks.map((t) => <span style={`bottom:${pct(t + bottom)}%`}>{axisLabel(t)}</span>)}
  </div>
  <div class="plot">
    {ticks.map((t) => <div class:list={['grid', { base: t === 0 }]} style={`bottom:${pct(t + bottom)}%`} />)}
    {
      missing > 0 && (
        <div class="nodata-band" style={`width:${(missing / daily.length) * 100}%`}>
          {/* With few days the band is narrow: the label only if it fits (otherwise it read «Sin h») */}
          {missing / daily.length >= 0.15 && <span>{m.noHistory}</span>}
        </div>
      )
    }
    {
      trailing > 0 && (
        <div class="nodata-band after" style={`width:${(trailing / daily.length) * 100}%`}>
          {/* With few days the band is narrow: the label only if it fits */}
          {trailing / daily.length >= 0.15 && <span>{m.noSyncData}</span>}
        </div>
      )
    }
    <div class="cols" role="list">
      {
        daily.map((d, i) => (
          !known(i) ? (
            <div class="col nodata" aria-hidden="true" />
          ) : (
          <div
            class="col"
            role="listitem"
            tabindex={i === entry ? 0 : -1}
            aria-label={
              m.chartDay(date(d.date), short(d.income), short(out(d.expenses)), short(d.net, { sign: true })) +
              (Math.abs(d.accounts ?? 0) >= 0.5 ? m.chartDayPlex(short(d.accounts, { sign: true })) : '')
            }
            data-date={date(d.date)}
            data-income={short(d.income)}
            data-expenses={short(out(d.expenses))}
            data-net={short(d.net, { sign: true })}
            data-plex={Math.abs(d.accounts ?? 0) >= 0.5 ? short(d.accounts, { sign: true }) : undefined}
          >
            {d.income > 0 && (
              <div class="bar income" style={`bottom:${zero}%;height:${pct(d.income)}%`}>
                {d.accounts > 0 && <i class="plex-part top" style={`height:${plexShare(d.accounts, d.income)}%`} />}
              </div>
            )}
            {d.expenses > 0 && (
              <div class="bar expenses" style={`top:${100 - zero}%;height:${pct(d.expenses)}%`}>
                {d.accounts < 0 && <i class="plex-part bottom" style={`height:${plexShare(d.accounts, d.expenses)}%`} />}
              </div>
            )}
            {/* Day's net: a neutral dot on the axis; the bar alone doesn't say whether the day closed positive or negative */}
            {hasActivity(d) && <i class="net-mark" aria-hidden="true" style={`bottom:${pct(d.net + bottom)}%`} />}
            {/* Day with no entries: a short tick on the axis; days before the history are hatched */}
            {!hasActivity(d) && <i class="zero-mark" aria-hidden="true" style={`bottom:${zero}%`} />}
          </div>
          )
        ))
      }
    </div>
  </div>
  <div class="x-axis" aria-hidden="true">
    {
      daily.map((d, i) => (
        // data-k: label steps from the last day (0 = the last); the script skips the odd ones if they don't fit
        <span data-k={showLabel(i) ? (daily.length - 1 - i) / labelEvery : undefined}>{showLabel(i) ? date(d.date) : ''}</span>
      ))
    }
  </div>
  <!-- Visual: the screen reader already reads the focused day's label -->
  <div class="tooltip" aria-hidden="true" hidden></div>
  <p class="hint" id={hintId}>{m.chartHint}</p>
</div>

<details class="table-view">
  <summary>{m.asTable}</summary>
  <div class="scroll" role="group" aria-label={m.dailyFlow}>
    <table>
      <caption class="sr-only">{m.dailyFlow}</caption>
      <thead>
        <tr>
          <th>{m.day}</th>
          <th>{m.income} <span class="unit">ISK</span></th>
          <th>{m.expenses} <span class="unit">ISK</span></th>
          <th>{m.net} <span class="unit">ISK</span></th>
        </tr>
      </thead>
      <tbody>
        {
          [...daily].reverse().map((d) => (
            <tr>
              <td>{date(d.date)}</td>
              <td>{plain(d.income)}</td>
              <td>{plain(out(d.expenses))}</td>
              <td>{plain(d.net)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</details>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>('.chart')) {
    const tip = chart.querySelector<HTMLElement>('.tooltip')!;
    const cols = [...chart.querySelectorAll<HTMLElement>('.col:not(.nodata)')];
    const show = (col: HTMLElement) => {
      const { date, income, expenses, net, plex } = col.dataset;
      const l = chart.dataset;
      tip.innerHTML = `<strong>${date}</strong>
        <span><i class="key income"></i>${l.lIncome}</span><b>${income}</b>
        <span><i class="key expenses"></i>${l.lExpenses}</span><b>${expenses}</b>
        <span>${l.lNet}</span><b>${net}</b>${plex ? `<span><i class="key plex"></i>${l.lPlex}</span><b>${plex}</b>` : ''}`;
      tip.hidden = false;
      // Next to the column (right if it fits, otherwise left) so it doesn't cover its bars
      const c = chart.getBoundingClientRect();
      const r = col.getBoundingClientRect();
      const right = r.right - c.left + 8;
      const left = right + tip.offsetWidth <= c.width ? right : Math.max(r.left - c.left - 8 - tip.offsetWidth, 0);
      tip.style.left = `${left}px`;
    };
    const hide = () => (tip.hidden = true);
    // X-axis labels: if the cadence leaves less than ~64 px per label (mobile, 90 days), show one in every n
    const axis = chart.querySelector<HTMLElement>('.x-axis')!;
    const labelled = [...axis.querySelectorAll<HTMLElement>('span[data-k]')];
    const fitLabels = () => {
      if (labelled.length < 2) return;
      const gap = labelled[labelled.length - 1].offsetLeft - labelled[labelled.length - 2].offsetLeft;
      const stride = Math.max(1, Math.ceil(64 / Math.max(gap, 1)));
      for (const label of labelled) label.classList.toggle('skip', Number(label.dataset.k) % stride !== 0);
    };
    fitLabels();
    new ResizeObserver(fitLabels).observe(axis);
    const focusAt = (i: number) => {
      const next = cols[Math.min(Math.max(i, 0), cols.length - 1)];
      if (!next) return;
      for (const col of cols) col.tabIndex = col === next ? 0 : -1;
      next.focus();
    };
    for (const col of cols) {
      col.addEventListener('pointerenter', () => show(col));
      col.addEventListener('focus', () => show(col));
      // A click also moves the Tab stop to that day
      col.addEventListener('pointerdown', () => {
        for (const c of cols) c.tabIndex = c === col ? 0 : -1;
      });
    }
    chart.addEventListener('keydown', (e) => {
      const i = cols.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const step: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, PageUp: -7, PageDown: 7 };
      if (e.key in step) focusAt(i + step[e.key]);
      else if (e.key === 'Home') focusAt(0);
      else if (e.key === 'End') focusAt(cols.length - 1);
      else if (e.key === 'Escape') return hide();
      else return;
      e.preventDefault();
    });
    chart.addEventListener('pointerleave', () => {
      if (!chart.contains(document.activeElement)) hide();
    });
    chart.addEventListener('focusout', (e) => {
      if (!chart.contains(e.relatedTarget as Node)) hide();
    });
  }
</script>

<style>
  .legend {
    display: flex;
    gap: 18px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  :global(.key) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  :global(.key.income) {
    background: var(--income);
  }
  :global(.key.expenses) {
    background: var(--expenses);
  }
  /* Net: dot in the text color, not the income or expenses color */
  :global(.key.net) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text);
  }

  .chart {
    position: relative;
    /* Margin so the last label, centered under its column, isn't clipped at the panel edge */
    padding-right: 8px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 220px auto;
    column-gap: 8px;
  }
  @media (max-width: 600px) {
    /* The last 7-character label sticks out ~23 px to the right of the column: margin so it doesn't touch the edge */
    .chart {
      padding-right: 22px;
    }
  }
  .y-axis {
    position: relative;
    min-width: 52px;
  }
  .y-axis span {
    position: absolute;
    right: 0;
    transform: translateY(50%);
    font: 12px var(--mono);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .plot {
    position: relative;
  }
  .grid {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--grid);
  }
  .grid.base {
    background: var(--axis);
  }
  .cols {
    position: absolute;
    inset: 0;
    display: flex;
  }
  .col {
    position: relative;
    flex: 1;
    border-radius: 4px;
  }
  .col:hover,
  .col:focus-visible {
    background: linear-gradient(180deg, transparent, #61cce524 50%, transparent);
  }
  /* 2 px focus ring inside the column (no offset: the columns are adjacent) */
  .col:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -1px;
  }
  /* Day with no entries: a short tick on the axis */
  .zero-mark {
    position: absolute;
    left: 25%;
    right: 25%;
    height: 2px;
    margin-bottom: -1px;
    border-radius: 1px;
    background: var(--text-muted);
  }
  /* Days without data (before the first sync or after a stuck pilot's last one): diagonal texture,
     no bars or tooltip */
  .nodata-band {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 4px;
    background: repeating-linear-gradient(135deg, #ffffff06 0 6px, transparent 6px 12px);
    border: 1px dashed var(--line-strong);
    pointer-events: none;
  }
  .nodata-band.after {
    inset: 0 0 0 auto;
  }
  .nodata-band span {
    white-space: nowrap;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--panel);
    font-size: 13px;
    color: var(--text-muted);
  }
  .net-mark {
    position: absolute;
    left: 50%;
    width: 7px;
    height: 7px;
    margin-bottom: -3.5px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: var(--text);
    /* Ring in the panel color to separate it from the bar it crosses */
    box-shadow: 0 0 0 2px #0f1822;
    pointer-events: none;
  }
  .bar {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 2px);
    max-width: 24px;
  }
  .bar.income {
    background: var(--income);
    border-radius: 4px 4px 0 0;
  }
  .bar.expenses {
    background: var(--expenses);
    border-radius: 0 0 4px 4px;
  }
  /* The part of the bar that is PLEX: hatched over the bar color (it's still income or expense) */
  .plex-part {
    position: absolute;
    left: 0;
    right: 0;
    background: repeating-linear-gradient(135deg, #0f1822 0 2px, transparent 2px 5px);
  }
  .plex-part.bottom {
    bottom: 0;
    border-radius: 0 0 4px 4px;
  }
  .plex-part.top {
    top: 0;
    border-radius: 4px 4px 0 0;
  }
  :global(.key.plex) {
    background: repeating-linear-gradient(135deg, #0f1822 0 2px, transparent 2px 5px), var(--expenses);
  }
  .x-axis {
    grid-column: 2;
    display: flex;
    padding-top: 6px;
  }
  .x-axis span {
    flex: 1;
    font: 12px var(--mono);
    color: var(--text-muted);
    text-align: center;
    white-space: nowrap;
    overflow: visible;
    width: 0;
    display: flex;
    justify-content: center;
  }
  /* Labels that don't fit the available width: the script skips them without changing the others' cadence */
  .x-axis span.skip {
    visibility: hidden;
  }
  .tooltip {
    position: absolute;
    top: -8px;
    z-index: 1;
    display: grid;
    grid-template-columns: auto auto;
    gap: 4px 16px;
    padding: 10px 12px;
    font-size: 13px;
    background: #0d1a25f2;
    color: var(--text-primary);
    border: 1px solid #345469;
    border-radius: 6px;
    box-shadow:
      0 10px 40px #0009,
      inset 0 1px 0 #64c9e233;
    pointer-events: none;
    white-space: nowrap;
  }
  .tooltip :global(strong) {
    grid-column: 1 / -1;
    font-weight: 600;
    color: var(--text);
  }
  .tooltip :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }
  .tooltip :global(b) {
    text-align: right;
    font: 500 13px var(--mono);
  }
  .tooltip[hidden] {
    display: none;
  }
  /* The keyboard hint is only visible while the chart has focus */
  .hint {
    grid-column: 2;
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--text-muted);
    visibility: hidden;
  }
  .chart:focus-within .hint {
    visibility: visible;
  }
  .table-view {
    margin-top: 4px;
    font-size: 13px;
  }
  .table-view summary {
    cursor: pointer;
    padding: 12px 0;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .table-view summary:hover {
    color: var(--cyan);
  }
  .table-view .scroll {
    margin-top: 8px;
  }
  .unit {
    font-weight: 400;
    color: var(--text-muted);
  }
</style>
