---
// Detalle por actividad (PvE, PvP, trading como margen, otros). El vistazo con el neto de cada una vive en la
// tarjeta de Neto: aquí solo lo que hay detrás, por tipo de movimiento de ESI, sin repetir barras ni netos.
import type { Summary } from '../lib/api';
import { isk, iskFull, refTypeLabel } from '../lib/format';
import { getLang, t } from '../lib/i18n';

interface Props {
  activities: Summary['byActivity'];
}
const { activities } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const out = (v: number) => (v ? -v : 0);

// Orden fijo (PvE, PvP, Trading, Otros, el de la API): que la fila no cambie de sitio con el período
const rows = activities;
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
---

<section class="panel" id="por-actividad">
  <div class="panel-heading">
    <h2>{m.byActivity}</h2>
  </div>
  {
    rows.length === 0 ? (
      <p class="empty panel-body">{m.noData}</p>
    ) : (
      <ul>
        {rows.map((a) => (
          <li>
            <details>
              <summary>
                <span class="who">
                  <span class="name">{m.activityName[a.activity]}</span>
                  <span class="hint">{m.activityHint[a.activity]}</span>
                </span>
                <span class="gross" title={`${m.net} ${full(a.net)}`}>{m.activityInOut(fmt(a.income), fmt(a.expenses))}</span>
              </summary>
              <table aria-label={m.activityDetail(m.activityName[a.activity])}>
                <thead>
                  <tr>
                    <th>{m.entryType}</th>
                    <th>{m.income}</th>
                    <th>{m.expenses}</th>
                    <th>{m.net}</th>
                  </tr>
                </thead>
                <tbody>
                  {a.refTypes.map((r) => (
                    <tr>
                      <td title={m.entries(r.count)}>{refTypeLabel(r.refType, lang)}</td>
                      <td title={full(r.income)}>{r.income ? fmt(r.income) : '—'}</td>
                      <td title={full(out(r.expenses))}>{r.expenses ? fmt(out(r.expenses)) : '—'}</td>
                      <td class:list={[sign(r.net)]} title={`${m.income} ${full(r.income)} · ${m.expenses} ${full(out(r.expenses))}`}>{fmt(r.net, { sign: true })}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          </li>
        ))}
      </ul>
    )
  }
  <p class="panel-note">{m.activityNote}.</p>
</section>

<style>
  section {
    scroll-margin-top: 16px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 12px 22px 12px 40px;
    cursor: pointer;
    list-style: none;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Chevrón propio: gira al desplegar */
  summary::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: translateY(-70%) rotate(-45deg);
    transition: transform 0.18s;
  }
  details[open] > summary::before {
    transform: translateY(-70%) rotate(45deg);
  }
  summary:hover {
    background: var(--hover);
  }
  summary:hover::before {
    border-color: var(--cyan);
  }
  summary:focus-visible {
    outline-offset: -2px;
  }
  .who {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .name {
    font-weight: 600;
    color: var(--text);
  }
  .hint {
    font-size: 13px;
    color: var(--text-muted);
  }
  td.pos {
    color: var(--positive);
  }
  td.neg {
    color: var(--critical);
  }
  .gross {
    font: 13px var(--mono);
    color: var(--text-muted);
    white-space: nowrap;
  }
  table {
    margin: 0 22px 14px 40px;
    width: calc(100% - 62px);
    font-size: 13px;
  }
  th:not(:first-child),
  td:not(:first-child) {
    text-align: right;
    font-family: var(--mono);
  }
  th:not(:first-child) {
    font-family: inherit;
  }
  .empty {
    color: var(--text-muted);
    font-size: 13px;
  }
  @media (max-width: 600px) {
    summary {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 12px 16px 12px 34px;
    }
    summary::before {
      left: 16px;
    }
    .gross {
      white-space: normal;
    }
    table {
      margin: 0 16px 14px;
      width: calc(100% - 32px);
    }
    /* En móvil el desglose queda en tipo y neto; entradas y salidas siguen en el tooltip del neto */
    th:nth-child(2),
    th:nth-child(3),
    td:nth-child(2),
    td:nth-child(3) {
      display: none;
    }
  }
</style>
