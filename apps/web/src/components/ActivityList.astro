---
// Detalle por actividad (PvE, PvP, trading como margen, otros). El vistazo con el neto de cada una vive en la
// tarjeta de Neto: aquí solo lo que hay detrás, por tipo de movimiento de ESI, sin repetir barras ni netos.
import type { Summary } from '../lib/api';
import Donut from './Donut.astro';
import { isk, iskFull, refTypeLabel } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { shareOf } from '../lib/shares';

interface Props {
  activities: Summary['byActivity'];
}
const { activities } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const out = (v: number) => (v ? -v : 0);

// Orden fijo (PvE, PvP, Trading, Logística, Otros, PLEX: el de la API): que la fila no cambie de sitio con el
// período, y que cada actividad lleve siempre el mismo color (la porción i de las tortas y la muestra de su fila)
const rows = activities;
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
const color = (i: number) => `var(--cat-${(i % 7) + 1})`;
// Tortas: de dónde vienen los ingresos y a dónde van los gastos (brutos), por actividad
const totalIncome = rows.reduce((n, a) => n + a.income, 0);
const totalExpenses = rows.reduce((n, a) => n + a.expenses, 0);
const incomeSlices = rows.map((a) => ({ label: m.activityName[a.activity], value: a.income }));
const expensesSlices = rows.map((a) => ({ label: m.activityName[a.activity], value: a.expenses }));
---

<section class="panel" id="por-actividad">
  <div class="panel-heading">
    <h2>{m.byActivity}</h2>
  </div>
  {
    rows.length === 0 ? (
      <p class="empty panel-body">{m.noData}</p>
    ) : (
      <>
        {(totalIncome > 0 || totalExpenses > 0) && (
          <div class="panel-body shares">
            {totalIncome > 0 && (
              <figure class="caption-only">
                <Donut slices={incomeSlices} label={m.shareIncomeActivity} format={fmt} lang={lang} center={fmt(totalIncome)} centerSub="ISK" />
                <figcaption>{m.shareIncomeActivity}</figcaption>
              </figure>
            )}
            {totalExpenses > 0 && (
              <figure class="caption-only">
                <Donut slices={expensesSlices} label={m.shareExpensesActivity} format={fmt} lang={lang} center={fmt(totalExpenses)} centerSub="ISK" />
                <figcaption>{m.shareExpensesActivity}</figcaption>
              </figure>
            )}
          </div>
        )}
        {/* Cabecera de las columnas de la lista (las filas son <details>, no una tabla) */}
        <div class="cols" aria-hidden="true">
          <span />
          <span>{m.income}</span>
          <span>{m.expenses}</span>
        </div>
        <ul>
          {rows.map((a, i) => (
            <li>
              <details>
                <summary>
                  <span class="name">
                    <i class="swatch" style={`background: ${color(i)}`} aria-hidden="true" />
                    {m.activityName[a.activity]}
                  </span>
                  <span class="hint">{m.activityHint[a.activity]}</span>
                  <span class="cell inc" title={`${m.income} ${full(a.income)}`}>
                    <span class="sr-only">{m.income} </span>
                    <span class="amount">{a.income ? fmt(a.income) : '—'}</span>
                    {a.income > 0 && (
                      <span class="share">
                        <span class="sr-only">{m.shareOfIncome(shareOf(a.income, totalIncome, lang))}</span>
                        <span aria-hidden="true">{shareOf(a.income, totalIncome, lang)}</span>
                      </span>
                    )}
                  </span>
                  <span class="cell exp" title={`${m.expenses} ${full(out(a.expenses))}`}>
                    <span class="sr-only">{m.expenses} </span>
                    <span class="amount">{a.expenses ? fmt(out(a.expenses)) : '—'}</span>
                    {a.expenses > 0 && (
                      <span class="share">
                        <span class="sr-only">{m.shareOfExpenses(shareOf(a.expenses, totalExpenses, lang))}</span>
                        <span aria-hidden="true">{shareOf(a.expenses, totalExpenses, lang)}</span>
                      </span>
                    )}
                  </span>
                </summary>
                <table aria-label={m.activityDetail(m.activityName[a.activity])}>
                  <thead>
                    <tr>
                      <th>{m.entryType}</th>
                      <th>{m.income}</th>
                      <th>{m.expenses}</th>
                      <th>{m.net}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {a.refTypes.map((r) => (
                      <tr>
                        <td title={m.entries(r.count)}>{refTypeLabel(r.refType, lang)}</td>
                        <td title={full(r.income)}>{r.income ? fmt(r.income) : '—'}</td>
                        <td title={full(out(r.expenses))}>{r.expenses ? fmt(out(r.expenses)) : '—'}</td>
                        <td class:list={[sign(r.net)]} title={`${m.income} ${full(r.income)} · ${m.expenses} ${full(out(r.expenses))}`}>{fmt(r.net, { sign: true })}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </details>
            </li>
          ))}
        </ul>
      </>
    )
  }
  <p class="panel-note">{m.activityNote}.</p>
</section>

<style>
  section {
    scroll-margin-top: 16px;
  }
  .shares {
    border-bottom: 1px solid var(--line);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 0 6px;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  /* Cabecera y filas comparten la misma rejilla: nombre (con su pista debajo), Ingresos, Gastos */
  .cols,
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem 7.5rem;
    align-items: center;
    gap: 2px 20px;
  }
  summary {
    grid-template-areas:
      'name inc exp'
      'hint inc exp';
  }
  .name {
    grid-area: name;
  }
  .hint {
    grid-area: hint;
  }
  .cell.inc {
    grid-area: inc;
  }
  .cell.exp {
    grid-area: exp;
  }
  .cols {
    padding: 10px 22px 8px 40px;
    border-bottom: 1px solid var(--line-strong);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .cols span:not(:first-child) {
    text-align: right;
  }
  summary {
    padding: 12px 22px 12px 40px;
    cursor: pointer;
    list-style: none;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Chevrón propio: gira al desplegar */
  summary::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: translateY(-70%) rotate(-45deg);
    transition: transform 0.18s;
  }
  details[open] > summary::before {
    transform: translateY(-70%) rotate(45deg);
  }
  summary:hover {
    background: var(--hover);
  }
  summary:hover::before {
    border-color: var(--cyan);
  }
  summary:focus-visible {
    outline-offset: -2px;
  }
  .name {
    display: flex;
    align-items: center;
    min-width: 0;
    font-weight: 600;
    color: var(--text);
  }
  .hint {
    font-size: 13px;
    color: var(--text-muted);
  }
  td.pos {
    color: var(--positive);
  }
  td.neg {
    color: var(--critical);
  }
  .cell {
    display: grid;
    justify-items: end;
    gap: 2px;
    font: 14px var(--mono);
    color: var(--text);
    white-space: nowrap;
  }
  .share {
    font-size: 12px;
    color: var(--text-muted);
  }
  table {
    margin: 0 22px 14px 40px;
    width: calc(100% - 62px);
    font-size: 13px;
  }
  th:not(:first-child),
  td:not(:first-child) {
    text-align: right;
    font-family: var(--mono);
  }
  th:not(:first-child) {
    font-family: inherit;
  }
  .empty {
    color: var(--text-muted);
    font-size: 13px;
  }
  @media (max-width: 600px) {
    /* En móvil la pista pasa a su propia línea, a todo el ancho */
    .cols,
    summary {
      grid-template-columns: minmax(0, 1fr) 5.5rem 5.5rem;
      gap: 4px 12px;
    }
    summary {
      grid-template-areas:
        'name inc exp'
        'hint hint hint';
    }
    .cols {
      padding: 10px 16px 8px 34px;
    }
    summary {
      padding: 12px 16px 12px 34px;
    }
    summary::before {
      left: 16px;
    }
    .cell {
      font-size: 13px;
    }
    table {
      margin: 0 16px 14px;
      width: calc(100% - 32px);
    }
    /* En móvil el desglose queda en tipo y neto; entradas y salidas siguen en el tooltip del neto */
    th:nth-child(2),
    th:nth-child(3),
    td:nth-child(2),
    td:nth-child(3) {
      display: none;
    }
  }
</style>
