---
// «Tu New Eden»: where your inventory is (size = value) and where you earned ISK today.
// Real ESI positions projected onto the galactic plane (x, z), north up
import type { GeoMap } from '../lib/api';
import { isk, iskFull } from '../lib/format';
import { getLang, t } from '../lib/i18n';

interface Props {
  map: GeoMap;
  // «gains»: only the systems where ISK was earned today, sized by today's ISK (the Net card's «Hoy» column, wallets only)
  mode?: 'all' | 'gains';
  width?: number;
  height?: number;
}
const { map, mode = 'all', width = 440, height = 160 } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);


// The viewBox is almost the same size as the card on desktop (~430 px): 12 px labels come out at ~11.5 px
const W = width;
const H = height;
const PAD = mode === 'gains' ? 24 : 40; // margin so the labels aren't cut off

const nodes = mode === 'gains' ? map.nodes.filter((n) => n.earnedToday > 0) : map.nodes;
const xs = nodes.map((n) => n.x);
const zs = nodes.map((n) => n.z);
const [minX, maxX] = [Math.min(...xs), Math.max(...xs)];
const [minZ, maxZ] = [Math.min(...zs), Math.max(...zs)];
// Same scale on both axes so the galaxy isn't distorted
const span = Math.max(maxX - minX, (maxZ - minZ) * ((W - 2 * PAD) / (H - 2 * PAD)), 1);
const scale = (W - 2 * PAD) / span;
const cx = (minX + maxX) / 2;
const cz = (minZ + maxZ) / 2;
const px = (x: number) => W / 2 + (x - cx) * scale;
const py = (z: number) => H / 2 - (z - cz) * scale;

const maxInv = Math.max(1, ...nodes.map((n) => n.inventory));
const maxEarn = Math.max(1, ...nodes.map((n) => n.earnedToday));
const radius = (n: GeoMap['nodes'][number]) =>
  mode === 'gains' ? 3 + 9 * Math.sqrt(n.earnedToday / maxEarn) : n.inventory > 0 ? 3 + 11 * Math.sqrt(n.inventory / maxInv) : 2.5;

// Labels only for what matters: the 4 systems with the most inventory and the ones that gave ISK today
const labelled =
  mode === 'gains'
    ? new Set(nodes.map((n) => n.systemId))
    : new Set([
        ...nodes.filter((n) => n.inventory > 0).slice(0, 4).map((n) => n.systemId),
        ...nodes.filter((n) => n.earnedToday > 0).map((n) => n.systemId),
      ]);

type Box = { x1: number; y1: number; x2: number; y2: number };
const hit = (a: Box, b: Box) => a.x1 < b.x2 && b.x1 < a.x2 && a.y1 < b.y2 && b.y1 < a.y2;
const taken: Box[] = [];

const placed = nodes.map((n) => {
  const x = px(n.x);
  const y = py(n.z);
  const r = radius(n);
  const lines = [mode === 'all' && n.inventory > 0 ? fmt(n.inventory) : null, n.earnedToday > 0 ? m.mapToday(fmt(n.earnedToday)) : null].filter(
    Boolean,
  ) as string[];
  const title = [
    `${n.name} (${n.security.toFixed(1)})`,
    mode === 'all' && n.inventory > 0 ? m.mapInventoryLine(full(n.inventory)) : null,
    n.earnedToday > 0 ? m.mapTodayLine(full(n.earnedToday)) : null,
  ]
    .filter(Boolean)
    .join('\n');
  return { ...n, x, y, r, lines, title };
});

// Nodes take their place before any label
for (const n of placed) taken.push({ x1: n.x - n.r - 6, y1: n.y - n.r - 6, x2: n.x + n.r + 6, y2: n.y + n.r + 6 });

type Label = { anchor: 'start' | 'end' | 'middle'; tx: number; ty: number };
const labels = new Map<number, Label>();
const inside = (b: Box) => b.x1 >= 2 && b.x2 <= W - 2 && b.y1 >= 2 && b.y2 <= H - 2;
// Priority: first what was earned today (the day's story), then inventory by value
const order = [...placed].sort((a, b) => b.earnedToday - a.earnedToday || b.inventory - a.inventory);
for (const n of order) {
  if (!labelled.has(n.systemId)) continue;
  const w = Math.max(n.name.length * 7, ...n.lines.map((l) => l.length * 7.2)) + 4;
  const h = 15 + n.lines.length * 13;
  const gap = n.r + 8;
  const options: (Label & { box: Box })[] = [];
  // To the sides (centred, higher or lower) and above/below
  for (const dy of [0, -h / 2 - 4, h / 2 + 4, -h - 6, h + 6]) {
    const top = n.y - 13 + dy;
    options.push({ anchor: 'start', tx: n.x + gap, ty: top + 11, box: { x1: n.x + gap, y1: top, x2: n.x + gap + w, y2: top + h } });
    options.push({ anchor: 'end', tx: n.x - gap, ty: top + 11, box: { x1: n.x - gap - w, y1: top, x2: n.x - gap, y2: top + h } });
  }
  options.push({ anchor: 'middle', tx: n.x, ty: n.y + gap + 10, box: { x1: n.x - w / 2, y1: n.y + gap, x2: n.x + w / 2, y2: n.y + gap + h } });
  options.push({ anchor: 'middle', tx: n.x, ty: n.y - gap - h + 10, box: { x1: n.x - w / 2, y1: n.y - gap - h, x2: n.x + w / 2, y2: n.y - gap } });
  const self = (t: Box) => t.x1 === n.x - n.r - 6 && t.y1 === n.y - n.r - 6;
  // Without free space it isn't drawn: better no label (it stays in the tooltip) than an overlapping one
  const pick = options.find((o) => inside(o.box) && !taken.some((t) => !self(t) && hit(t, o.box)));
  if (!pick) continue;
  taken.push(pick.box);
  labels.set(n.systemId, pick);
}

const invCount = nodes.filter((n) => n.inventory > 0).length;
const earnCount = nodes.filter((n) => n.earnedToday > 0).length;
const summary = mode === 'gains' ? m.mapSummaryToday(earnCount) : m.mapSummary(invCount, earnCount);
---

<figure class:list={['new-eden', mode]}>
  {
    nodes.length === 0 ? (
      <p class="empty">{m.mapEmpty}</p>
    ) : (
      <>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary}>
          <defs>
            <pattern id="ne-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path class="grid-line" d="M 40 0 L 0 0 0 40" />
            </pattern>
          </defs>
          <rect class="grid" width={W} height={H} fill="url(#ne-grid)" />
          {placed.map((n) => (
            <g class="node">
              <title>{n.title}</title>
              {n.earnedToday > 0 && (
                <>
                  <circle class="ping" cx={n.x} cy={n.y} r={n.r + 5} />
                  <circle class="earned" cx={n.x} cy={n.y} r={n.r + 5} />
                </>
              )}
              <circle class:list={['dot', { held: mode === 'all' && n.inventory > 0 }]} cx={n.x} cy={n.y} r={n.r} />
              {labels.has(n.systemId) && (
                <text x={labels.get(n.systemId)!.tx} y={labels.get(n.systemId)!.ty} text-anchor={labels.get(n.systemId)!.anchor}>
                  <tspan class="name">{n.name}</tspan>
                  {n.lines.map((l, i) => (
                    <tspan class:list={['val', { gain: i === n.lines.length - 1 && n.earnedToday > 0 }]} x={labels.get(n.systemId)!.tx} dy={i === 0 ? 14 : 13}>
                      {l}
                    </tspan>
                  ))}
                </text>
              )}
            </g>
          ))}
        </svg>
        <ul class="node-list">
          {nodes.map((n) => (
            <li>
              <span class="n-name">{n.name}</span>
              <span class="n-val">
                {mode === 'gains' ? (
                  <span class="gain">{m.mapToday(fmt(n.earnedToday))}</span>
                ) : (
                  <>
                    {n.inventory > 0 ? `${fmt(n.inventory)} ISK` : m.mapNoInventory}
                    {n.earnedToday > 0 && <span class="gain">, {m.mapToday(fmt(n.earnedToday))}</span>}
                  </>
                )}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
  <figcaption>
    {mode === 'all' && <span class="legend-key"><i class="held" />{m.mapLegendInventory}</span>}
    {earnCount > 0 && <span class="legend-key"><i class="earned" />{mode === 'gains' ? m.mapLegendTodaySize : m.mapLegendToday}</span>}
    {
      mode === 'all' && map.unplaced.value > 0 && (
        <span class="unplaced" title={m.mapUnplacedTitle}>
          {m.mapUnplaced(fmt(map.unplaced.value), map.unplaced.locations)}
        </span>
      )
    }
  </figcaption>
</figure>

<style>
  .new-eden {
    margin: 14px 0 0;
  }
  /* Today's mini-map in the Net card: smaller and without the inventory legend */
  .new-eden.gains {
    margin-top: 0;
  }
  .new-eden.gains svg {
    max-height: 150px;
  }
  .new-eden.gains figcaption {
    margin-top: 6px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    /* On tablet the full width gave a map almost 300 px high for 3 dots */
    max-height: 230px;
    border-radius: 6px;
    background: radial-gradient(ellipse at 50% 50%, #0f2230, #0a121a 75%);
    border: 1px solid var(--line);
  }
  .grid-line {
    fill: none;
    stroke: #ffffff08;
    stroke-width: 1;
  }
  .dot {
    fill: #5a6f7e;
  }
  .dot.held {
    fill: var(--inventory);
    stroke: #0a121a;
    stroke-width: 2;
  }
  .earned {
    fill: none;
    stroke: var(--income);
    stroke-width: 2;
  }
  /* The dashboard's only motion: it signals today's activity in that system */
  .ping {
    fill: none;
    stroke: var(--income);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: ping 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  text {
    font: 12px var(--font);
    fill: var(--text-secondary);
  }
  .name {
    font-weight: 600;
    fill: var(--text);
  }
  .val {
    font: 12px var(--mono);
    fill: var(--text-secondary);
  }
  .val.gain {
    fill: #7cc4dc;
  }
  .node:hover .dot {
    stroke: var(--text);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .legend-key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend-key i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .legend-key i.held {
    background: var(--inventory);
  }
  .legend-key i.earned {
    border: 2px solid var(--income);
  }
  .unplaced {
    margin-left: auto;
    color: var(--text-muted);
  }
  .empty {
    padding: 28px 16px;
    border: 1px dashed var(--line-strong);
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-muted);
    text-align: center;
  }
  /* Always accessible; visible only on narrow screens, where the SVG text would be illegible */
  .node-list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    svg text {
      display: none;
    }
    .node-list {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: grid;
      gap: 4px;
      margin: 10px 0 0;
      padding: 0;
      list-style: none;
      font-size: 13px;
    }
    .node-list li {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 4px 0;
      border-bottom: 1px solid var(--line);
    }
    .n-name {
      color: var(--text);
    }
    .n-val {
      font: 12px var(--mono);
      color: var(--text-secondary);
      text-align: right;
    }
    .n-val .gain {
      color: #7cc4dc;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ping {
      display: none;
    }
  }
</style>
