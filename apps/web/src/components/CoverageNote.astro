---
// Cobertura de una cifra que suma a todos los pilotos (Patrimonio, saldo de Omega): cuánto de ella
// viene de datos viejos, a quién deja fuera y qué inventario falta. Solo cuantifica: la causa y la
// acción de cada piloto viven en un único sitio, la línea de salud bajo el filtro. No pinta nada si
// todos los pilotos están al día.
import Icon from './Icon.astro';
import type { Pilot } from '../lib/api';
import { ago, isk } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { pilotState } from '../lib/pilot-state';

interface Props {
  pilots: Pilot[];
  staleAfterMs: number;
  syncRunning?: boolean;
  // Lo que aporta cada piloto a la cifra (saldo + inventario en Patrimonio, solo saldo en Omega)
  amounts: Record<number, number>;
  // Solo saldo (Omega): el inventario que falta no le afecta
  walletOnly?: boolean;
}
const { pilots, staleAfterMs, syncRunning, amounts, walletOnly } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const ASSETS_SCOPE = 'esi-assets.read_assets.v1';

let oldValue = 0;
let oldest: string | null = null;
const excluded: string[] = [];
const noInventory: string[] = [];
for (const p of pilots) {
  const st = pilotState(p, m, staleAfterMs, syncRunning);
  if (!p.lastSyncAt) excluded.push(p.name);
  else if (st.kind !== 'ok') {
    oldValue += amounts[p.id] ?? 0;
    if (!oldest || p.lastSyncAt < oldest) oldest = p.lastSyncAt;
  } else if (!walletOnly && p.missingScopes.includes(ASSETS_SCOPE)) noInventory.push(p.name);
}
const parts = [
  // «hace 3 d» no se parte en dos líneas
  oldValue !== 0 && oldest ? m.coverOld(isk(oldValue, { lang }), ago(oldest, lang).replace(/ /g, '\u00a0')) : null,
  excluded.length ? m.coverExcludes(excluded.join(', ')) : null,
  noInventory.length ? m.coverNoInventory(noInventory.join(', ')) : null,
].filter(Boolean);
---

{
  parts.length > 0 && (
    <p class="coverage-note">
      <Icon name="alert" class="cover-icon" />
      <span>{parts.join(' · ')}</span>
    </p>
  )
}

<style>
  /* Texto neutro con un icono ámbar pequeño: informa de cuánto, sin competir con la línea de salud */
  .coverage-note {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .coverage-note :global(.cover-icon) {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    align-self: center;
    color: var(--warning);
  }
</style>
