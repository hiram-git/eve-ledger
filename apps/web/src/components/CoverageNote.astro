---
// Coverage of a figure that adds up all pilots (Patrimonio, Omega balance): how much of it
// comes from stale data, who it leaves out and which inventory is missing. It only quantifies: each
// pilot's cause and action live in a single place, the health line under the filter. Renders nothing if
// all pilots are up to date.
import Icon from './Icon.astro';
import type { Pilot } from '../lib/api';
import { ago, isk } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { pilotState } from '../lib/pilot-state';

interface Props {
  pilots: Pilot[];
  staleAfterMs: number;
  syncRunning?: boolean;
  // What each pilot contributes to the figure (balance + inventory in Patrimonio, balance only in Omega)
  amounts: Record<number, number>;
  // Balance only (Omega): missing inventory doesn't affect it
  walletOnly?: boolean;
}
const { pilots, staleAfterMs, syncRunning, amounts, walletOnly } = Astro.props;
const lang = getLang(Astro);
const m = t(lang);
const ASSETS_SCOPE = 'esi-assets.read_assets.v1';

let oldValue = 0;
let oldest: string | null = null;
const excluded: string[] = [];
const noInventory: string[] = [];
for (const p of pilots) {
  const st = pilotState(p, m, staleAfterMs, syncRunning);
  if (!p.lastSyncAt) excluded.push(p.name);
  else if (st.kind !== 'ok') {
    oldValue += amounts[p.id] ?? 0;
    if (!oldest || p.lastSyncAt < oldest) oldest = p.lastSyncAt;
  } else if (!walletOnly && p.missingScopes.includes(ASSETS_SCOPE)) noInventory.push(p.name);
}
const parts = [
  // «hace 3 d» doesn't break across two lines
  oldValue !== 0 && oldest ? m.coverOld(isk(oldValue, { lang }), ago(oldest, lang).replace(/ /g, '\u00a0')) : null,
  excluded.length ? m.coverExcludes(excluded.join(', ')) : null,
  noInventory.length ? m.coverNoInventory(noInventory.join(', ')) : null,
].filter(Boolean);
---

{
  parts.length > 0 && (
    <p class="coverage-note">
      <Icon name="alert" class="cover-icon" />
      <span>{parts.join(' · ')}</span>
    </p>
  )
}

<style>
  /* Neutral text with a small amber icon: reports how much, without competing with the health line */
  .coverage-note {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .coverage-note :global(.cover-icon) {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    align-self: center;
    color: var(--warning);
  }
</style>
