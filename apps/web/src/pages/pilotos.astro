---
// Pilots: link characters (return from the EVE login), their sync status, permissions and figures
import { PILOT_SLOTS } from 'astro:env/server';
import ActionNotice from '../components/ActionNotice.astro';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import {
  getBackups,
  getInventory,
  getPilots,
  getSummary,
  getSyncStatus,
  loginUrl,
  syncLogUrl,
  type BackupKind,
  type BackupsView,
  type Inventory,
  type Pilot,
  type Summary,
  type SyncStatus,
} from '../lib/api';
import { ago, bytes, isk, iskFull, longDate, shortDateTime } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { hasIssue, pilotState } from '../lib/pilot-state';

const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const rel = (iso: string | null) => ago(iso, lang);

const DAYS = 30;
const q = Astro.url.searchParams;

let pilots: Pilot[] = [];
let summary: Summary | undefined;
let inventory: Inventory | undefined;
let status: SyncStatus | undefined;
let backups: BackupsView | undefined;
let apiError: string | undefined;
try {
  const optional = <T,>(p: Promise<T>) => p.catch((err) => (console.error(err), undefined));
  [pilots, status, summary, inventory, backups] = await Promise.all([
    getPilots(),
    getSyncStatus(),
    optional(getSummary(DAYS)),
    optional(getInventory()),
    optional(getBackups()),
  ]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

// Return from the EVE login
const linkedId = Number(q.get('linked') ?? 0);
const linked = pilots.find((p) => p.id === linkedId);
const loginError = q.get('error');
const loginErrorDetail = q.get('detail');
const LOGIN_ERRORS: Record<string, string> = { denied: m.loginDenied, state: m.loginState, sso: m.loginSso };

const synced = q.get('synced');
const syncErrors = q.get('syncErrors');
const syncFailed = q.get('syncFailed');

// Figures per pilot: balance and net from the summary, inventory from the inventory
const flows = new Map(summary?.characters.map((c) => [c.id, c]));
const invByPilot = new Map(inventory?.byCharacter.map((c) => [c.characterId, c.value]));

const SCOPE_LABELS: Record<string, string> = {
  'esi-wallet.read_character_wallet.v1': m.scopeWallet,
  'esi-assets.read_assets.v1': m.scopeInventory,
  'esi-killmails.read_killmails.v1': m.scopeLosses,
  'esi-contracts.read_character_contracts.v1': m.scopeContracts,
  'esi-skills.read_skills.v1': m.scopeSkills,
};
const REQUIRED = Object.keys(SCOPE_LABELS);
// Optional permissions (the API returns them separately, in missingOptionalScopes): citadel names and systems,
// loyalty points. Not a problem, just an improvement one click away
const OPTIONAL: { scope: string; icon: 'pin' | 'medal'; label: string; hint: string }[] = [
  { scope: 'esi-universe.read_structures.v1', icon: 'pin', label: m.scopeStructures, hint: m.scopeStructuresHint },
  { scope: 'esi-characters.read_loyalty.v1', icon: 'medal', label: m.scopeLoyalty, hint: m.scopeLoyaltyHint },
];

const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const stateOf = (p: Pilot) => pilotState(p, m, staleAfterMs, status?.running);

const rows = pilots.map((p) => ({ ...p, state: stateOf(p) }));
const pending = rows.some((r) => r.state.kind === 'pending');
const freeSlots = Math.max(0, PILOT_SLOTS - pilots.length);
const portrait = (id: number, size = 128) => `https://images.evetech.net/characters/${id}/portrait?size=${size}`;

// Backups: the latest, how many and how much space they take; the result of an action comes back with at=copias
const backupList = backups?.backups ?? [];
const latestBackup = backupList[0];
const backupBytes = backupList.reduce((n, b) => n + b.size, 0);
const KIND_LABEL: Record<BackupKind, string> = {
  auto: m.backupKindAuto,
  manual: m.backupKindManual,
  restore: m.backupKindRestore,
  update: m.backupKindUpdate,
};
const count = (n: number) => new Intl.NumberFormat(lang).format(n);
const atBackups = q.get('at') === 'copias';
const backupOk = !atBackups
  ? null
  : q.get('ok') === 'backup'
    ? m.backupDone(q.get('name') ?? '')
    : q.get('ok') === 'restored'
      ? m.backupRestored(count(Number(q.get('pilots') ?? 0)), count(Number(q.get('entries') ?? 0)))
      : null;
const backupError = atBackups && q.get('error') ? m.backupError(q.get('error')!) : null;
---

<Base
  title={m.pilots}
  section="pilotos"
  status={status}
  pilots={pilots.length}
  pilotIssues={rows.filter((r) => hasIssue(r, r.state)).length}
>
  <div class="page-head" data-pending={pending ? '1' : undefined}>
    <div>
      <h1>{m.pilots}</h1>
      <p class="subtitle">
        {/* More pilots than slots (PILOT_SLOTS): not «6 de 5», just how many there are */}
        {pilots.length > PILOT_SLOTS ? m.pilotsLinkedOnly(pilots.length) : m.pilotsLinked(pilots.length, PILOT_SLOTS)}
        {freeSlots > 0 && <span>{m.pilotsHurry}</span>}
      </p>
    </div>
    <a class="secondary-button" href={loginUrl}>
      <Icon name="plus" />
      {m.linkPilot}
    </a>
  </div>

  {
    linked && (
      <div class="notice success" role="status">
        <img class="notice-portrait" src={portrait(linked.id, 64)} alt="" width="40" height="40" onerror="this.style.visibility='hidden'" />
        <div>
          <strong>{m.linkedTitle(linked.name)}</strong>
          <p>
            {/* Only a sync after the link counts: when relinking, the previous one used the old token */}
            {linked.lastSyncAt && linked.lastSyncAt >= linked.linkedAt ? m.linkedDone(rel(linked.lastSyncAt)) : m.linkedPending}
          </p>
        </div>
      </div>
    )
  }
  {
    loginError && (
      <div class="notice error" role="alert">
        <Icon name="alert" />
        <div>
          <strong>{m.linkFailed}</strong>
          <p>
            {LOGIN_ERRORS[loginError] ?? m.loginGeneric}
            {loginErrorDetail && <span class="detail"> {m.detail} {loginErrorDetail}</span>}
          </p>
          <p>
            <a href={loginUrl}>{m.retry}</a>
          </p>
        </div>
      </div>
    )
  }
  {
    synced !== null && (
      <div class="notice" role="status">
        <Icon name="info" />
        <p>
          {m.syncDone(synced)}
          {syncErrors && (
            <strong>
              {' '}
              · {m.syncErrors(Number(syncErrors))} <a href={syncLogUrl}>{m.syncLog}</a>
            </strong>
          )}
        </p>
      </div>
    )
  }
  {
    syncFailed && (
      <div class="notice error" role="alert">
        <Icon name="alert" />
        <p>{m.syncFailed} {syncFailed}</p>
      </div>
    )
  }
  {
    apiError && (
      <div class="notice error" role="alert">
        <Icon name="alert" />
        <div>
          <strong>{m.apiDown}</strong>
          <p class="muted">{apiError}</p>
          <p>
            {m.apiRunning} <code>apps/api</code>: <code>bun run dev</code>
          </p>
        </div>
      </div>
    )
  }

  {
    !apiError && (
      <ol class="roster">
        {rows.map((p) => (
          <li class:list={['pilot', 'panel', { fresh: p.id === linkedId }]} id={`piloto-${p.id}`}>
            <div class="who">
              <img src={portrait(p.id)} alt="" width="56" height="56" loading="lazy" onerror="this.style.visibility='hidden'" />
              <div>
                <h2><a href={`/?pilot=${p.id}`} title={m.viewLedger(p.name)}>{p.name}</a></h2>
                <p class="since">
                  {m.linkedOn} <time datetime={p.createdAt}>{longDate(p.createdAt, lang)}</time>
                </p>
              </div>
            </div>

            <div class="state">
              <span class:list={['chip', p.state.kind]} title={p.state.title}>
                <Icon name={p.state.kind === 'ok' ? 'activity' : p.state.kind === 'pending' ? 'clock' : 'alert'} />
                {p.state.text}
              </span>
              <span class="when">
                {p.lastSyncAt ? (
                  <>
                    {m.lastSyncAgo} <time datetime={p.lastSyncAt} data-ago={p.lastSyncAt}>{rel(p.lastSyncAt)}</time>
                  </>
                ) : (
                  m.noDataYet
                )}
              </span>
              {p.state.hint && (
                <span class:list={['error-msg', { soft: p.state.kind !== 'error' }]} title={p.state.title ? `${m.originalError} ${p.state.title}` : undefined}>
                  {p.state.hint}
                  {(p.state.kind === 'error' || p.missingScopes.length > 0) && <> {m.relinkPick(p.name)}</>}
                </span>
              )}
            </div>

            {/* Only the missing permissions: listing the granted ones was noise on every healthy pilot */}
            <ul class="scopes" aria-label={m.permissions}>
              {p.missingScopes.length === 0 ? (
                <li>
                  <Icon name="wallet" />
                  {m.allPermissions}
                </li>
              ) : (
                REQUIRED.filter((s) => p.missingScopes.includes(s)).map((s) => (
                  <li class="missing">
                    <Icon name="alert" />
                    {SCOPE_LABELS[s]}
                    <span class="scope-missing">· {m.scopeMissingShort}</span>
                  </li>
                ))
              )}
              {/* Optional: no amber; the whole chip leads to the EVE login to grant it */}
              {OPTIONAL.filter((o) => (p.missingOptionalScopes ?? []).includes(o.scope)).map((o) => (
                <li class="optional">
                  <a href={loginUrl} title={`${o.hint} ${m.relinkAs(p.name)}`}>
                    <Icon name={o.icon} />
                    {o.label}
                    <span class="scope-missing">· {m.scopeOptional}</span>
                  </a>
                </li>
              ))}
            </ul>

            <dl class="figures">
              <div>
                <dt>{m.balance}</dt>
                <dd title={flows.get(p.id)?.balance != null ? full(flows.get(p.id)!.balance!) : m.noEntries}>
                  {flows.get(p.id)?.balance != null ? fmt(flows.get(p.id)!.balance!) : '—'}
                </dd>
              </div>
              <div>
                <dt>{m.inventory}</dt>
                {/* Without the inventory permission, what is stored is an older snapshot: it is dimmed and says so */}
                <dd
                  class:list={{ stale: invByPilot.has(p.id) && p.missingScopes.includes('esi-assets.read_assets.v1') }}
                  title={
                    !invByPilot.has(p.id)
                      ? m.noInventory
                      : p.missingScopes.includes('esi-assets.read_assets.v1')
                        ? `${full(invByPilot.get(p.id)!)} · ${m.inventoryOldPhoto}`
                        : full(invByPilot.get(p.id)!)
                  }
                >
                  {invByPilot.has(p.id) ? fmt(invByPilot.get(p.id)!) : '—'}
                </dd>
              </div>
              {/* Net = what was earned in game (the same as in the Summary); what was moved with your other pilots goes below, without color */}
              <div>
                <dt>{m.net30(DAYS)}</dt>
                <dd
                  class:list={{ pos: (flows.get(p.id)?.net ?? 0) > 0, neg: (flows.get(p.id)?.net ?? 0) < 0 }}
                  title={
                    flows.has(p.id)
                      ? m.pilotNetBreakdown(
                          full(flows.get(p.id)!.net),
                          full(flows.get(p.id)!.internalReceived - flows.get(p.id)!.internalSent),
                          full(flows.get(p.id)!.walletChange),
                        )
                      : undefined
                  }
                >
                  {flows.has(p.id) && p.lastSyncAt ? fmt(flows.get(p.id)!.net, { sign: true }) : '—'}
                </dd>
                {flows.has(p.id) && p.lastSyncAt && Math.abs(flows.get(p.id)!.internalReceived - flows.get(p.id)!.internalSent) >= 0.5 && (
                  <dd class="between">{m.pilotBetween(fmt(flows.get(p.id)!.internalReceived - flows.get(p.id)!.internalSent, { sign: true }))}</dd>
                )}
              </div>
            </dl>

            <div class="actions">
              {/* Alpha or Omega: used by Doctrinas (an Alpha trains at half speed and cannot use every skill) */}
              <form method="post" action="/clone" class="clone-toggle">
                <fieldset title={m.cloneHint}>
                  <legend class="sr-only">{`${m.cloneToggle}: ${p.name}`}</legend>
                  <input type="hidden" name="back" value="/pilotos" />
                  <input type="hidden" name="character" value={p.id} />
                  <button type="submit" name="clone" value="omega" aria-pressed={p.clone === 'alpha' ? 'false' : 'true'}>{m.cloneOmega}</button>
                  <button type="submit" name="clone" value="alpha" aria-pressed={p.clone === 'alpha' ? 'true' : 'false'}>{m.cloneAlpha}</button>
                </fieldset>
              </form>
              {p.missingScopes.length > 0 || p.state.kind === 'error' ? (
                <a class="secondary-button" href={loginUrl} title={m.relinkAs(p.name)} aria-label={m.relinkAs(p.name)}>
                  <Icon name="login" />
                  {m.relink}
                </a>
              ) : (
                <form method="post" action="/sync" class="sync-form">
                  <input type="hidden" name="back" value="/pilotos" />
                  <input type="hidden" name="character" value={p.id} />
                  <button type="submit" class="secondary-button" title={m.syncOneTitle(p.name)}>
                    <Icon name="refresh" />
                    <span class="label">{m.syncOne}</span>
                  </button>
                </form>
              )}
            </div>
          </li>
        ))}

        {Array.from({ length: freeSlots }, (_, i) => (
          <li class="pilot empty">
            <a href={loginUrl}>
              <span class="slot-icon" aria-hidden="true">
                <Icon name="plus" />
              </span>
              <span>
                <strong>{m.freeSlot(pilots.length + i + 1)}</strong>
                <span class="hint">{m.freeSlotHint}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }

  {
    backups && (
      <section class="panel backups" id="copias" aria-labelledby="copias-title">
        <div class="panel-heading">
          <h2 id="copias-title">{m.backupsTitle}</h2>
          {latestBackup && (
            <span class="meta" title={shortDateTime(latestBackup.createdAt, lang)}>
              {m.backupsLast(rel(latestBackup.createdAt))}
            </span>
          )}
        </div>
        <div class="panel-body">
          <ActionNotice ok={backupOk} extra={q.get('ok') === 'restored' ? m.backupRestoredExtra : null} error={backupError} />
          <p class="lead">{m.backupsLead}</p>
          <p class="backup-status">
            <span>{backupList.length ? m.backupsCount(backupList.length, bytes(backupBytes, lang)) : m.backupsNone}</span>
            <span class="folder">
              {m.backupsFolder}: <code>{backups.dir}</code>
            </span>
          </p>
          <div class="backup-actions">
            <form method="post" action="/copias/accion" data-busy-note={m.backupsCreating}>
              <input type="hidden" name="action" value="create" />
              <button type="submit" class="secondary-button">
                <Icon name="database" />
                {m.backupsCreate}
              </button>
            </form>
            {latestBackup && (
              <a class="secondary-button" href={`/copias/${latestBackup.name}`} download={latestBackup.name}>
                <Icon name="download" />
                {m.backupsDownloadLatest}
              </a>
            )}
          </div>
          <p class="tip">{m.backupsTip}</p>
          {backupList.length > 0 && (
            <details class="backup-list">
              <summary>{m.backupsList(backupList.length)}</summary>
              <div class="table-scroll" role="group" aria-label={m.backupsTitle} tabindex="0">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{m.backupsColDate}</th>
                      <th scope="col">{m.backupsColKind}</th>
                      <th scope="col" class="num">{m.backupsColSize}</th>
                      <th scope="col">
                        <span class="sr-only">{m.backupsColActions}</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {backupList.map((b) => (
                      <tr>
                        <th scope="row">{shortDateTime(b.createdAt, lang)}</th>
                        <td class="kind">{KIND_LABEL[b.kind]}</td>
                        <td class="num">{bytes(b.size, lang)}</td>
                        <td class="row-actions">
                          <a class="inline-action" href={`/copias/${b.name}`} download={b.name} title={m.backupsDownloadTitle(shortDateTime(b.createdAt, lang))}>
                            <Icon name="download" />
                            {m.backupsDownload}
                          </a>
                          <form
                            method="post"
                            action="/copias/accion"
                            data-confirm={m.backupsRestoreConfirm(shortDateTime(b.createdAt, lang))}
                            data-busy-note={m.backupsRestoring}
                          >
                            <input type="hidden" name="action" value="restore" />
                            <input type="hidden" name="name" value={b.name} />
                            <button type="submit" class="inline-action" title={m.backupsRestoreTitle(shortDateTime(b.createdAt, lang))}>
                              <Icon name="restore" />
                              {m.backupsRestore}
                            </button>
                          </form>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="keep">{m.backupsKeep(backups.keep.auto)}</p>
            </details>
          )}
          <details class="backup-upload">
            <summary>{m.backupsUpload}</summary>
            <form
              method="post"
              action="/copias/accion"
              enctype="multipart/form-data"
              data-confirm={m.backupsUploadConfirm}
              data-busy-note={m.backupsRestoring}
            >
              <input type="hidden" name="action" value="upload" />
              <p class="hint">{m.backupsUploadHint}</p>
              <label for="backup-file">{m.backupsUploadLabel}</label>
              <div class="upload-row">
                <input id="backup-file" type="file" name="file" accept=".db,application/vnd.sqlite3,application/x-sqlite3" required />
                <button type="submit" class="secondary-button">
                  <Icon name="upload" />
                  {m.backupsUploadButton}
                </button>
              </div>
            </form>
          </details>
        </div>
      </section>
    )
  }

  <p class="privacy">
    <Icon name="info" />
    <span>
      {m.privacyA} <strong>{m.privacyRead}</strong> {m.privacyB}
    </span>
  </p>
</Base>

<script>
  // Backups: restoring asks for confirmation (data-confirm) and the actions show they are working
  // (busy button and a note) until the page comes back. data-busy-note, not data-pending: that attribute reloads Pilotos
  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    const msg = form.dataset.confirm;
    if (msg && !confirm(msg)) {
      e.preventDefault();
      return;
    }
    const note = form.dataset.busyNote;
    if (!note) return;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    // After submitting: disabling it before would cancel the submission itself in some browsers
    setTimeout(() => {
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
      }
      const p = document.createElement('p');
      p.className = 'pending-note';
      p.setAttribute('role', 'status');
      p.textContent = note;
      form.append(p);
    });
  });
  window.addEventListener('pageshow', () => {
    document.querySelectorAll<HTMLButtonElement>('button[aria-busy=true]').forEach((b) => {
      b.disabled = false;
      b.removeAttribute('aria-busy');
    });
    document.querySelectorAll('.pending-note').forEach((n) => n.remove());
  });
  // Return from a backup action: the notice gets focus (jumping to the anchor would take it away)
  if (new URLSearchParams(location.search).get('at') === 'copias') {
    const focus = () => document.querySelector<HTMLElement>('#copias .action-notice')?.focus();
    window.addEventListener('load', () => setTimeout(focus, 0));
  }

  // While some pilot is doing its first sync, reload every 15 s (at most 2 min)
  if (document.querySelector('[data-pending]')) {
    const tries = Number(sessionStorage.getItem('pilotos-reload') ?? 0);
    if (tries < 8) {
      setTimeout(() => {
        sessionStorage.setItem('pilotos-reload', String(tries + 1));
        location.reload();
      }, 15_000);
    }
  } else {
    sessionStorage.removeItem('pilotos-reload');
  }
</script>

<style>
  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  h1 {
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .subtitle {
    margin-top: 6px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .subtitle span {
    color: var(--text-muted);
  }

  .notice.success {
    align-items: center;
    border-color: #2f5a4b;
    background: #13261f;
    color: #cfeee2;
  }
  .notice-portrait {
    flex-shrink: 0;
    border-radius: 6px;
    border: 1px solid #2f5a4b;
  }
  .notice strong {
    font-weight: 600;
  }
  .notice p + p {
    margin-top: 4px;
  }
  .detail {
    color: var(--text-muted);
    font: 12px var(--mono);
  }

  /* Pilot list: one row per character, columns aligned across rows */
  .roster {
    display: grid;
    grid-template-columns: minmax(13rem, 1.2fr) minmax(12rem, 1.1fr) auto minmax(17rem, 1.4fr) auto;
    column-gap: 24px;
    row-gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each row inherits the list's columns: everything stays aligned across pilots */
  .pilot {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
    row-gap: 14px;
    padding: 16px 20px;
  }
  .pilot.fresh {
    border-color: #2f5a4b;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .who img {
    flex-shrink: 0;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    background: #162834;
  }
  .who h2 a {
    color: inherit;
    text-decoration: none;
  }
  .who h2 a:hover {
    color: var(--cyan);
    text-decoration: underline;
  }
  .who h2 {
    font-size: 16px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .since {
    margin-top: 2px;
    font-size: 13px;
    color: var(--text-muted);
  }
  /* The date does not break, but the line may wrap: in a narrow column it slid under «Último sync» */
  .since time {
    white-space: nowrap;
  }

  .state {
    display: grid;
    gap: 4px;
    justify-items: start;
    min-width: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px 3px 7px;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .chip .icon {
    width: 13px;
    height: 13px;
  }
  .chip.ok .icon {
    color: var(--positive);
  }
  .chip.pending {
