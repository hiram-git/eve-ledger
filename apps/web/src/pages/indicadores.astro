---
// Indicadores: goals and rates that answer in-game questions. Omega for all accounts (against the balance of
// the wallets), ISK per hour of ratting, replacement fund for lost ships and market fees
import Base from '../layouts/Base.astro';
import CoverageNote from '../components/CoverageNote.astro';
import Donut from '../components/Donut.astro';
import { fold } from '../lib/shares';
import { getIndicators, getPilots, getSyncStatus, type Indicators, type Pilot, type SyncStatus } from '../lib/api';
import { hasIssue, pilotState } from '../lib/pilot-state';
import { ago, isk, iskFull, refTypeLabel, shortDate } from '../lib/format';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number) => isk(v, { lang });
const full = (v: number) => iskFull(v, lang);
const pct = new Intl.NumberFormat(lang, { style: 'percent', maximumFractionDigits: 0 });
// Fees: one decimal (5.5 %), since the difference between 4 % and 5 % matters
const pctFine = new Intl.NumberFormat(lang, { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 });
const qty = new Intl.NumberFormat(lang, { useGrouping: 'always' });

let indicators: Indicators | undefined;
let status: SyncStatus | undefined;
let pilots: Pilot[] = [];
let apiError: string | undefined;
try {
  [indicators, status, pilots] = await Promise.all([getIndicators(), getSyncStatus(), getPilots()]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

const o = indicators?.omega;
const covered = !!o && o.missing === 0;
const priced = !!o && o.cost !== null;
// An exact 0 % or 100 % progress isn't rounded to something else by the format
const percent = o?.progress == null ? 0 : covered ? 1 : Math.min(0.99, o.progress);
// ISK value of the PLEX you already have (only up to what's needed): the term that was missing from the sum
// Same freshness criterion as the Resumen: the balance Omega adds up says whose is stale or missing
const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const pilotIssues = pilots.filter((p) => hasIssue(p, pilotState(p, m, staleAfterMs, status?.running))).length;
// What each pilot contributes to the balance: the coverage note says how much of it is stale
const balanceByPilot: Record<number, number> = Object.fromEntries(
  (o?.balances ?? []).map((b) => [b.characterId, b.balance ?? 0]),
);
// Do your pilots pay for their Omega? Daily cost (one month = 30 days) versus the daily net of the last 7 days
const paceLine =
  o && o.costPerDay !== null
    ? o.avgDailyNet <= 0
      ? m.omegaPaceNone(`${fmt(o.costPerDay)} ISK`)
      : (o.paceShare ?? 0) >= 1
        ? m.omegaPaceCovers(`${fmt(o.costPerDay)} ISK`, `${fmt(o.avgDailyNet)} ISK`)
        : m.omegaPace(`${fmt(o.costPerDay)} ISK`, `${fmt(o.avgDailyNet)} ISK`, pct.format(o.paceShare ?? 0))
    : '';
const plexValue = o && o.plexPrice !== null ? Math.min(o.plexOwned, o.plexNeeded) * o.plexPrice : 0;

const r = indicators?.ratting;
const rep = indicators?.replacement;
const fees = indicators?.fees;
const ded = indicators?.deductions;
// Systems whose bounties an incursion took a cut of: they're flagged in «Ratting por sistema»
const incursionSystems = new Set((ded?.bySystem ?? []).map((x) => x.systemId));
const dy = indicators?.days;
const fmtSigned = (v: number) => isk(v, { lang, sign: true });
const fullSigned = (v: number) => iskFull(v, lang, true);
const otherPilots = m.otherPilots;
// Ratting ISK by pilot (everything that adds to the pilot: bounties, ESS, escalations and loot)
const pilotSlices = fold(
  (r?.byPilot ?? []).map((p) => ({ label: p.name, value: p.isk, hours: p.hours, iskPerHour: p.iskPerHour })),
  otherPilots,
);
// Bounties by system: the top 6, the rest grouped, and those that don't say the system
const systemSlices = [
  ...(r?.bySystem ?? []).map((sys) => ({ label: sys.name ?? `#${sys.systemId}`, sec: sys.security, value: sys.isk, hours: sys.hours, iskPerHour: sys.iskPerHour, incursion: incursionSystems.has(sys.systemId) })),
  ...(r && r.bySystemRest.systems > 0 ? [{ label: m.systemsOther(r.bySystemRest.systems), sec: null, value: r.bySystemRest.isk, hours: r.bySystemRest.hours, iskPerHour: r.bySystemRest.isk / r.bySystemRest.hours }] : []),
  ...(r && r.bySystemUnknown.ticks > 0 ? [{ label: m.systemsUnknown, sec: null, value: r.bySystemUnknown.isk, hours: r.bySystemUnknown.hours, iskPerHour: r.bySystemUnknown.isk / r.bySystemUnknown.hours }] : []),
];
const systemIsk = systemSlices.reduce((n, s) => n + s.value, 0);
// Balance by pilot: largest to smallest, with their name
const pilotName = new Map(pilots.map((p) => [p.id, p.name]));
const balanceSlices = fold(
  (o?.balances ?? [])
    .filter((b) => (b.balance ?? 0) > 0)
    .map((b) => ({ label: pilotName.get(b.characterId) ?? `#${b.characterId}`, value: b.balance ?? 0 }))
    .sort((a, b) => b.value - a.value),
  otherPilots,
);
const balanceTotal = balanceSlices.reduce((n, b) => n + b.value, 0);
// Loyalty points: LP by corporation (largest first; from the seventh on, «Otras N corporaciones»), valued at the
// best exchange of each store (estimate, grey); EverMarks (Paragon) apart, they can't become ISK
const lp = indicators?.loyalty;
const lpCorps = lp?.corps ?? [];
const lpSlices = fold(
  lpCorps.map((c) => ({ label: c.name ?? `#${c.corporationId}`, value: c.points, corp: c })),
  m.lpOtherCorps,
);
const lpWithPoints = lpCorps.filter((c) => c.points > 0).length;
const lpNoScope = !!lp && lp.pilots.length === 0;
const lpNotSynced = (lp?.pilots ?? []).filter((p) => !p.synced).map((p) => p.name);
const lpMissing = (lp?.missingScope ?? []).map((p) => p.name);
// More than one pilot with LP: each corporation says whose they are
const lpMultiPilot = (lp?.pilots ?? []).filter((p) => p.synced).length > 1;
// «Aria Vex 1.180.000» never breaks between the name and the figure; the list breaks at the « · »
const lpPilots = (c: { byPilot: { name: string; points: number }[] }) =>
  c.byPilot.map((p) => `${p.name} ${qty.format(p.points)}`.replace(/ /g, '\u00a0')).join(' · ');
const signedQty = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${qty.format(Math.abs(v))}`;
const lpChangeText = (delta: number, short = false) =>
  lp?.changePartial && lp.historySince
    ? (short ? m.lpChangeSinceShort : m.lpChangeSince)(signedQty(delta), shortDate(lp.historySince, lang))
    : (short ? m.lpChangeShort : m.lpChange)(signedQty(delta), lp?.days ?? 30);
const emChangeText = (delta: number) =>
  lp?.changePartial && lp.historySince ? m.emChangeSinceShort(signedQty(delta), shortDate(lp.historySince, lang)) : m.emChangeShort(signedQty(delta), lp?.days ?? 30);
const lpOfferTitle = (c: (typeof lpCorps)[number]) =>
  c.offer
    ? m.lpOffer(c.offer.name ?? `#${c.offer.typeId}`, qty.format(c.offer.quantity), qty.format(c.offer.lpCost), c.offer.iskCost > 0 ? fmt(c.offer.iskCost) : '') +
      (c.offer.required ? m.lpOfferInputs(c.offer.required) : '')
    : c.storeRead
      ? m.lpNoStore
      : m.lpStorePending;
// «8 h», «2,3 h», «0,6 h»: one decimal below 10 h; without breaking across lines
// Under an hour, in minutes (a Rifter is «1 min» of ratting, not «0 h»)
const hours = (h: number) =>
  (h < 1
    ? m.minutesShort(String(Math.max(1, Math.round(h * 60))))
    : m.hoursShort(new Intl.NumberFormat(lang, { maximumFractionDigits: h < 10 ? 1 : 0 }).format(h))
  ).replace(/ /g, '\u00a0');
const sec = (v: number | null) => (v === null ? '' : `\u00a0${v.toFixed(1)}`);
const times = new Intl.NumberFormat(lang, { useGrouping: 'always' });
---

<Base title={m.indicators} section="indicadores" status={status} pilots={pilots.length} pilotIssues={pilotIssues}>
  <div class="page-head">
    <h1>{m.indicators}</h1>
    <p class="subtitle">{m.indicatorsLead}</p>
  </div>

  {
    apiError && (
      <div class="notice error" role="alert">
        <div>
          <strong>{m.apiDown}</strong>
          <p class="muted">{apiError}</p>
          <p>
            {m.apiRunning} <code>apps/api</code>: <code>bun run dev</code>
          </p>
        </div>
      </div>
    )
  }

  {
    o && (
      <div class="cards">
        <section class="panel omega" aria-labelledby="omega-title">
          <div class="panel-heading">
            <h2 id="omega-title">{m.omegaTitle}</h2>
            <span class="meta">{m.omegaLead(o.accounts, qty.format(o.plexPerMonth))}</span>
          </div>
          <div class="panel-body">
            {priced ? (
              <>
                <p class:list={['answer', { done: covered }]}>
                  <span class="answer-label">{covered ? m.omegaCovered : m.omegaMissing}</span>
                  {!covered && (
                    <span class="answer-value" title={full(o.missing!)}>
                      {fmt(o.missing!)}<span class="unit"> ISK</span>
                    </span>
                  )}
                  {covered && o.surplus! > 0 && <span class="answer-sub">{m.omegaSurplus(fmt(o.surplus!))}</span>}
                </p>
                {/* A single progress measure: the part of the cost already covered (balance + stored PLEX) */}
                <div
                  class="bar"
                  role="progressbar"
                  aria-label={m.omegaProgress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={Math.round(percent * 100)}
                  aria-valuetext={m.omegaOfCost(pct.format(percent))}
                >
                  <i class:list={{ done: covered }} style={`width:${(percent * 100).toFixed(1)}%`} />
                </div>
                <p class="bar-caption">{m.omegaOfCost(pct.format(percent))}</p>
                {/* Does it pay for itself? Before the breakdown: on mobile it stays on the first screen. Also with the month
                    covered, because Omega renews every month */}
                {paceLine && <p class="eta" title={m.omegaPaceTitle}>{paceLine}</p>}

                {/* The breakdown is the sum that leads to the figure above: cost − balance − stored PLEX */}
                <table class="equation">
                  <caption class="sr-only">{m.omegaBreakdown}</caption>
                  <tbody>
                    <tr>
                      <th scope="row">
                        {m.omegaCost}
                        <span class="row-meta">{m.omegaCostDetail(qty.format(o.plexNeeded), `${fmt(o.plexPrice!)} ISK`)}</span>
                      </th>
                      <td class="op" aria-hidden="true"></td>
                      <td title={full(o.cost!)}>{fmt(o.cost!)}</td>
                    </tr>
                    <tr>
                      <th scope="row">{m.omegaBalance}</th>
                      <td class="op">−</td>
                      <td title={full(o.available)}>{fmt(o.available)}</td>
                    </tr>
                    {o.plexOwned > 0 && (
                      <tr>
                        <th scope="row">
                          {m.omegaPlexInv}
                          <span class="row-meta">{m.omegaPlexCount(qty.format(Math.min(o.plexOwned, o.plexNeeded)))}</span>
                        </th>
                        <td class="op">−</td>
                        <td title={full(plexValue)}>{fmt(plexValue)}</td>
                      </tr>
                    )}
                    <tr class="result">
                      <th scope="row">{covered ? m.omegaLeft : m.omegaMissing}</th>
                      <td class="op">=</td>
                      <td title={full(covered ? o.surplus! : o.missing!)}>{fmt(covered ? o.surplus! : o.missing!)}</td>
                    </tr>
                  </tbody>
                </table>
                <CoverageNote pilots={pilots} staleAfterMs={staleAfterMs} syncRunning={status?.running} amounts={balanceByPilot} walletOnly />
                <p class="price-meta">
                  {m.omegaPlexPrice}: {fmt(o.plexPrice!)} ISK
                  {o.plexPriceSource && o.plexPriceUpdatedAt && <> · {m.omegaPriceMeta(o.plexPriceSource, ago(o.plexPriceUpdatedAt, lang))}</>}
                  {o.plexPriceSource === 'market' && o.plexAveragePrice !== null && <> · {m.omegaNote(`${fmt(o.plexAveragePrice)} ISK`)}</>}
                </p>
              </>
            ) : (
              <div class="no-price">
                <p class="answer-label">{m.omegaNoPrice}</p>
                <p class="eta">{m.omegaNoPriceHint}</p>
                <p class="eta">{m.omegaBalance}: {fmt(o.available)} ISK · {m.omegaPlexNeeded}: {qty.format(o.plexNeeded)}</p>
              </div>
            )}
            {pilots.length === 0 && <p class="eta">{m.omegaNoPilots}</p>}
          </div>
        </section>

        {r && (
          <section class="panel" aria-labelledby="ratting-title">
            <div class="panel-heading">
              <h2 id="ratting-title">{m.rattingTitle}</h2>
              <span class="meta">{m.periodDays(r.days)}</span>
            </div>
            <div class="panel-body">
              {r.iskPerHour === null ? (
                <p class="eta">{m.rattingNone(r.days)}</p>
              ) : (
                <>
                  <p class="answer">
                    <span class="answer-value" title={full(r.iskPerHour)}>
                      {fmt(r.iskPerHour)}<span class="unit"> {m.perHour}</span>
                    </span>
                    <span class="answer-sub">{m.rattingSub(hours(r.hours), r.ticks, fmt(r.isk).replace(' ', '\u00a0'))}</span>
                    {r.recent.iskPerHour !== null && <span class="answer-sub">{m.rattingRecent(r.recent.days, fmt(r.recent.iskPerHour))}</span>}
                  </p>
                  {/* Where the ISK comes from: not just bounties and ESS, also sold escalations and buyback loot */}
                  <p class="rat-parts">
                    {[
                      { label: m.ratPartBounties, value: r.parts.bounties },
                      { label: m.ratPartEss, value: r.parts.ess },
                      { label: m.ratPartLoot, value: r.parts.loot },
                      { label: m.ratPartEscalations, value: r.parts.escalations },
                    ]
                      .filter((p) => p.value >= 0.5)
                      .map((p, i) => (
                        <span title={full(p.value)}>
                          {i > 0 && <span class="op" aria-hidden="true">+</span>}
                          {i > 0 && <span class="sr-only">{m.opPlus} </span>}
                          {p.label} <b>{fmt(p.value)}</b>
                        </span>
                      ))}
                  </p>
                  <div class="donut-row">
                    <Donut slices={pilotSlices} label={m.rattingShare} format={fmt} lang={lang} center={fmt(r.isk)} centerSub="ISK" />
                    <table class="mini">
                      <caption class="sr-only">{m.rattingByPilot}</caption>
                      <thead>
                        <tr>
                          <th>{m.rattingByPilot}</th>
                          <th>{m.rattingHours}</th>
                          <th>{m.rattingIskCol}</th>
                          <th>{m.perHour}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {pilotSlices.map((p, i) => (
                          <tr>
                            <th scope="row">
                              <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                              {p.label}
                            </th>
                            <td>{'hours' in p && typeof p.hours === 'number' ? hours(p.hours) : '—'}</td>
                            <td title={full(p.value)}>{fmt(p.value)}</td>
                            <td title={'iskPerHour' in p && typeof p.iskPerHour === 'number' ? full(p.iskPerHour) : undefined}>
                              {'iskPerHour' in p && typeof p.iskPerHour === 'number' ? fmt(p.iskPerHour) : '—'}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="price-meta">{m.rattingNote(r.tickMinutes)}</p>
                </>
              )}
            </div>
          </section>
        )}

        {r && (
          <section class="panel" aria-labelledby="systems-title">
            <div class="panel-heading">
              <h2 id="systems-title">{m.systemsTitle}</h2>
              <span class="meta">{m.systemsLead(r.days)}</span>
            </div>
            <div class="panel-body">
              {systemIsk <= 0 ? (
                <p class="eta">{m.systemsNone(r.days)}</p>
              ) : (
                <>
                  <div class="donut-row">
                    <Donut slices={systemSlices} label={m.systemsShare} format={fmt} lang={lang} center={fmt(systemIsk)} centerSub="ISK" />
                    <table class="mini">
                      <caption class="sr-only">{m.rattingBySystem}</caption>
                      <thead>
                        <tr>
                          <th>{m.rattingBySystem}</th>
                          <th>{m.rattingHours}</th>
                          <th>{m.rattingIskCol}</th>
                          <th>{m.perHour}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {systemSlices.map((sys, i) => (
                          <tr>
                            <th scope="row">
                              <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                              {sys.label}
                              <span class="sec">{sec(sys.sec)}</span>
                              {'incursion' in sys && sys.incursion && (
                                <span class="tag" title={m.systemsIncursionTitle}>{m.systemsIncursion}</span>
                              )}
                            </th>
                            <td>{hours(sys.hours)}</td>
                            <td title={full(sys.value)}>{fmt(sys.value)}</td>
                            <td title={full(sys.iskPerHour)}>{fmt(sys.iskPerHour)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="price-meta">{m.systemsNote(r.tickMinutes)}</p>
                </>
              )}
            </div>
          </section>
        )}

        {ded && (
          <section class="panel" aria-labelledby="ded-title">
            <div class="panel-heading">
              <h2 id="ded-title">{m.dedTitle}</h2>
              <span class="meta">{m.dedLead(ded.days)}</span>
            </div>
            <div class="panel-body">
              {ded.tax === 0 && ded.incursion === 0 ? (
                <p class="eta">{m.dedNone(ded.days)}</p>
              ) : (
                <>
                  {/* The exact part (tax) is the figure; the estimate (incursion) goes separately, in grey with «~» */}
                  <p class="answer">
                    <span class="answer-label">{ded.tax > 0 ? m.dedTaxLabel : m.dedIncursionLabel}</span>
                    {ded.tax > 0 ? (
                      <span class="answer-value" title={full(ded.tax)}>
                        {fmt(ded.tax)}<span class="unit"> ISK</span>
                      </span>
                    ) : (
                      <span class="answer-value est" title={full(ded.incursion)}>
                        ~{'\u2009'}{fmt(ded.incursion)}<span class="unit"> ISK</span>
                      </span>
                    )}
                    {ded.tax > 0 && ded.incursion > 0 && <span class="answer-sub est">{m.dedIncursionSub(fmt(ded.incursion))}</span>}
                  </p>
                  {ded.grossPerHour !== null && ded.iskPerHour !== null && ded.grossPerHour > ded.iskPerHour && (
                    <p class="ded-rate">
                      {m.dedRate(fmt(ded.grossPerHour), fmt(ded.iskPerHour), pct.format(ded.grossPerHour / ded.iskPerHour - 1))}
                    </p>
                  )}
                  <table class="mini ded">
                    <caption class="sr-only">{m.dedTitle}</caption>
                    <thead>
                      <tr>
                        <th>{m.dedConcept}</th>
                        <th>{m.dedRateCol}</th>
                        <th>ISK</th>
                      </tr>
                    </thead>
                    {ded.byCorp.length > 0 && (
                      <tbody>
                        <tr class="group">
                          <th scope="colgroup" colspan="3">{m.dedTaxGroup}</th>
                        </tr>
                        {ded.byCorp.map((c) => (
                          <tr>
                            <th scope="row" title={c.byType.map((b) => `${refTypeLabel(b.refType, lang)}: ${fmt(b.tax)} ISK`).join(' · ')}>
                              {c.name ?? m.dedUnknownCorp}
                              {c.npc && <span class="sec"> ·{'\u00a0'}{m.dedNpc}</span>}
                            </th>
                            <td>{c.rate !== null ? pctFine.format(c.rate) : '—'}</td>
                            <td title={full(c.tax)}>{fmt(c.tax)}</td>
                          </tr>
                        ))}
                      </tbody>
                    )}
                    {ded.bySystem.length > 0 && (
                      <tbody>
                        <tr class="group">
                          <th scope="colgroup" colspan="3">{m.dedIncursionGroup}</th>
                        </tr>
                        {ded.bySystem.map((x) => (
                          <tr class="est">
                            <th scope="row">
                              {x.name ?? `#${x.systemId}`}
                              <span class="sec">{sec(x.security)} · {m.dedTicks(qty.format(x.ticks))}</span>
                            </th>
                            <td>−{pct.format(ded.penalty)}</td>
                            <td title={full(x.lost)}>~{'\u2009'}{fmt(x.lost)}</td>
                          </tr>
                        ))}
                      </tbody>
                    )}
                  </table>
                </>
              )}
              <p class="price-meta">
                {m.dedNote} {ded.incursionsSince ? m.dedSince(shortDate(ded.incursionsSince, lang)) : m.dedNotYet}
                {ded.taxUnknown > 0 && <> {m.dedTaxUnknown(qty.format(ded.taxUnknown))}</>}
              </p>
            </div>
          </section>
        )}

        {rep && (
          <section class="panel" aria-labelledby="repl-title">
            <div class="panel-heading">
              <h2 id="repl-title">{m.replTitle}</h2>
              <span class="meta">{m.replLead}</span>
            </div>
            <div class="panel-body">
              {rep.noScope ? (
                <p class="eta">{m.replNoScope}</p>
              ) : (
                <>
                  {/* What the period's losses cost you, in the player's currency: hours of ratting */}
                  {rep.count > 0 ? (
                    <p class="answer">
                      <span class="answer-label">{m.replAnswerLabel(rep.days)}</span>
                      {rep.costHours !== null ? (
                        <span class="answer-value">
                          {hours(rep.costHours)}<span class="unit"> {m.replAnswerUnit}</span>
                        </span>
                      ) : (
                        <span class="answer-value">{fmt(rep.cost)}<span class="unit"> ISK</span></span>
                      )}
                      {rep.costHours !== null && rep.iskPerHour !== null && (
                        <span class="answer-sub">{m.replSub(fmt(-rep.cost), fmt(rep.iskPerHour))}</span>
                      )}
                      {rep.costHours === null && <span class="answer-sub">{m.replNoRate}</span>}
                    </p>
                  ) : (
                    <p class="eta">{m.replNoLosses(rep.days)}</p>
                  )}
                  {rep.ships.length > 0 && (
                    <table class="mini">
                      <caption class="sr-only">{m.replTitle}</caption>
                      <thead>
                        <tr>
                          <th>{m.replShip}</th>
                          <th>{m.replValue}</th>
                          <th>{m.replTimes}</th>
                          <th>{m.replHours}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {rep.ships.map((sh) => (
                          <tr>
                            <th scope="row">{sh.ship ?? `#${sh.shipTypeId}`}</th>
                            <td title={full(sh.value)}>{fmt(sh.value)}</td>
                            <td>{sh.times !== null ? m.replTimesN(times.format(sh.times)) : '—'}</td>
                            <td>{sh.hours !== null ? hours(sh.hours) : '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                  <p class="price-meta">{m.replNote}</p>
                </>
              )}
            </div>
          </section>
        )}

        {fees && (
          <section class="panel" aria-labelledby="fees-title">
            <div class="panel-heading">
              <h2 id="fees-title">{m.feesTitle}</h2>
              <span class="meta">{m.feesLead(fees.days)}</span>
            </div>
            <div class="panel-body">
              {fees.total === 0 ? (
                <p class="eta">{m.feesNone(fees.days)}</p>
              ) : (
                <>
                  <p class="answer">
                    <span class="answer-label">{m.feesAnswerLabel}</span>
                    <span class="answer-value" title={full(fees.total)}>
                      {fmt(fees.total)}<span class="unit"> ISK</span>
                    </span>
                    {fees.share !== null && <span class="answer-sub">{m.feesSub(pctFine.format(fees.share), fmt(fees.sales))}</span>}
                  </p>
                  <table class="mini">
                    <caption class="sr-only">{m.feesTitle}</caption>
                    <thead>
                      <tr>
                        <th>{m.feesTitle}</th>
                        <th>ISK</th>
                        <th>{m.feesShareCol}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {fees.byType.map((f) => (
                        <tr>
                          <th scope="row">{refTypeLabel(f.refType, lang)}</th>
                          <td title={full(f.total)}>{fmt(f.total)}</td>
                          <td>{fees.sales ? pctFine.format(f.total / fees.sales) : '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="price-meta">{m.feesNote}</p>
                </>
              )}
            </div>
          </section>
        )}

        {dy && (
          <section class="panel" aria-labelledby="days-title">
            <div class="panel-heading">
              <h2 id="days-title">{m.daysTitle}</h2>
              <span class="meta">{m.daysLead(dy.days)}</span>
            </div>
            <div class="panel-body">
              {dy.withData === 0 || !dy.best || !dy.worst ? (
                <p class="eta">{m.daysNone}</p>
              ) : (
                <>
                  <p class="answer">
                    <span class="answer-label">{m.daysAnswerLabel}</span>
                    <span class="answer-value">{m.daysOf(dy.positive, dy.withData)}</span>
                    <span class="answer-sub">{m.daysStreak(dy.streak)}</span>
                  </p>
                  {/* One net per row: the sign in green/red as throughout the ledger */}
                  <table class="mini">
                    <caption class="sr-only">{m.daysTitle}</caption>
                    <tbody>
                      <tr>
                        <th scope="row">{m.daysBest}</th>
                        <td class="when">{shortDate(dy.best.date, lang)}</td>
                        <td class:list={{ pos: dy.best.net > 0, neg: dy.best.net < 0 }} title={fullSigned(dy.best.net)}>{fmtSigned(dy.best.net)}</td>
                      </tr>
                      <tr>
                        <th scope="row">{m.daysWorst}</th>
                        <td class="when">{shortDate(dy.worst.date, lang)}</td>
                        <td class:list={{ pos: dy.worst.net > 0, neg: dy.worst.net < 0 }} title={fullSigned(dy.worst.net)}>{fmtSigned(dy.worst.net)}</td>
                      </tr>
                      <tr>
                        <th scope="row">{m.daysAvg}</th>
                        <td class="when" />
                        <td class:list={{ pos: (dy.avg ?? 0) > 0, neg: (dy.avg ?? 0) < 0 }} title={dy.avg !== null ? fullSigned(dy.avg) : undefined}>{dy.avg !== null ? fmtSigned(dy.avg) : '—'}</td>
                      </tr>
                      <tr>
                        <th scope="row">{m.daysNegative}</th>
                        <td class="when" />
                        <td>{dy.negative}</td>
                      </tr>
                    </tbody>
                  </table>
                  <p class="price-meta">{m.daysNote}</p>
                </>
              )}
            </div>
          </section>
        )}

        {o && (
          <section class="panel" aria-labelledby="share-title">
            <div class="panel-heading">
              <h2 id="share-title">{m.shareTitle}</h2>
              <span class="meta">{m.shareLead}</span>
            </div>
            <div class="panel-body">
              {balanceTotal <= 0 ? (
                <p class="eta">{m.shareNone}</p>
              ) : (
                <div class="donut-row">
                  <Donut slices={balanceSlices} label={m.shareChart} format={fmt} lang={lang} center={fmt(balanceTotal)} centerSub="ISK" />
                  <table class="mini">
                    <caption class="sr-only">{m.shareChart}</caption>
                    <thead>
                      <tr>
                        <th>{m.rattingByPilot}</th>
                        <th>{m.balance}</th>
                        <th>{m.shareCol}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {balanceSlices.map((b, i) => (
                        <tr>
                          <th scope="row">
                            <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                            {b.label}
                          </th>
                          <td title={full(b.value)}>{fmt(b.value)}</td>
                          <td>{pct.format(b.value / balanceTotal)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </section>
        )}

        {lp && (
          <section class="panel" aria-labelledby="lp-title">
            <div class="panel-heading">
              <h2 id="lp-title">{m.lpTitle}</h2>
              <span class="meta">{m.lpLead}</span>
            </div>
            <div class="panel-body">
              {lpNoScope ? (
                <p class="eta">
                  {m.lpNoScope} <a href="/pilotos">{m.pilots}</a>.
                </p>
              ) : lp.points === 0 && !lp.evermarks ? (
                <p class="eta">{m.lpNone}</p>
              ) : (
                <>
                  {/* The value is an estimate (average price, best exchange): grey with «~»; the LP count is exact */}
                  <p class="answer">
                    {lp.value > 0 ? (
                      <>
                        <span class="answer-label">{m.lpValueLabel}</span>
                        <span class="answer-value est" title={full(lp.value)}>
                          ~{'\u2009'}{fmt(lp.value)}<span class="unit"> ISK</span>
                        </span>
                        <span class="answer-sub">{m.lpSub(qty.format(lp.points), lpWithPoints)}</span>
                      </>
                    ) : (
                      <>
                        <span class="answer-label">{m.lpPointsLabel}</span>
                        <span class="answer-value">
                          {qty.format(lp.points)}<span class="unit"> LP</span>
                        </span>
                        {lpWithPoints > 0 && <span class="answer-sub">{m.lpCorpsCount(lpWithPoints)}</span>}
                      </>
                    )}
                  </p>
                  {lp.change !== null && lp.points > 0 && <p class="lp-change">{lpChangeText(lp.change)}</p>}
                  {lp.points > 0 && (
                    <div class="donut-row">
                      <Donut slices={lpSlices} label={m.lpChart} format={(v) => `${qty.format(v)} LP`} lang={lang} center={qty.format(lp.points)} centerSub="LP" />
                      <table class="mini lp">
                        <caption class="sr-only">{m.lpChart}</caption>
                        <thead>
                          <tr>
                            <th>{m.lpCorp}</th>
                            <th>LP</th>
                            <th>{m.lpRateCol}</th>
                            <th>{m.lpValueCol}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {lpSlices.map((b, i) => {
                            const c = 'corp' in b ? b.corp : null;
                            return (
                              <tr>
                                <th scope="row">
                                  <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                                  {b.label}
                                  {c && lpMultiPilot && c.byPilot.length > 0 && <span class="who">{lpPilots(c)}</span>}
                                </th>
                                <td title={c && c.change !== null ? lpChangeText(c.change, true) : undefined}>{qty.format(b.value)}</td>
                                <td title={c ? lpOfferTitle(c) : undefined}>{c && c.iskPerLp !== null ? qty.format(Math.round(c.iskPerLp)) : '—'}</td>
                                <td class="est" title={c && c.value !== null ? full(c.value) : c ? lpOfferTitle(c) : undefined}>
                                  {c && c.value !== null ? `~\u2009${fmt(c.value)}` : '—'}
                                </td>
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    </div>
                  )}
                  {lp.evermarks && (
                    <p class="lp-evermarks">
                      <b>{m.lpEvermarks(qty.format(lp.evermarks.points))}</b>
                      {lpMultiPilot && lp.evermarks.byPilot.length > 0 && <> · {lpPilots(lp.evermarks)}</>}
                      {lp.evermarks.change !== null && lp.evermarks.change !== 0 && <> · {emChangeText(lp.evermarks.change)}</>}
                      {' · '}
                      {m.lpEvermarksNoIsk}
                    </p>
                  )}
                </>
              )}
              <p class="price-meta">
                {m.lpNote}
                {lp.unvaluedCorps > 0 && <> {m.lpUnvalued(lp.unvaluedCorps)}.</>}
                {lp.storesPending > 0 && <> {m.lpStoresPending(lp.storesPending)}.</>}
                {lpMissing.length > 0 && <> {m.lpMissing(lpMissing.join(', '))}.</>}
                {lpNotSynced.length > 0 && <> {m.lpNotSynced(lpNotSynced.join(', '))}.</>}
              </p>
            </div>
          </section>
        )}
      </div>
    )
  }
</Base>

<style>
  .page-head {
    display: grid;
    gap: 6px;
  }
  .cards > section {
    min-width: 0;
  }
  .sec {
    color: var(--text-muted);
    font-family: var(--mono);
    font-weight: 400;
  }
  /* Descuentos: the estimate (incursion penalty) in grey, never as a firm figure */
  .answer-value.est,
  .answer-sub.est,
  .mini tr.est th,
  .mini tr.est td {
    color: var(--text-muted);
  }
  /* «~ 27,0 M» doesn't break between the «~» and the figure */
  .mini.ded td {
    white-space: nowrap;
  }
  .ded-rate,
  .lp-change {
    margin: 0 0 12px;
    color: var(--text-secondary);
    font-size: 13px;
  }
  /* Puntos de lealtad: the value is an estimate (grey); whose LP they are goes under the corporation */
  .lp-evermarks {
    margin: 12px 0 0;
    color: var(--text-secondary);
    font-size: 13px;
  }
  .lp-evermarks b {
    color: var(--text);
    font-weight: 500;
  }
  .mini.lp td {
    white-space: nowrap;
  }
  .mini.lp td.est {
    color: var(--text-muted);
  }
  .mini.lp .who {
    display: block;
    padding-left: 18px;
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
  }
  .mini tr.group th {
    padding-top: 10px;
    color: var(--text-secondary);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tag {
    margin-left: 6px;
    padding: 0 5px;
    border: 1px solid var(--warning);
    border-radius: 3px;
    color: var(--warning);
    font-size: 12px;
    font-weight: 400;
    white-space: nowrap;
  }
  /* Donut + table (legend and table view at once); when narrow, the donut on top */
  .donut-row {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    gap: 14px 22px;
    align-items: center;
  }
  @media (max-width: 480px) {
    .donut-row {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .donut-row :global(.donut) {
      width: 150px;
    }
    .donut-row .mini {
      width: 100%;
    }
  }
  .mini td.when {
    font-family: var(--font);
    color: var(--text-secondary);
    text-align: right;
  }
  .mini td.pos {
    color: var(--positive);
  }
  .mini td.neg {
    color: var(--critical);
  }
  h1 {
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .subtitle {
    font-size: 13px;
    color: var(--text-secondary);
  }
  .cards {
    display: grid;
    /* auto-fill leaves empty slots: a lone card doesn't stretch to 1200 px */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: 20px;
    align-items: start;
  }
  .meta {
    font-size: 13px;
    color: var(--text-muted);
  }
  .panel-body {
    display: grid;
    gap: 14px;
    padding: 20px 22px 18px;
  }
  .answer {
    display: grid;
    gap: 4px;
    margin: 0;
  }
  .answer-label {
    font-size: 14px;
    color: var(--text-secondary);
  }
  .answer.done .answer-label {
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--positive);
  }
  .answer-value {
    font: 500 44px/1.1 var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .unit {
    font-size: 16px;
    color: #6b9caf; /* the same as the ISK suffix in the Resumen */
    letter-spacing: 0;
  }
  .answer-sub {
    font-size: 13px;
    color: var(--text-muted);
  }
  /* Where the ratting ISK comes from: inline addends, the figure in monospace */
  .rat-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 4px 0 12px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .rat-parts > span {
    white-space: nowrap;
  }
  .rat-parts b {
    font: 500 13px var(--mono);
    color: var(--text);
  }
  .rat-parts .op {
    margin: 0 8px;
    color: var(--text-muted);
  }
  .bar {
    height: 10px;
    border-radius: 5px;
    background: #16232f;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    min-width: 3px;
    background: var(--balance);
  }
  .bar i.done {
    background: var(--positive);
  }
  .bar-caption {
    margin: -6px 0 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .equation {
    width: 100%;
    margin: 6px 0 0;
    border-collapse: collapse;
  }
  .equation th,
  .equation td {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    /* The theme's tables have a bottom border on th: here it only separates the top one */
    border-bottom: 0;
    vertical-align: baseline;
  }
  .equation th {
    /* The label takes the leftover width: operator and figure go together on the right */
    width: 100%;
    /* The theme sets nowrap on th: here long labels (German) can wrap */
    white-space: normal;
    padding-right: 16px;
    font: 400 13px var(--font);
    color: var(--text-secondary);
    text-align: left;
    text-transform: none;
    letter-spacing: 0;
  }
  .equation td {
    font: 15px var(--mono);
    color: var(--text);
    text-align: right;
    white-space: nowrap;
  }
  .equation td:last-child {
    padding-left: 10px;
  }
  .equation td.op {
    width: 2ch;
    padding-left: 12px;
    color: var(--text-muted);
    text-align: center;
  }
  .row-meta {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    color: var(--text-muted);
  }
  /* The result closes the sum: double line as in an accounting ledger */
  .equation tr.result th,
  .equation tr.result td {
    border-top: 3px double var(--line-strong);
    font-weight: 600;
    color: var(--text);
  }
  .price-meta {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .eta {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .no-price {
    display: grid;
    gap: 6px;
  }
  @media (max-width: 600px) {
    .omega .panel-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    .panel-body {
      padding: 18px 16px 14px;
    }
    .answer-value {
      font-size: 36px;
    }
  }
</style>
