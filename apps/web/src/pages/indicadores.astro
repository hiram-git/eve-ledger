---
// Indicadores: metas y ritmos que responden preguntas de juego. Omega de todas las cuentas (contra el saldo de
// los wallets), ISK por hora de ratting, fondo de reposición de las naves perdidas y comisiones del mercado
import Base from '../layouts/Base.astro';
import CoverageNote from '../components/CoverageNote.astro';
import Donut from '../components/Donut.astro';
import { fold } from '../lib/shares';
import { getIndicators, getPilots, getSyncStatus, type Indicators, type Pilot, type SyncStatus } from '../lib/api';
import { hasIssue, pilotState } from '../lib/pilot-state';
import { ago, isk, iskFull, refTypeLabel, shortDate } from '../lib/format';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number) => isk(v, { lang });
const full = (v: number) => iskFull(v, lang);
const pct = new Intl.NumberFormat(lang, { style: 'percent', maximumFractionDigits: 0 });
// Comisiones: un decimal (5,5 %), que la diferencia entre 4 % y 5 % importa
const pctFine = new Intl.NumberFormat(lang, { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 });
const qty = new Intl.NumberFormat(lang, { useGrouping: 'always' });

let indicators: Indicators | undefined;
let status: SyncStatus | undefined;
let pilots: Pilot[] = [];
let apiError: string | undefined;
try {
  [indicators, status, pilots] = await Promise.all([getIndicators(), getSyncStatus(), getPilots()]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

const o = indicators?.omega;
const covered = !!o && o.missing === 0;
const priced = !!o && o.cost !== null;
// Un progreso del 0 % o del 100 % exacto no se redondea a otra cosa por el formato
const percent = o?.progress == null ? 0 : covered ? 1 : Math.min(0.99, o.progress);
// Valor en ISK del PLEX que ya tienes (solo hasta lo necesario): el término que faltaba en la cuenta
// Mismo criterio de frescura que el Resumen: el saldo que suma Omega dice de quién es viejo o falta
const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const pilotIssues = pilots.filter((p) => hasIssue(p, pilotState(p, m, staleAfterMs, status?.running))).length;
// Lo que aporta cada piloto al saldo: la nota de cobertura dice cuánto de él es viejo
const balanceByPilot: Record<number, number> = Object.fromEntries(
  (o?.balances ?? []).map((b) => [b.characterId, b.balance ?? 0]),
);
// ¿Tus pilotos se pagan el Omega? Coste diario (un mes = 30 días) frente al neto diario de los últimos 7 días
const paceLine =
  o && o.costPerDay !== null
    ? o.avgDailyNet <= 0
      ? m.omegaPaceNone(`${fmt(o.costPerDay)} ISK`)
      : (o.paceShare ?? 0) >= 1
        ? m.omegaPaceCovers(`${fmt(o.costPerDay)} ISK`, `${fmt(o.avgDailyNet)} ISK`)
        : m.omegaPace(`${fmt(o.costPerDay)} ISK`, `${fmt(o.avgDailyNet)} ISK`, pct.format(o.paceShare ?? 0))
    : '';
const plexValue = o && o.plexPrice !== null ? Math.min(o.plexOwned, o.plexNeeded) * o.plexPrice : 0;

const r = indicators?.ratting;
const rep = indicators?.replacement;
const fees = indicators?.fees;
const dy = indicators?.days;
const fmtSigned = (v: number) => isk(v, { lang, sign: true });
const fullSigned = (v: number) => iskFull(v, lang, true);
const otherPilots = m.otherPilots;
// ISK de ratting por piloto (todo lo que suma al piloto: recompensas, ESS, escalaciones y loot)
const pilotSlices = fold(
  (r?.byPilot ?? []).map((p) => ({ label: p.name, value: p.isk, hours: p.hours, iskPerHour: p.iskPerHour })),
  otherPilots,
);
// Recompensas por sistema: los 6 primeros, el resto agrupado y las que no dicen sistema
const systemSlices = [
  ...(r?.bySystem ?? []).map((sys) => ({ label: sys.name ?? `#${sys.systemId}`, sec: sys.security, value: sys.isk, hours: sys.hours, iskPerHour: sys.iskPerHour })),
  ...(r && r.bySystemRest.systems > 0 ? [{ label: m.systemsOther(r.bySystemRest.systems), sec: null, value: r.bySystemRest.isk, hours: r.bySystemRest.hours, iskPerHour: r.bySystemRest.isk / r.bySystemRest.hours }] : []),
  ...(r && r.bySystemUnknown.ticks > 0 ? [{ label: m.systemsUnknown, sec: null, value: r.bySystemUnknown.isk, hours: r.bySystemUnknown.hours, iskPerHour: r.bySystemUnknown.isk / r.bySystemUnknown.hours }] : []),
];
const systemIsk = systemSlices.reduce((n, s) => n + s.value, 0);
// Saldo por piloto: de mayor a menor, con su nombre
const pilotName = new Map(pilots.map((p) => [p.id, p.name]));
const balanceSlices = fold(
  (o?.balances ?? [])
    .filter((b) => (b.balance ?? 0) > 0)
    .map((b) => ({ label: pilotName.get(b.characterId) ?? `#${b.characterId}`, value: b.balance ?? 0 }))
    .sort((a, b) => b.value - a.value),
  otherPilots,
);
const balanceTotal = balanceSlices.reduce((n, b) => n + b.value, 0);
// «8 h», «2,3 h», «0,6 h»: una cifra decimal por debajo de 10 h; sin partirse entre líneas
// Por debajo de una hora, en minutos (un Rifter son «1 min» de ratting, no «0 h»)
const hours = (h: number) =>
  (h < 1
    ? m.minutesShort(String(Math.max(1, Math.round(h * 60))))
    : m.hoursShort(new Intl.NumberFormat(lang, { maximumFractionDigits: h < 10 ? 1 : 0 }).format(h))
  ).replace(/ /g, '\u00a0');
const sec = (v: number | null) => (v === null ? '' : `\u00a0${v.toFixed(1)}`);
const times = new Intl.NumberFormat(lang, { useGrouping: 'always' });
---

<Base title={m.indicators} section="indicadores" status={status} pilots={pilots.length} pilotIssues={pilotIssues}>
  <div class="page-head">
    <h1>{m.indicators}</h1>
    <p class="subtitle">{m.indicatorsLead}</p>
  </div>

  {
    apiError && (
      <div class="notice error" role="alert">
        <div>
          <strong>{m.apiDown}</strong>
          <p class="muted">{apiError}</p>
          <p>
            {m.apiRunning} <code>apps/api</code>: <code>bun run dev</code>
          </p>
        </div>
      </div>
    )
  }

  {
    o && (
      <div class="cards">
        <section class="panel omega" aria-labelledby="omega-title">
          <div class="panel-heading">
            <h2 id="omega-title">{m.omegaTitle}</h2>
            <span class="meta">{m.omegaLead(o.accounts, qty.format(o.plexPerMonth))}</span>
          </div>
          <div class="panel-body">
            {priced ? (
              <>
                <p class:list={['answer', { done: covered }]}>
                  <span class="answer-label">{covered ? m.omegaCovered : m.omegaMissing}</span>
                  {!covered && (
                    <span class="answer-value" title={full(o.missing!)}>
                      {fmt(o.missing!)}<span class="unit"> ISK</span>
                    </span>
                  )}
                  {covered && o.surplus! > 0 && <span class="answer-sub">{m.omegaSurplus(fmt(o.surplus!))}</span>}
                </p>
                {/* Una sola medida de avance: la parte del coste ya cubierta (saldo + PLEX guardado) */}
                <div
                  class="bar"
                  role="progressbar"
                  aria-label={m.omegaProgress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={Math.round(percent * 100)}
                  aria-valuetext={m.omegaOfCost(pct.format(percent))}
                >
                  <i class:list={{ done: covered }} style={`width:${(percent * 100).toFixed(1)}%`} />
                </div>
                <p class="bar-caption">{m.omegaOfCost(pct.format(percent))}</p>
                {/* ¿Se paga solo? Antes que el desglose: en móvil queda en la primera pantalla. También con el mes
                    cubierto, porque el Omega se renueva cada mes */}
                {paceLine && <p class="eta" title={m.omegaPaceTitle}>{paceLine}</p>}

                {/* El desglose es la cuenta que lleva a la cifra de arriba: coste − saldo − PLEX guardado */}
                <table class="equation">
                  <caption class="sr-only">{m.omegaBreakdown}</caption>
                  <tbody>
                    <tr>
                      <th scope="row">
                        {m.omegaCost}
                        <span class="row-meta">{m.omegaCostDetail(qty.format(o.plexNeeded), `${fmt(o.plexPrice!)} ISK`)}</span>
                      </th>
                      <td class="op" aria-hidden="true"></td>
                      <td title={full(o.cost!)}>{fmt(o.cost!)}</td>
                    </tr>
                    <tr>
                      <th scope="row">{m.omegaBalance}</th>
                      <td class="op">−</td>
                      <td title={full(o.available)}>{fmt(o.available)}</td>
                    </tr>
                    {o.plexOwned > 0 && (
                      <tr>
                        <th scope="row">
                          {m.omegaPlexInv}
                          <span class="row-meta">{m.omegaPlexCount(qty.format(Math.min(o.plexOwned, o.plexNeeded)))}</span>
                        </th>
                        <td class="op">−</td>
                        <td title={full(plexValue)}>{fmt(plexValue)}</td>
                      </tr>
                    )}
                    <tr class="result">
                      <th scope="row">{covered ? m.omegaLeft : m.omegaMissing}</th>
                      <td class="op">=</td>
                      <td title={full(covered ? o.surplus! : o.missing!)}>{fmt(covered ? o.surplus! : o.missing!)}</td>
                    </tr>
                  </tbody>
                </table>
                <CoverageNote pilots={pilots} staleAfterMs={staleAfterMs} syncRunning={status?.running} amounts={balanceByPilot} walletOnly />
                <p class="price-meta">
                  {m.omegaPlexPrice}: {fmt(o.plexPrice!)} ISK
                  {o.plexPriceSource && o.plexPriceUpdatedAt && <> · {m.omegaPriceMeta(o.plexPriceSource, ago(o.plexPriceUpdatedAt, lang))}</>}
                  {o.plexPriceSource === 'market' && o.plexAveragePrice !== null && <> · {m.omegaNote(`${fmt(o.plexAveragePrice)} ISK`)}</>}
                </p>
              </>
            ) : (
              <div class="no-price">
                <p class="answer-label">{m.omegaNoPrice}</p>
                <p class="eta">{m.omegaNoPriceHint}</p>
                <p class="eta">{m.omegaBalance}: {fmt(o.available)} ISK · {m.omegaPlexNeeded}: {qty.format(o.plexNeeded)}</p>
              </div>
            )}
            {pilots.length === 0 && <p class="eta">{m.omegaNoPilots}</p>}
          </div>
        </section>

        {r && (
          <section class="panel" aria-labelledby="ratting-title">
            <div class="panel-heading">
              <h2 id="ratting-title">{m.rattingTitle}</h2>
              <span class="meta">{m.periodDays(r.days)}</span>
            </div>
            <div class="panel-body">
              {r.iskPerHour === null ? (
                <p class="eta">{m.rattingNone(r.days)}</p>
              ) : (
                <>
                  <p class="answer">
                    <span class="answer-value" title={full(r.iskPerHour)}>
                      {fmt(r.iskPerHour)}<span class="unit"> {m.perHour}</span>
                    </span>
                    <span class="answer-sub">{m.rattingSub(hours(r.hours), r.ticks, fmt(r.isk).replace(' ', '\u00a0'))}</span>
                    {r.recent.iskPerHour !== null && <span class="answer-sub">{m.rattingRecent(r.recent.days, fmt(r.recent.iskPerHour))}</span>}
                  </p>
                  {/* De dónde sale el ISK: no solo recompensas y ESS, también escalaciones vendidas y loot del buyback */}
                  <p class="rat-parts">
                    {[
                      { label: m.ratPartBounties, value: r.parts.bounties },
                      { label: m.ratPartEss, value: r.parts.ess },
                      { label: m.ratPartLoot, value: r.parts.loot },
                      { label: m.ratPartEscalations, value: r.parts.escalations },
                    ]
                      .filter((p) => p.value >= 0.5)
                      .map((p, i) => (
                        <span title={full(p.value)}>
                          {i > 0 && <span class="op" aria-hidden="true">+</span>}
                          {i > 0 && <span class="sr-only">{m.opPlus} </span>}
                          {p.label} <b>{fmt(p.value)}</b>
                        </span>
                      ))}
                  </p>
                  <div class="donut-row">
                    <Donut slices={pilotSlices} label={m.rattingShare} format={fmt} lang={lang} center={fmt(r.isk)} centerSub="ISK" />
                    <table class="mini">
                      <caption class="sr-only">{m.rattingByPilot}</caption>
                      <thead>
                        <tr>
                          <th>{m.rattingByPilot}</th>
                          <th>{m.rattingHours}</th>
                          <th>{m.rattingIskCol}</th>
                          <th>{m.perHour}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {pilotSlices.map((p, i) => (
                          <tr>
                            <th scope="row">
                              <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                              {p.label}
                            </th>
                            <td>{'hours' in p && typeof p.hours === 'number' ? hours(p.hours) : '—'}</td>
                            <td title={full(p.value)}>{fmt(p.value)}</td>
                            <td title={'iskPerHour' in p && typeof p.iskPerHour === 'number' ? full(p.iskPerHour) : undefined}>
                              {'iskPerHour' in p && typeof p.iskPerHour === 'number' ? fmt(p.iskPerHour) : '—'}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="price-meta">{m.rattingNote(r.tickMinutes)}</p>
                </>
              )}
            </div>
          </section>
        )}

        {r && (
          <section class="panel" aria-labelledby="systems-title">
            <div class="panel-heading">
              <h2 id="systems-title">{m.systemsTitle}</h2>
              <span class="meta">{m.systemsLead(r.days)}</span>
            </div>
            <div class="panel-body">
              {systemIsk <= 0 ? (
                <p class="eta">{m.systemsNone(r.days)}</p>
              ) : (
                <>
                  <div class="donut-row">
                    <Donut slices={systemSlices} label={m.systemsShare} format={fmt} lang={lang} center={fmt(systemIsk)} centerSub="ISK" />
                    <table class="mini">
                      <caption class="sr-only">{m.rattingBySystem}</caption>
                      <thead>
                        <tr>
                          <th>{m.rattingBySystem}</th>
                          <th>{m.rattingHours}</th>
                          <th>{m.rattingIskCol}</th>
                          <th>{m.perHour}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {systemSlices.map((sys, i) => (
                          <tr>
                            <th scope="row">
                              <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                              {sys.label}
                              <span class="sec">{sec(sys.sec)}</span>
                            </th>
                            <td>{hours(sys.hours)}</td>
                            <td title={full(sys.value)}>{fmt(sys.value)}</td>
                            <td title={full(sys.iskPerHour)}>{fmt(sys.iskPerHour)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="price-meta">{m.systemsNote(r.tickMinutes)}</p>
                </>
              )}
            </div>
          </section>
        )}

        {rep && (
          <section class="panel" aria-labelledby="repl-title">
            <div class="panel-heading">
              <h2 id="repl-title">{m.replTitle}</h2>
              <span class="meta">{m.replLead}</span>
            </div>
            <div class="panel-body">
              {rep.noScope ? (
                <p class="eta">{m.replNoScope}</p>
              ) : (
                <>
                  {/* Lo que te costaron las pérdidas del período, en la moneda del jugador: horas de ratting */}
                  {rep.count > 0 ? (
                    <p class="answer">
                      <span class="answer-label">{m.replAnswerLabel(rep.days)}</span>
                      {rep.costHours !== null ? (
                        <span class="answer-value">
                          {hours(rep.costHours)}<span class="unit"> {m.replAnswerUnit}</span>
                        </span>
                      ) : (
                        <span class="answer-value">{fmt(rep.cost)}<span class="unit"> ISK</span></span>
                      )}
                      {rep.costHours !== null && rep.iskPerHour !== null && (
                        <span class="answer-sub">{m.replSub(fmt(-rep.cost), fmt(rep.iskPerHour))}</span>
                      )}
                      {rep.costHours === null && <span class="answer-sub">{m.replNoRate}</span>}
                    </p>
                  ) : (
                    <p class="eta">{m.replNoLosses(rep.days)}</p>
                  )}
                  {rep.ships.length > 0 && (
                    <table class="mini">
                      <caption class="sr-only">{m.replTitle}</caption>
                      <thead>
                        <tr>
                          <th>{m.replShip}</th>
                          <th>{m.replValue}</th>
                          <th>{m.replTimes}</th>
                          <th>{m.replHours}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {rep.ships.map((sh) => (
                          <tr>
                            <th scope="row">{sh.ship ?? `#${sh.shipTypeId}`}</th>
                            <td title={full(sh.value)}>{fmt(sh.value)}</td>
                            <td>{sh.times !== null ? m.replTimesN(times.format(sh.times)) : '—'}</td>
                            <td>{sh.hours !== null ? hours(sh.hours) : '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                  <p class="price-meta">{m.replNote}</p>
                </>
              )}
            </div>
          </section>
        )}

        {fees && (
          <section class="panel" aria-labelledby="fees-title">
            <div class="panel-heading">
              <h2 id="fees-title">{m.feesTitle}</h2>
              <span class="meta">{m.feesLead(fees.days)}</span>
            </div>
            <div class="panel-body">
              {fees.total === 0 ? (
                <p class="eta">{m.feesNone(fees.days)}</p>
              ) : (
                <>
                  <p class="answer">
                    <span class="answer-label">{m.feesAnswerLabel}</span>
                    <span class="answer-value" title={full(fees.total)}>
                      {fmt(fees.total)}<span class="unit"> ISK</span>
                    </span>
                    {fees.share !== null && <span class="answer-sub">{m.feesSub(pctFine.format(fees.share), fmt(fees.sales))}</span>}
                  </p>
                  <table class="mini">
                    <caption class="sr-only">{m.feesTitle}</caption>
                    <thead>
                      <tr>
                        <th>{m.feesTitle}</th>
                        <th>ISK</th>
                        <th>{m.feesShareCol}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {fees.byType.map((f) => (
                        <tr>
                          <th scope="row">{refTypeLabel(f.refType, lang)}</th>
                          <td title={full(f.total)}>{fmt(f.total)}</td>
                          <td>{fees.sales ? pctFine.format(f.total / fees.sales) : '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="price-meta">{m.feesNote}</p>
                </>
              )}
            </div>
          </section>
        )}

        {dy && (
          <section class="panel" aria-labelledby="days-title">
            <div class="panel-heading">
              <h2 id="days-title">{m.daysTitle}</h2>
              <span class="meta">{m.daysLead(dy.days)}</span>
            </div>
            <div class="panel-body">
              {dy.withData === 0 || !dy.best || !dy.worst ? (
                <p class="eta">{m.daysNone}</p>
              ) : (
                <>
                  <p class="answer">
                    <span class="answer-label">{m.daysAnswerLabel}</span>
                    <span class="answer-value">{m.daysOf(dy.positive, dy.withData)}</span>
                    <span class="answer-sub">{m.daysStreak(dy.streak)}</span>
                  </p>
                  {/* Un neto por fila: el signo en verde/rojo como en todo el ledger */}
                  <table class="mini">
                    <caption class="sr-only">{m.daysTitle}</caption>
                    <tbody>
                      <tr>
                        <th scope="row">{m.daysBest}</th>
                        <td class="when">{shortDate(dy.best.date, lang)}</td>
                        <td class:list={{ pos: dy.best.net > 0, neg: dy.best.net < 0 }} title={fullSigned(dy.best.net)}>{fmtSigned(dy.best.net)}</td>
                      </tr>
                      <tr>
                        <th scope="row">{m.daysWorst}</th>
                        <td class="when">{shortDate(dy.worst.date, lang)}</td>
                        <td class:list={{ pos: dy.worst.net > 0, neg: dy.worst.net < 0 }} title={fullSigned(dy.worst.net)}>{fmtSigned(dy.worst.net)}</td>
                      </tr>
                      <tr>
                        <th scope="row">{m.daysAvg}</th>
                        <td class="when" />
                        <td class:list={{ pos: (dy.avg ?? 0) > 0, neg: (dy.avg ?? 0) < 0 }} title={dy.avg !== null ? fullSigned(dy.avg) : undefined}>{dy.avg !== null ? fmtSigned(dy.avg) : '—'}</td>
                      </tr>
                      <tr>
                        <th scope="row">{m.daysNegative}</th>
                        <td class="when" />
                        <td>{dy.negative}</td>
                      </tr>
                    </tbody>
                  </table>
                  <p class="price-meta">{m.daysNote}</p>
                </>
              )}
            </div>
          </section>
        )}

        {o && (
          <section class="panel" aria-labelledby="share-title">
            <div class="panel-heading">
              <h2 id="share-title">{m.shareTitle}</h2>
              <span class="meta">{m.shareLead}</span>
            </div>
            <div class="panel-body">
              {balanceTotal <= 0 ? (
                <p class="eta">{m.shareNone}</p>
              ) : (
                <div class="donut-row">
                  <Donut slices={balanceSlices} label={m.shareChart} format={fmt} lang={lang} center={fmt(balanceTotal)} centerSub="ISK" />
                  <table class="mini">
                    <caption class="sr-only">{m.shareChart}</caption>
                    <thead>
                      <tr>
                        <th>{m.rattingByPilot}</th>
                        <th>{m.balance}</th>
                        <th>{m.shareCol}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {balanceSlices.map((b, i) => (
                        <tr>
                          <th scope="row">
                            <i class="swatch" style={`background: var(--cat-${(i % 7) + 1})`} aria-hidden="true" />
                            {b.label}
                          </th>
                          <td title={full(b.value)}>{fmt(b.value)}</td>
                          <td>{pct.format(b.value / balanceTotal)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </section>
        )}
      </div>
    )
  }
</Base>

<style>
  .page-head {
    display: grid;
    gap: 6px;
  }
  .cards > section {
    min-width: 0;
  }
  .sec {
    color: var(--text-muted);
    font-family: var(--mono);
    font-weight: 400;
  }
  /* Torta + tabla (leyenda y vista en tabla a la vez); en estrecho, la torta arriba */
  .donut-row {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    gap: 14px 22px;
    align-items: center;
  }
  @media (max-width: 480px) {
    .donut-row {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .donut-row :global(.donut) {
      width: 150px;
    }
    .donut-row .mini {
      width: 100%;
    }
  }
  .mini td.when {
    font-family: var(--font);
    color: var(--text-secondary);
    text-align: right;
  }
  .mini td.pos {
    color: var(--positive);
  }
