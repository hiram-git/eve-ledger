---
// Doctrinas: los fits de cada doctrina (pegados en EFT) con su plan de skills de la comunidad (.emp de EVEMon).
// Por fit, una fila por piloto: si puede volarlo (y si no, qué le falta y cuánto tarda) y su avance en el plan
// óptimo. Las cuentas las hace la API con las skills y atributos de cada piloto (Alfa a la mitad).
// Entrega 2: coste del fit en Jita, inyectores para volarlo ya o completar el plan, y lo que falta del wallet
// (con todo el saldo o reservando el Omega) en horas de ratting y días al ritmo actual
import Base from '../layouts/Base.astro';
import ActionNotice from '../components/ActionNotice.astro';
import Icon from '../components/Icon.astro';
import {
  getDoctrines,
  getPilots,
  getSyncStatus,
  type DoctrineFit,
  type DoctrinesView,
  type FitPilotStatus,
  type InjectorPlan,
  type MissingSkill,
  type Pilot,
  type Shortfall,
  type SkillEvaluation,
  type SyncStatus,
} from '../lib/api';
import { ago, duration, hoursPlayed, isk, iskFull } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { hasIssue, pilotState } from '../lib/pilot-state';

const lang = getLang(Astro);
const m = t(lang);
const q = Astro.url.searchParams;
const qty = new Intl.NumberFormat(lang, { useGrouping: 'always' });
const pct = new Intl.NumberFormat(lang, { style: 'percent', maximumFractionDigits: 0 });
const sp = (v: number) => isk(v, { lang });
const time = (min: number | null) => (min === null ? m.trainUnknown : duration(min, lang));
const ROMAN = ['0', 'I', 'II', 'III', 'IV', 'V'];

let view: DoctrinesView | undefined;
let pilots: Pilot[] = [];
let status: SyncStatus | undefined;
let apiError: string | undefined;
try {
  [view, pilots, status] = await Promise.all([getDoctrines(), getPilots(), getSyncStatus()]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const pilotIssues = pilots.filter((p) => hasIssue(p, pilotState(p, m, staleAfterMs, status?.running))).length;
const pilotOf = new Map(view?.pilots.map((p) => [p.id, p]));
const noScope = view?.pilots.filter((p) => !p.hasScope) ?? [];
const noData = view?.pilots.filter((p) => p.hasScope && !p.skillsAt) ?? [];

// Resultado de la última acción (vuelta de /doctrinas/accion)
const okKind = q.get('ok');
const okText =
  okKind === 'doctrine'
    ? m.doctrineOk(q.get('name') ?? '')
    : okKind === 'fit'
      ? m.fitOk
      : okKind === 'plan'
        ? m.planOk(q.get('name') ?? '', Number(q.get('n') ?? 0))
        : okKind === 'deleted'
          ? m.deletedOk
          : okKind === 'prices'
            ? m.pricesOk(Number(q.get('n') ?? 0))
            : null;
const ignored = q.get('ignored');
const errorCode = q.get('error');
const errorText = errorCode ? m.doctrineError(errorCode, q.get('detail')) : null;
const extraText = ignored ? m.fitIgnored(ignored) : null;
// Dónde va el aviso: junto a lo que se tocó (fondos, una doctrina o un fit); sin sitio, arriba
const at = q.get('at');
const noticeAt = (key: string) => !!at && at === key && (!!okText || !!errorText);

// En cada fit, primero quien puede volarlo; luego quien solo necesita Omega y quien está más cerca
const RANK: Record<FitPilotStatus, number> = { ok: 0, omega: 1, missing: 2, noData: 3, noScope: 4 };
const sorted = (fit: DoctrineFit) =>
  [...fit.pilots].sort(
    (a, b) =>
      RANK[a.status] - RANK[b.status] ||
      (a.fly?.minutes ?? Infinity) - (b.fly?.minutes ?? Infinity) ||
      (pilotOf.get(a.characterId)?.name ?? '').localeCompare(pilotOf.get(b.characterId)?.name ?? ''),
  );
const fitLabel = (f: DoctrineFit) => (f.ship ? `${f.ship} · ${f.name}` : f.name);
// Lo que tiene de un plan, en SP (el avance real: una skill de rango 10 pesa más que una de rango 1)
const progress = (e: SkillEvaluation) => (e.targetSp ? Math.min(1, (e.haveSp ?? 0) / e.targetSp) : e.missing.length ? 0 : 1);
const skillLine = (s: MissingSkill) =>
  s.omegaOnly ? m.skillOmegaOnly : `${s.active ? ROMAN[s.active] : m.skillUntrained} → ${ROMAN[s.need]} · ${time(s.minutes)}`;
const statusText = (status: FitPilotStatus, fly: SkillEvaluation | null) =>
  status === 'ok'
    ? m.statusOk
    : status === 'omega'
      ? m.statusOmega
      : status === 'missing'
        ? m.statusMissing(fly?.missing.length ?? 0)
        : status === 'noScope'
          ? m.statusNoScope
          : m.statusNoData;
const STATUS_ICON: Record<FitPilotStatus, 'check' | 'clock' | 'alert' | 'info'> = {
  ok: 'check',
  missing: 'clock',
  omega: 'alert',
  noScope: 'alert',
  noData: 'info',
};
// Dinero y presupuesto
const money = (v: number) => isk(v, { lang });
const costOr = (v: number | null) => (v === null ? m.noPriceShort : money(v));
const injText = (i: InjectorPlan) => m.injectors(i.large, i.small);
const shortText = (s: Shortfall) =>
  s.short <= 0
    ? m.covered
    : [
        m.shortBy(money(s.short)),
        s.hours !== null && m.farmHours(hoursPlayed(s.hours, lang)),
        s.days !== null && m.farmDays(duration(s.days * 1440, lang)),
      ]
        .filter(Boolean)
        .join(' · ');
const funds = view?.funds;
const allFits = view?.doctrines.flatMap((d) => d.fits) ?? [];
// El precio más viejo de los que se usan: la frescura de toda la página
const pricedAt = allFits.map((f) => f.cost.pricedAt).filter((d): d is string => !!d).sort()[0] ?? null;
// «Para volarlo ya» en cuatro iconos: skills, clon (Ω/α), ISK del wallet e inyectores. Cada uno con su estado
// (good / part / warn / info / off), una etiqueta corta visible y la frase completa para lectores y el title
type ChipState = 'good' | 'part' | 'warn' | 'info' | 'off';
type Chip = { key: string; state: ChipState; icon?: 'check' | 'clock' | 'info' | 'wallet' | 'syringe' | 'alert'; glyph?: string; label: string; full: string };
type FitRow = DoctrineFit['pilots'][number];
const farmText = (s: Shortfall) =>
  [s.hours !== null && m.farmHours(hoursPlayed(s.hours, lang)), s.days !== null && m.farmDays(duration(s.days * 1440, lang))]
    .filter(Boolean)
    .map((t) => ` · ${t}`)
    .join('');
const chipsFor = (f: DoctrineFit, row: FitRow): Chip[] => {
  const pilot = pilotOf.get(row.characterId);
  const alpha = pilot?.clone === 'alpha';
  const unsynced = row.status === 'noScope' || row.status === 'noData';
  // Skills
  const trainable = row.fly?.missing.filter((x) => !x.omegaOnly) ?? [];
  const skills: Chip =
    row.status === 'noScope'
      ? { key: 'skills', state: 'off', icon: 'info', label: m.chipNoScope, full: m.statusNoScope }
      : row.status === 'noData'
        ? { key: 'skills', state: 'off', icon: 'info', label: m.chipNoData, full: m.statusNoData }
        : row.status === 'ok'
          ? { key: 'skills', state: 'good', icon: 'check', label: m.chipSkillsOk, full: m.chipSkillsOkFull }
          : trainable.length === 0
            ? { key: 'skills', state: 'good', icon: 'check', label: m.chipSkillsTrained, full: m.chipSkillsTrainedFull }
            : {
                key: 'skills',
                state: 'info',
                icon: 'clock',
                label: time(row.fly?.minutes ?? null),
                full: m.chipSkillsMissingFull(trainable.length, time(row.fly?.minutes ?? null)),
              };
  // Clon: lo que pide el fit frente a lo que es el piloto
  const because = f.omegaSkills.length ? ` · ${m.omegaBecause(f.omegaSkills.slice(0, 3).join(', '))}` : '';
  const clone: Chip =
    f.clone === 'omega'
      ? alpha
        ? { key: 'clone', state: 'warn', glyph: 'Ω', label: m.chipCloneOmega, full: m.cloneOmegaBlocked + because }
        : { key: 'clone', state: 'good', glyph: 'Ω', label: m.chipCloneOmega, full: m.cloneOmegaOk + because }
      : f.clone === 'alpha'
        ? { key: 'clone', state: 'good', glyph: 'α', label: m.chipCloneAlpha, full: m.cloneAlphaOk }
        : f.clone === 'alphaUnsure'
          ? { key: 'clone', state: 'off', glyph: 'α', label: m.chipCloneAlphaUnsure, full: m.cloneAlphaUnsure }
          : { key: 'clone', state: 'off', glyph: '?', label: m.chipCloneUnknown, full: m.cloneUnknown };
  // ISK: sin skills que mirar, el del fit solo
  const b = row.budget ?? (unsynced ? f.budget : null);
  const isk: Chip = !b
    ? { key: 'isk', state: 'off', icon: 'wallet', label: m.chipIskUnknown, full: m.budgetNoInjectorPrice }
    : b.wallet.short <= 0 && b.withOmega && b.withOmega.short <= 0
      ? { key: 'isk', state: 'good', icon: 'wallet', label: m.chipIskOk, full: m.chipIskOkFull }
      : b.wallet.short <= 0
        ? {
            key: 'isk',
            state: 'part',
            icon: 'wallet',
            label: m.chipIskPart,
            full: m.chipIskPartFull(b.withOmega ? money(b.withOmega.short) + farmText(b.withOmega) : m.noOmegaPrice),
          }
        : { key: 'isk', state: 'warn', icon: 'wallet', label: m.chipIskShort(money(b.wallet.short)), full: m.chipIskShortFull(money(b.wallet.short), farmText(b.wallet)) };
  // Inyectores para volarlo ya
  const inj = row.injectors?.fly;
  const injectors: Chip = unsynced
    ? { key: 'inj', state: 'off', icon: 'syringe', label: '—', full: row.status === 'noScope' ? m.statusNoScope : m.statusNoData }
    : !inj || inj.sp <= 0
      ? { key: 'inj', state: 'good', icon: 'syringe', label: m.chipInjNone, full: m.chipInjNoneFull }
      : { key: 'inj', state: 'info', icon: 'syringe', label: m.chipInj(inj.large, inj.small), full: m.chipInjFull(injText(inj), costOr(inj.cost)) };
  return [skills, clone, isk, injectors];
};
// Coste del fit por partes, para la barra de colores (misma paleta categórica que el resto: casco, módulos, drones, carga)
const costShares = (f: DoctrineFit) =>
  (
    [
      ['hull', f.cost.hull, m.costHull],
      ['fitted', f.cost.fitted, m.costFitted],
      ['drones', f.cost.drones, m.costDrones],
      ['cargo', f.cost.cargo, m.costCargo],
    ] as const
  )
    .filter(([, v]) => v > 0)
    .map(([key, v, label]) => ({ key, v, share: f.cost.total ? v / f.cost.total : 0, label: label(money(v)) }));
const shipIcon = (id: number) => `https://images.evetech.net/types/${id}/icon?size=64`;
---

<Base title={m.doctrines} section="doctrinas" status={status} pilots={pilots.length} pilotIssues={pilotIssues}>
  <div class="page-head">
    <div>
      <h1>{m.doctrines}</h1>
      <p class="subtitle">{m.doctrinesLead}</p>
    </div>
    {
      !apiError && (
        <form method="post" action="/doctrinas/accion" class="new-doctrine" data-pending={m.pendingWorking}>
          <input type="hidden" name="action" value="create" />
          <label for="doctrine-name" class="sr-only">{m.doctrineName}</label>
          <input id="doctrine-name" name="name" type="text" maxlength="80" required placeholder={m.doctrineNamePlaceholder} autocomplete="off" />
          <button type="submit" class="secondary-button">
            <Icon name="add" />
            {m.doctrineCreate}
          </button>
        </form>
      )
    }
  </div>

  {!at && <ActionNotice ok={okText} extra={extraText} error={errorText} />}
  {
    apiError && (
      <div class="notice error" role="alert">
        <Icon name="alert" />
        <div>
          <strong>{m.apiDown}</strong>
          <p class="muted">{apiError}</p>
        </div>
      </div>
    )
  }
  {
    view && view.pilots.length === 0 && (
      <div class="notice" role="status">
        <Icon name="info" />
        <p>
          {m.doctrinesNoPilots} <a href="/pilotos">{m.pilots}</a>
        </p>
      </div>
    )
  }
  {
    /* Quién no entra en las cuentas y por qué: la acción está en Pilotos */
    (noScope.length > 0 || noData.length > 0) && (
      <div class="coverage">
        {noScope.length > 0 && (
          <p>
            <Icon name="alert" class="stale-icon" />
            {m.doctrinesScopeMissing(noScope.map((p) => p.name).join(', '))} <a href="/pilotos">{m.pilots}</a>.
          </p>
        )}
        {noData.length > 0 && (
          <p>
            <Icon name="info" class="info-icon" />
            {m.doctrinesNoData(noData.map((p) => p.name).join(', '))}
          </p>
        )}
      </div>
    )
  }

  {view && view.doctrines.length === 0 && <p class="empty-state">{m.doctrinesEmpty}</p>}

  {
    /* Con qué se paga: lo mismo para todos los fits (el saldo de todos tus pilotos, el Omega y tus ritmos) */
    funds && allFits.length > 0 && (
      <section class="funds" id="fondos" aria-labelledby="funds-title">
        <h2 id="funds-title" class="sr-only">{m.fundsTitle}</h2>
        {noticeAt('fondos') && <ActionNotice ok={okText} error={errorText} />}
        <dl>
          <div>
            <dt>{m.fundsWallet}</dt>
            <dd title={iskFull(funds.wallet, lang)}>{money(funds.wallet)}</dd>
          </div>
          <div>
            <dt>{m.fundsOmega}</dt>
            <dd title={funds.omegaReserve === null ? undefined : iskFull(funds.omegaReserve, lang)}>{costOr(funds.omegaReserve)}</dd>
          </div>
          <div>
            <dt>{m.fundsRatting}</dt>
            <dd>{funds.iskPerHour === null ? '—' : m.perHourOf(money(funds.iskPerHour))}</dd>
          </div>
          <div>
            <dt>{m.fundsPace}</dt>
            <dd>{funds.dailyNet === null ? '—' : m.perDay(isk(funds.dailyNet, { lang, sign: true }))}</dd>
          </div>
          <div>
            <dt>{m.fundsInjectors}</dt>
            <dd class="small">{m.injectorPrices(costOr(funds.injectorPrice.large), costOr(funds.injectorPrice.small))}</dd>
          </div>
        </dl>
        <div class="funds-foot">
          <p>
            {m.fundsNote} {m.budgetScenariosHint}
            {pricedAt && (
              <>
                {' '}
                <span class="nowrap">{m.pricesFrom(ago(pricedAt, lang))}</span>
              </>
            )}
          </p>
          <form method="post" action="/doctrinas/accion" data-pending={m.pendingPrices}>
            <input type="hidden" name="action" value="prices" />
            <button type="submit" class="inline-action">
              <Icon name="refresh" />
              {m.pricesRefresh}
            </button>
          </form>
        </div>
        {/* Qué dice cada icono de «Para volarlo ya» */}
        <p class="legend">
          <span class="legend-title">{m.legendTitle}</span>
          <span><Icon name="check" /> {m.legendSkills}</span>
          <span><b class="glyph" aria-hidden="true">Ω</b>/<b class="glyph" aria-hidden="true">α</b> {m.legendClone}</span>
          <span><Icon name="wallet" /> {m.legendIsk}</span>
          <span><Icon name="syringe" /> {m.legendInj}</span>
        </p>
      </section>
    )
  }

  {
    view?.doctrines.map((d) => {
      const withData = view!.pilots.filter((p) => p.hasScope && p.skillsAt);
      return (
        <section class="panel doctrine" id={`doctrina-${d.id}`} aria-labelledby={`doctrina-${d.id}-title`}>
          <div class="panel-heading">
            <h2 id={`doctrina-${d.id}-title`}>{d.name}</h2>
            <form method="post" action="/doctrinas/accion" data-confirm={m.doctrineDeleteConfirm(d.name)}>
              <input type="hidden" name="action" value="delete-doctrine" />
              <input type="hidden" name="id" value={d.id} />
              <button type="submit" class="icon-button" title={m.doctrineDelete} aria-label={`${m.doctrineDelete}: ${d.name}`}>
                <Icon name="trash" />
              </button>
            </form>
          </div>

          {noticeAt(`doctrina-${d.id}`) && (
            <div class="panel-notice">
              <ActionNotice ok={okText} extra={extraText} error={errorText} />
            </div>
          )}

          {/* Quién vuela la doctrina: cuántos de sus fits puede volar cada piloto (con skills sincronizadas) */}
          {d.fits.length > 0 && withData.length > 0 && (
            <div class="who-flies">
              <span class="who-label">{m.doctrineWho}</span>
              <ul>
                {withData.map((p) => {
                  const n = d.fits.filter((f) => f.pilots.find((x) => x.characterId === p.id)?.status === 'ok').length;
                  return (
                    <li class:list={{ none: n === 0, some: n > 0 && n < d.fits.length, all: n === d.fits.length }}>
                      <span class="name">{p.name}</span>
                      <span class="count">{m.doctrineFlies(n, d.fits.length)}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          {d.fits.length === 0 && <p class="panel-body muted">{m.fitNone}</p>}

          {d.fits.map((f) => (
            <article class="fit" id={`fit-${f.id}`} aria-labelledby={`fit-${f.id}-title`}>
              <header class="fit-head">
                <img src={shipIcon(f.shipTypeId)} alt="" width="40" height="40" loading="lazy" onerror="this.style.visibility='hidden'" />
                <div class="fit-title">
                  <h3 id={`fit-${f.id}-title`}>
                    {f.ship && <span class="ship">{f.ship}</span>}
                    <span class="fit-name">{f.name}</span>
                  </h3>
                  <p class="fit-meta">
                    {/* Colores = las partes del coste: módulos (ranuras), drones y carga */}
                    {[
                      [f.slots.high, m.slotHigh, 'fitted'],
                      [f.slots.mid, m.slotMid, 'fitted'],
                      [f.slots.low, m.slotLow, 'fitted'],
                      [f.slots.rig, m.slotRig, 'fitted'],
                      [f.slots.subsystem, m.slotSub, 'fitted'],
                    ]
                      .filter(([n]) => (n as number) > 0)
                      .map(([n, label, part]) => (
                        <span class:list={['slot', part as string]}>{(label as (n: number) => string)(n as number)}</span>
                      ))}
                    {f.drones > 0 && <span class="slot drones">{m.fitDrones(qty.format(f.drones))}</span>}
                    {f.cargo > 0 && <span class="slot cargo">{m.fitCargo(qty.format(f.cargo))}</span>}
                    {f.required > 0 && <span class="req">{m.fitRequired(f.required)}</span>}
                  </p>
                  <p class="fit-cost">
                    <strong title={iskFull(f.cost.total, lang)}>{m.fitCost(money(f.cost.total))}</strong>
                    {costShares(f).map((c) => (
                      <span class:list={['part', c.key]}>{c.label}</span>
                    ))}
                    {f.cost.unpriced > 0 && <span class="unpriced">{m.costUnpriced(f.cost.unpriced)}</span>}
                  </p>
                  {f.cost.total > 0 && (
                    <span class="cost-bar" aria-hidden="true">
                      {costShares(f).map((c) => (
                        <i class={c.key} style={`width:${(c.share * 100).toFixed(2)}%`} />
                      ))}
                    </span>
                  )}
                </div>
                <form method="post" action="/doctrinas/accion" data-confirm={m.fitDeleteConfirm(fitLabel(f))}>
                  <input type="hidden" name="action" value="delete-fit" />
                  <input type="hidden" name="id" value={f.id} />
                  <input type="hidden" name="doctrine" value={d.id} />
                  <button type="submit" class="icon-button" title={m.fitDelete} aria-label={`${m.fitDelete}: ${fitLabel(f)}`}>
                    <Icon name="trash" />
                  </button>
                </form>
              </header>

              {noticeAt(`fit-${f.id}`) && <ActionNotice ok={okText} extra={extraText} error={errorText} />}

              <div class="plan-line">
                {f.plan ? (
                  <>
                    <span class="plan-name">{m.planName(f.plan.name, f.plan.skills)}</span>
                    <details class="plan-change">
                      <summary>{m.planReplace}</summary>
                      <form method="post" action="/doctrinas/accion" enctype="multipart/form-data" class="plan-form" data-pending={m.pendingPlan}>
                        <input type="hidden" name="action" value="plan" />
                        <input type="hidden" name="id" value={f.id} />
                        <label>
                          <span class="sr-only">{m.planFile}</span>
                          <input type="file" name="file" accept=".emp" required />
                        </label>
                        <button type="submit" class="secondary-button">
                          <Icon name="upload" />
                          {m.planImport}
                        </button>
                      </form>
                    </details>
                    <form method="post" action="/doctrinas/accion" class="plan-delete">
                      <input type="hidden" name="action" value="delete-plan" />
                      <input type="hidden" name="id" value={f.id} />
                      <button type="submit" class="inline-action">{m.planDelete}</button>
                    </form>
                  </>
                ) : (
                  <form method="post" action="/doctrinas/accion" enctype="multipart/form-data" class="plan-form" data-pending={m.pendingPlan}>
                    <input type="hidden" name="action" value="plan" />
                    <input type="hidden" name="id" value={f.id} />
                    <span class="plan-none">{m.planNone}</span>
                    <label>
                      <span class="sr-only">{m.planFile}</span>
                      <input type="file" name="file" accept=".emp" required title={m.planHint} />
                    </label>
                    <button type="submit" class="secondary-button">
                      <Icon name="upload" />
                      {m.planImport}
                    </button>
                  </form>
                )}
              </div>

              {f.pilots.length > 0 && (
                <div class="table-scroll" role="group" aria-label={m.fitTableLabel(fitLabel(f))} tabindex="0">
                  <table class="fit-pilots">
                    <caption class="sr-only">{m.fitTableLabel(fitLabel(f))}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{m.colPilot}</th>
                        <th scope="col">{m.colFly}</th>
                        <th scope="col">{m.colPlan}</th>
                        <th scope="col" title={m.budgetScenariosHint}>{m.colBudget}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {sorted(f).map((row) => {
                        const p = pilotOf.get(row.characterId);
                        const plan = row.plan;
                        return (
                          <tr class={row.status}>
                            <th scope="row">
                              <span class="pilot-name">{p?.name ?? row.characterId}</span>
                              {p?.clone === 'alpha' && <span class="clone-tag">{m.cloneAlpha}</span>}
                            </th>
                            <td class="fly">
                              <span class:list={['status', row.status]}>
                                <Icon name={STATUS_ICON[row.status]} />
                                {statusText(row.status, row.fly)}
                              </span>
                              {row.status === 'missing' && row.fly && <span class="sub">{m.trainTime(time(row.fly.minutes))}</span>}
                              {row.status === 'omega' && (
                                <span class="sub">{row.fly?.needsOmega ? m.statusOmegaHint : m.statusOmegaBlocked}</span>
                              )}
                              {row.fly && row.fly.missing.length > 0 && (
                                <details class="skills">
                                  <summary>{m.missingList(row.fly.missing.length)}</summary>
                                  <ul>
                                    {row.fly.missing.map((s) => (
                                      <li>
                                        <span class="skill">{s.name ?? s.skillId}</span>
                                        <span class="lv">{skillLine(s)}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </details>
                              )}
                            </td>
                            <td class="plan">
                              {!plan ? (
                                <span class="none">—</span>
                              ) : (
                                <>
                                  {/* En móvil no hay cabecera de columna: la barra sola no decía de qué era */}
                                  <span class="cell-label" aria-hidden="true">{m.colPlan}</span>
                                  <span class="plan-pct">
                                    <span class="bar" aria-hidden="true">
                                      <i style={`width:${(progress(plan) * 100).toFixed(1)}%`} />
                                    </span>
                                    <span class:list={['num', { done: plan.missing.length === 0 }]}>
                                      {plan.missing.length === 0 ? m.planDone : m.planPercent(pct.format(Math.floor(progress(plan) * 100) / 100))}
                                    </span>
                                  </span>
                                  {plan.missing.length > 0 && (
                                    <span class="sub">
                                      {plan.missingSp !== null
                                        ? plan.minutes !== null
                                          ? m.planLeft(sp(plan.missingSp), duration(plan.minutes, lang))
                                          : m.planLeftSp(sp(plan.missingSp))
                                        : m.trainUnknown}
                                    </span>
                                  )}
                                  {row.injectors?.plan && row.injectors.plan.sp > 0 && (
                                    <span class="sub">{m.planInjectors(injText(row.injectors.plan), costOr(row.injectors.plan.cost))}</span>
                                  )}
                                  {plan.missing.length > 0 && (
                                    <details class="skills">
                                      <summary>{m.missingList(plan.missing.length)}</summary>
                                      <ul>
                                        {plan.missing.map((s) => (
                                          <li>
                                            <span class="skill">{s.name ?? s.skillId}</span>
                                            <span class="lv">{skillLine(s)}</span>
                                          </li>
                                        ))}
                                      </ul>
                                    </details>
                                  )}
                                </>
                              )}
                            </td>
                            <td class="budget">
                              <span class="cell-label" aria-hidden="true">{m.colBudget}</span>
                              <ul class="checks">
                                {chipsFor(f, row).map((c) => (
                                  <li class:list={['check', c.key, c.state]} title={c.full}>
                                    <span class="ico" aria-hidden="true">{c.glyph ? <b class="glyph">{c.glyph}</b> : <Icon name={c.icon!} />}</span>
                                    <span class="lbl" aria-hidden="true">{c.label}</span>
                                    <span class="sr-only">{c.full}</span>
                                  </li>
                                ))}
                              </ul>
                              {row.budget && (
                                <details class="sums">
                                  <summary>
                                    <span class="need" title={iskFull(row.budget.need, lang)}>{money(row.budget.need)}</span> · {m.budgetDetails}
                                  </summary>
                                  <span class="sub">
                                    {row.injectors?.fly && row.injectors.fly.sp > 0
                                      ? m.budgetParts(money(f.cost.total), injText(row.injectors.fly), costOr(row.injectors.fly.cost))
                                      : m.budgetFitOnly}
                                  </span>
                                  <dl class="scenarios">
                                    <div class:list={{ covered: row.budget.wallet.short <= 0 }}>
                                      <dt>{m.scenarioWallet}</dt>
                                      <dd>{shortText(row.budget.wallet)}</dd>
                                    </div>
                                    <div class:list={{ covered: !!row.budget.withOmega && row.budget.withOmega.short <= 0 }}>
                                      <dt>{m.scenarioOmega}</dt>
                                      <dd>{row.budget.withOmega ? shortText(row.budget.withOmega) : m.noOmegaPrice}</dd>
                                    </div>
                                  </dl>
                                </details>
                              )}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </article>
          ))}

          <details class="add-fit" open={d.fits.length === 0 || (!!errorText && at === `doctrina-${d.id}`)}>
            <summary>
              <Icon name="add" />
              {m.fitAdd}
            </summary>
            <form method="post" action="/doctrinas/accion" class="fit-form" data-pending={m.pendingFit} data-draft={`eft-${d.id}`}>
              <input type="hidden" name="action" value="add-fit" />
              <input type="hidden" name="id" value={d.id} />
              <label for={`eft-${d.id}`}>{m.fitPaste}</label>
              <p class="hint" id={`eft-hint-${d.id}`}>{m.fitPasteHint}</p>
              <textarea
                id={`eft-${d.id}`}
                name="eft"
                rows="10"
                maxlength="50000"
                required
                spellcheck="false"
                aria-describedby={`eft-hint-${d.id}`}
                placeholder="[Rifter, Rifter PvP]"></textarea>
              <button type="submit" class="secondary-button">
                <Icon name="add" />
                <span class="label">{m.fitAdd}</span>
              </button>
            </form>
          </details>
        </section>
      );
    })
  }
</Base>

<script>
  // Borrar pide confirmación (data-confirm). Las acciones que llaman a ESI (data-pending) muestran que están
  // trabajando: botón ocupado y una nota, hasta que vuelve la página con el resultado junto a lo que se tocó
  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    const msg = form.dataset.confirm;
    if (msg && !confirm(msg)) {
      e.preventDefault();
      return;
    }
    // El fit pegado se guarda por si vuelve con un error (la página se recarga y el textarea se vaciaría)
    const draft = form.dataset.draft;
    const area = form.querySelector('textarea');
    try {
      if (draft && area) sessionStorage.setItem(draft, area.value);
    } catch {}
    const pending = form.dataset.pending;
    if (!pending) return;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    // Después del envío: deshabilitarlo antes cancelaría el propio envío en algunos navegadores
    setTimeout(() => {
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
      }
      let note = form.querySelector<HTMLElement>('.pending-note');
      if (!note) {
        note = document.createElement('p');
        note.className = 'pending-note';
        note.setAttribute('role', 'status');
        form.append(note);
      }
      note.textContent = pending;
    });
  });
  // Al volver atrás, el navegador restaura la página tal cual: sin botones ocupados
  window.addEventListener('pageshow', () => {
    document.querySelectorAll<HTMLButtonElement>('button[aria-busy=true]').forEach((b) => {
      b.disabled = false;
      b.removeAttribute('aria-busy');
    });
    document.querySelectorAll('.pending-note').forEach((n) => n.remove());
  });
  // Vuelta con error: se recupera el fit pegado; con éxito, se olvida
  const params = new URLSearchParams(location.search);
  const at = params.get('at') ?? '';
  try {
    if (params.get('error') && at.startsWith('doctrina-')) {
      const area = document.querySelector<HTMLTextAreaElement>(`#eft-${at.slice(9)}`);
      const saved = sessionStorage.getItem(`eft-${at.slice(9)}`);
      if (area && saved && !area.value) area.value = saved;
    } else if (params.get('ok') === 'fit') {
      for (const k of Object.keys(sessionStorage)) if (k.startsWith('eft-')) sessionStorage.removeItem(k);
    }
  } catch {}
  // El aviso del resultado recibe el foco: el lector de pantalla lo anuncia y queda a la vista. Tras la carga: el
  // salto al ancla (#fit-3) le quitaba el foco si se ponía antes
  const focusNotice = () => setTimeout(() => document.querySelector<HTMLElement>('.action-notice')?.focus({ preventScroll: !!location.hash }));
  if (document.readyState === 'complete') focusNotice();
  else window.addEventListener('load', focusNotice, { once: true });
</script>

