                          </div>
                        )}
                      </dl>
                    </li>
                  ))
                }
                {/* The sum of the pilots: the consolidated total */}
                <li class="total">
                  <div class="card-head">
                    <span class="who">{totalLabel}</span>
                  </div>
                  <dl>
                    <div>
                      <dt>{m.income}</dt>
                      <dd title={full(pilotTotals.income)}>{fmt(pilotTotals.income)}</dd>
                    </div>
                    <div>
                      <dt>{m.expenses}</dt>
                      <dd title={full(out(pilotTotals.expenses))}>{fmt(out(pilotTotals.expenses))}</dd>
                    </div>
                    <div class:list={['net', { pos: pilotTotals.net > 0, neg: pilotTotals.net < 0 }]}>
                      <dt>{m.net}</dt>
                      <dd title={fullNet(pilotTotals.net)}>{fmt(pilotTotals.net, { sign: true })}</dd>
                    </div>
                    <div class="minor">
                      <dt>{m.betweenPilots}</dt>
                      <dd>{betweenText(pilotTotals.between)}</dd>
                    </div>
                    <div class="minor">
                      <dt>{m.openingBalance}</dt>
                      <dd>{fmt(pilotTotals.opening)}</dd>
                    </div>
                    <div class="minor">
                      <dt>{m.balance}</dt>
                      <dd>{fmt(pilotTotals.balance)}</dd>
                    </div>
                    {withInv && (
                      <div class="minor">
                        <dt>{m.inventory}</dt>
                        <dd>{pilotTotals.inventory ? fmt(pilotTotals.inventory) : '—'}</dd>
                      </div>
                    )}
                  </dl>
                </li>
              </ul>
              <script>
                // Sort the pilots table (and the mobile cards, which carry the same data-*) by a column.
                // Click the header: highest to lowest (name, A to Z), another click reverses, the third
                // restores the original order. No data («—») always last. The Total row doesn't move
                const panel = document.querySelector<HTMLElement>('[data-pilots-panel]');
                const tbody = panel?.querySelector<HTMLTableSectionElement>('table.pilots tbody');
                const cards = panel?.querySelector<HTMLElement>('.pilot-cards');
                if (panel && tbody && cards) {
                  const rows = [...tbody.rows];
                  const items = [...cards.querySelectorAll<HTMLElement>(':scope > li:not(.total)')];
                  const totalCard = cards.querySelector<HTMLElement>(':scope > li.total');
                  const heads = [...panel.querySelectorAll<HTMLTableCellElement>('th[aria-sort]')];
                  const select = panel.querySelector<HTMLSelectElement>('select[data-sort-select]');
                  const value = (el: HTMLElement, key: string): string | number | null => {
                    const v = el.dataset[key];
                    if (v === undefined || v === '') return null;
                    return key === 'name' ? v : Number(v);
                  };
                  const apply = (key: string, dir: 'asc' | 'desc') => {
                    const idx = rows.map((_, i) => i);
                    if (key) {
                      idx.sort((a, b) => {
                        const va = value(rows[a], key);
                        const vb = value(rows[b], key);
                        if (va === null && vb === null) return a - b;
                        if (va === null) return 1;
                        if (vb === null) return -1;
                        const c = typeof va === 'string' ? va.localeCompare(String(vb), undefined, { sensitivity: 'base' }) : va - Number(vb);
                        return (c || a - b) * (dir === 'desc' ? -1 : 1);
                      });
                    }
                    for (const i of idx) {
                      tbody.append(rows[i]);
                      if (items[i]) cards.append(items[i]);
                    }
                    if (totalCard) cards.append(totalCard);
                    for (const th of heads) {
                      const k = th.querySelector<HTMLElement>('[data-sort]')?.dataset.sort;
                      th.setAttribute('aria-sort', k && k === key ? (dir === 'desc' ? 'descending' : 'ascending') : 'none');
                    }
                    if (select) select.value = key;
                  };
                  const first = (key: string) => (key === 'name' ? 'asc' : 'desc');
                  for (const th of heads) {
                    const btn = th.querySelector<HTMLButtonElement>('[data-sort]');
                    btn?.addEventListener('click', () => {
                      const key = btn.dataset.sort ?? '';
                      const cur = th.getAttribute('aria-sort');
                      if (cur === 'none') apply(key, first(key));
                      else if ((cur === 'descending') === (first(key) === 'desc')) apply(key, first(key) === 'desc' ? 'asc' : 'desc');
                      else apply('', 'asc');
                    });
                  }
                  select?.addEventListener('change', () => apply(select.value, first(select.value)));
                }
              </script>
              {/* Short notes that reconcile and give coverage: what the Total is (in a pilot's view, that it's the consolidated
                  total), the wallet equation and where balance and inventory come from. The definitions («Neto = ingresos −
                  gastos…») are gone: the user knows them, and the column titles carry them */}
              <div class="panel-note pilots-note">
                <p>
                  {selected && !pilotEmpty ? (
                    m.pilotsTotalNotePilot(selected.name)
                  ) : (
                    <>
                      <span class="wide-only">{m.pilotsTotalNote(false)}</span>
                      <span class="narrow-only">{m.pilotsTotalNote(true)}</span>
                    </>
                  )}
