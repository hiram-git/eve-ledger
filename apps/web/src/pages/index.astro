                      <td class="between" title={fullNet(pilotTotals.between)}>{betweenText(pilotTotals.between)}</td>
                      <td class="now-start" title={full(pilotTotals.balance)}>{fmt(pilotTotals.balance)}</td>
                      {withInv && <td title={full(pilotTotals.inventory)}>{pilotTotals.inventory ? fmt(pilotTotals.inventory) : '—'}</td>}
                      <td />
