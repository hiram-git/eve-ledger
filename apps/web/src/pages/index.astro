                  </thead>
                  <tbody>
                    {summary.characters.map((c, i) => (
                      <tr class:list={{ selected: c.id === pilotId && !pilotEmpty }} aria-current={c.id === pilotId ? 'true' : undefined} {...rowData(c)}>
                        <td>
                          <span class="who">
