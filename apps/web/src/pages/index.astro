---
import { PILOT_SLOTS } from 'astro:env/server';
import Base from '../layouts/Base.astro';
import FirstRun from '../components/FirstRun.astro';
import FirstSync from '../components/FirstSync.astro';
import DailyChart from '../components/DailyChart.astro';
import Icon from '../components/Icon.astro';
import NewEdenMap from '../components/NewEdenMap.astro';
import MarketItems from '../components/MarketItems.astro';
import MarketReview from '../components/MarketReview.astro';
import ActivityList from '../components/ActivityList.astro';
import BarList, { type BarRow } from '../components/BarList.astro';
import CoverageNote from '../components/CoverageNote.astro';
import ShipLosses from '../components/ShipLosses.astro';
import Donut from '../components/Donut.astro';
import { fold } from '../lib/shares';
import {
  ApiError,
  getIndicators,
  getInventory,
  getLosses,
  getMap,
  getPilots,
  getSummary,
  getSyncStatus,
  loginUrl,
  syncLogUrl,
  type GeoMap,
  type Indicators,
  type Inventory,
  type Losses,
  type Pilot,
  type Summary,
  type SyncStatus,
} from '../lib/api';
import { ago, isk, iskFull, longDate, refTypeLabel, shortDate } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { withInventory } from '../lib/inventory-pref';
import { ASSETS_SCOPE, CONTRACTS_SCOPE, SKILLS_SCOPE, LOSSES_SCOPE, hasIssue, pilotState } from '../lib/pilot-state';

const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
// Full nets with their sign (+), like the abbreviated figure
const fullNet = (v: number) => iskFull(v, lang, true);
const date = (iso: string) => shortDate(iso, lang);
const rel = (iso: string | null) => ago(iso, lang);

const PERIODS = [7, 30, 90];
const q = Astro.url.searchParams;
const days = PERIODS.includes(Number(q.get('days'))) ? Number(q.get('days')) : 30;
// ?pilot=ID: the ledger of a single pilot
const pilotParam = Number(q.get('pilot'));
const pilotId = Number.isSafeInteger(pilotParam) && pilotParam > 0 ? pilotParam : undefined;
// Net worth with wallets only (default) or + inventory: the choice lives in a cookie (/inv);
// ?inv=1 / ?inv=0 in the URL wins for that view and links keep it
const invPref = withInventory(Astro);
const withInv = invPref.on;
const href = (d: number, pilot?: number, keepInv = true) =>
  `/?days=${d}${pilot ? `&pilot=${pilot}` : ''}${keepInv && invPref.override ? `&inv=${invPref.override}` : ''}`;
// The toggle returns to this same view, without the ?inv= that would pin the previous choice
const invBack = href(days, pilotId, false);

let summary: Summary | undefined;
let status: SyncStatus | undefined;
let inventory: Inventory | undefined;
let geo: GeoMap | undefined;
let pilotList: Pilot[] | undefined;
let indicators: Indicators | undefined;
let losses: Losses | undefined;
let apiError: string | undefined;
try {
  // Inventory and map are optional: if they fail, the rest of the dashboard still shows
  const optional = <T,>(p: Promise<T>) => p.catch((err) => (console.error(err), undefined));
  [summary, status, inventory, geo, pilotList, indicators, losses] = await Promise.all([
    getSummary(days, pilotId),
    getSyncStatus(),
    // Without inventory, neither the inventory nor the map (which draws it) is requested
    withInv ? optional(getInventory(pilotId)) : undefined,
    optional(getMap(pilotId)),
    optional(getPilots()),
    // The Omega line under the balance: only in the consolidated view (it's a goal for all accounts)
    pilotId ? undefined : optional(getIndicators()),
    // Lost ships (killmails): optional, like the inventory
    optional(getLosses(days, pilotId)),
  ]);
} catch (err) {
  // A pilot that is no longer linked (old link): go back to the consolidated view
  if (pilotId && err instanceof ApiError && err.status === 404) return Astro.redirect(href(days));
  apiError = err instanceof Error ? err.message : String(err);
}
const selected = pilotId ? summary?.characters.find((c) => c.id === pilotId) : undefined;
// First run: no pilots, or pilots but no entries stored yet (first sync)
const noPilots = !!summary && summary.characters.length === 0;
const waiting = !!summary && summary.characters.length > 0 && !pilotId && !summary.coverage.firstEntryAt;
const dashboard = !!summary && summary.characters.length > 0 && !waiting;
// The pilot strip shows each wallet's balance (user's decision, 0.1.19: the period net is already in the Net card
// and in the pilots table); «Todos» is the sum of the balances, what Net worth calls «Saldo de los wallets».
// chipBalance: the balance of the last sync (null: no sync yet, the chip shows «—»)
const allBalance = summary?.characters.reduce((n, c) => n + (c.balance ?? 0), 0) ?? 0;
const chipBalance = (c: Summary['characters'][number]) => (c.lastSyncAt && c.balance !== null ? c.balance : null);

const synced = q.get('synced');
const syncErrors = q.get('syncErrors');
const syncFailed = q.get('syncFailed');

// Consolidated net worth and proportions for the breakdown bars
const inventoryValue = inventory && inventory.stacks > 0 ? inventory.value : 0;
// Without inventory, the figure is just the wallet balance
const netWorth = (summary?.balance ?? 0) + (withInv ? inventoryValue : 0);
const share = (part: number, total: number) => (total > 0 ? Math.max(0, Math.min(1, part / total)) : 0);
const flowTotal = (summary?.totals.income ?? 0) + (summary?.totals.expenses ?? 0);

// Most recent sync across all characters: drives the global stale-data warning
const globalLastSync = summary?.characters
  .map((c) => c.lastSyncAt)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);
// Card freshness: in a pilot's view, that pilot's (not the most recent of all)
const lastSync = selected ? (selected.lastSyncAt ?? undefined) : globalLastSync;

// Age: data is «stale» when older than two sync intervals (or 2 h if the cron is off)
const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const isStale = (iso: string | null | undefined) => !iso || Date.now() - new Date(iso).getTime() > staleAfterMs;
// Pilots that need attention: the same state as in /pilotos (error, first sync or stale data),
// with their short cause and the action to take, in a line under the filter
const pilotStates = new Map((pilotList ?? []).map((p) => [p.id, pilotState(p, m, staleAfterMs, status?.running)]));
const pilotById = new Map((pilotList ?? []).map((p) => [p.id, p]));
// The health line is the only place with cause and action: broken or stale sync, no first sync, or missing permission
const needsAttention = (c: { id: number; lastSyncAt: string | null }) => {
  const st = pilotStates.get(c.id);
  const p = pilotById.get(c.id);
  return st && p ? hasIssue(p, st) : isStale(c.lastSyncAt);
};
type HealthAction = 'relink' | 'sync' | 'review' | null;
// Permissions a pilot is missing, with their short name («inventario», «killmails», «contratos»)
const PERM_LABELS: Record<string, string> = {
  [ASSETS_SCOPE]: m.permAssets,
  [LOSSES_SCOPE]: m.permKillmails,
  [CONTRACTS_SCOPE]: m.permContracts,
  [SKILLS_SCOPE]: m.permSkills,
};
const missingPerms = (id: number) => (pilotById.get(id)?.missingScopes ?? []).map((s) => PERM_LABELS[s]).filter(Boolean);
const healthItems =
  summary?.characters.filter(needsAttention).map((c): { id: number; name: string; cause: string; action: HealthAction } => {
    const st = pilotStates.get(c.id);
    if (!st) return { id: c.id, name: c.name, cause: m.healthStale(c.lastSyncAt ? rel(c.lastSyncAt) : m.never), action: 'sync' };
    if (st.kind === 'pending') return { id: c.id, name: c.name, cause: m.healthPending, action: null };
    if (st.kind === 'error') {
      const token = st.hint === m.errToken;
      const kinds: Record<string, string> = {
        journal: m.kindJournal,
        transactions: m.kindTransactions,
        assets: m.kindAssets,
        killmails: m.kindKillmails,
        contracts: m.kindContracts,
      };
      const raw = pilotById.get(c.id)?.lastError?.kind ?? '';
      return { id: c.id, name: c.name, cause: token ? m.healthToken : m.healthFailed(kinds[raw] ?? raw), action: token ? 'relink' : 'review' };
    }
    // Sync up to date, but some permission is missing (inventory, killmails, contracts): fixed by relinking
    const perms = missingPerms(c.id);
    if (st.kind === 'ok') return { id: c.id, name: c.name, cause: m.healthMissing(perms), action: 'relink' };
    // No first sync and some permission missing: relinking grants the permissions and starts the first sync
    if (!c.lastSyncAt && perms.length) return { id: c.id, name: c.name, cause: `${m.healthNoFirst} · ${m.healthMissing(perms)}`, action: 'relink' };
    return { id: c.id, name: c.name, cause: c.lastSyncAt ? m.healthStale(rel(c.lastSyncAt)) : m.healthNoFirst, action: 'sync' };
  }) ?? [];
// Pilots with an up-to-date sync (a missing permission doesn't count here: it doesn't make the data stale)
const freshCount =
  summary?.characters.filter((c) => {
    const st = pilotStates.get(c.id);
    return st ? st.kind === 'ok' : !isStale(c.lastSyncAt);
  }).length ?? 0;
// State of the filtered pilot: if broken or stale, the whole Net card says so
const selectedState = selected ? pilotStates.get(selected.id) : undefined;
const selectedBroken = !!selectedState && selectedState.kind !== 'ok';
// Filtered pilot with no sync at all: there's no data, and a «0 ISK» would read as data. Its own empty state
const pilotEmpty = !!selected && !selected.lastSyncAt;
// Its action is already in the empty state: the health line doesn't repeat it
const healthVisible = pilotEmpty ? healthItems.filter((h) => h.id !== selected!.id) : healthItems;
// Pilots with the same cause and action share one line («6 pilotos: falló el sync de wallet → Revisar» instead of six
// identical lines; a grouped «Sincronizar» syncs every pilot, like the header button). Relink keeps one line per pilot:
// its login hint names them one by one
type HealthLine = (typeof healthItems)[number] & { names: string[] };
const healthShown = healthVisible.reduce<HealthLine[]>((lines, h) => {
  const line = h.action === 'review' || h.action === 'sync' ? lines.find((l) => l.cause === h.cause && l.action === h.action) : undefined;
  if (line) line.names.push(h.name);
  else lines.push({ ...h, names: [h.name] });
  return lines;
}, []);
// Consolidated: how much of the net comes from pilots with stale or broken data. A single line that quantifies
// (the net doesn't change color; who and why is in the health line)
const staleNetPilots = !selected
  ? (summary?.characters ?? []).filter((c) => c.lastSyncAt && c.net !== 0 && pilotStates.get(c.id) && pilotStates.get(c.id)!.kind !== 'ok')
  : [];
// Each pilot's net already excludes what was moved with your other pilots: that doesn't leave the consolidated total, it only changes wallet
const staleNet = staleNetPilots.reduce((n, c) => n + c.net, 0);
const staleNetOldest = staleNetPilots.map((c) => c.lastSyncAt!).sort()[0];
// «hace 3 d» (3 d ago) doesn't break across two lines
const nbsp = (text: string) => text.replace(/ /g, '\u00a0');
// View of a pilot with a stuck sync: «Hoy» (Today) isn't zero, it's unknown; the chart ends at their last sync
const todayUnknown =
  !!selected && selectedBroken && !!selected.lastSyncAt && selected.lastSyncAt.slice(0, 10) < new Date().toISOString().slice(0, 10);
const chartLastDate = selected && selectedBroken && selected.lastSyncAt ? selected.lastSyncAt.slice(0, 10) : null;
// Market review reconciliation: what the wallet says. Sales are market_transaction; purchases,
// market_escrow (that's how ESI books them for the buyer; negative market_transaction in older data) plus the
// replacement of lost ships, which is in PvP but is also market purchases
// (and PLEX, which goes in «PLEX / cuentas» but is also bought and sold on the market)
const marketRefs = (summary?.byActivity ?? [])
  .filter((a) => a.activity === 'trading' || a.activity === 'accounts')
  .flatMap((a) => a.refTypes)
  .filter((r) => r.refType === 'market_transaction' || r.refType === 'market_escrow');
const walletMarket = summary
  ? {
      sold: marketRefs.reduce((n, r) => n + r.income, 0),
      bought: marketRefs.reduce((n, r) => n + r.expenses, 0) + summary.shipFlow.replacement,
    }
  : undefined;
// «Todos» (All) at the start of the strip: stays fixed on mobile while the row scrolls
const firstHistory = summary?.coverage.firstEntryAt ? date(summary.coverage.firstEntryAt) : null;
// The map leads the first screen only when there's something to tell today (ISK earned in some system);
// otherwise it moves down next to the inventory and Net worth becomes a compact strip
const showMap = withInv && !!geo && geo.nodes.some((n) => n.earnedToday > 0);
const mapBelow = withInv && !!geo && !showMap && geo.nodes.length > 0;
// Where you earned today, whatever the inventory preference (user's decision after a UI review: the only
// datum with motion disappeared with «Wallets»): with wallets only, a mini-map of today's systems in the «Hoy» column;
// with «+ inventario» the Net worth card carries the full map
const todayMap = !withInv && !!geo && geo.nodes.some((n) => n.earnedToday > 0) ? geo : undefined;
// Age of the inventory prices, as freshness: they refresh during a sync if older than 1 h
const pricesOld =
  !!inventory?.pricesUpdatedAt && Date.now() - new Date(inventory.pricesUpdatedAt).getTime() > staleAfterMs + 3_600_000;
// Most valuable values PLEX at the ESI average; Indicators, at its lowest sell order: if it shows up, say so
const PLEX_TYPE_ID = 44992;
// Ships lost today (EVE day): «Hoy» (Today) says so, that's when the bill matters most
const todayIso = new Date().toISOString().slice(0, 10);
const lostTodayList = losses?.losses.filter((l) => l.time.slice(0, 10) === todayIso) ?? [];
// Omega for all accounts, with the same calculation as Indicators (wallet balance + stored PLEX)
const omega = !pilotId && pilotList?.length ? indicators?.omega : undefined;
const firstDate = summary?.coverage.firstEntryAt?.slice(0, 10) ?? null;
const partialHistory = summary && summary.coverage.firstEntryAt && summary.coverage.coveredDays < days;

// Sign of the net as semantic state (green/red + arrow), not decoration
// Pilot initials for the portrait placeholder («Aria Vex» → «AV»)
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join('');
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
// Game result: the wallet net without PLEX (the cost of the accounts, kept apart: user's decision) and
// minus the value of lost ships that didn't come back (window closed) or is still to be replaced (estimated).
// Replacement, courier and insurance are already in the net (PvP)
const notBack = losses?.totals.unreplaced ?? 0;
const toReplace = losses?.totals.toReplace ?? 0;
const accountsNet = summary?.byActivity.find((a) => a.activity === 'accounts')?.net ?? 0;
const hasAccounts = Math.abs(accountsNet) >= 0.5;
const showResult = !!summary && ((!!losses && notBack + toReplace >= 0.5) || hasAccounts);
const headline = summary ? summary.totals.net - (showResult ? accountsNet + notBack + toReplace : 0) : 0;
// The previous period's result takes out the same things, so the comparison is of the headline figure (before it
// compared the wallet net under a «Resultado» headline: the green figure and the red arrow spoke of different numbers)
const previousHeadline = summary
  ? summary.previous.net - (showResult ? summary.previous.accounts + summary.previous.lossesNotBack + summary.previous.lossesToReplace : 0)
  : 0;
const delta = summary && summary.previous.complete ? headline - previousHeadline : undefined;
// The card's activities are gameplay ones: PLEX goes on its own line at the foot
const cardActivities = summary?.byActivity.filter((a) => a.activity !== 'accounts') ?? [];
// Moved with your other pilots: not in any net. In a pilot's view, in both directions (what they received
// and what they sent) and how much their wallet changed with it, which is what they see in game
const internalNote = !summary
  ? null
  : selected
    ? summary.internalReceived || summary.internalSent
      ? m.internalPilotBoth(
          summary.internalReceived ? fmt(summary.internalReceived) : null,
          summary.internalSent ? fmt(summary.internalSent) : null,
          fmt(selected.walletChange, { sign: true }),
        )
      : null
    : summary.internalTransfers > 0
      ? m.internal(fmt(summary.internalTransfers))
      : null;
// Card footer: lost ships (the firm part with its sign, the estimate in gray). In the consolidated view, how much of the
// firm part is already in the net (PvP); not in a pilot's view, because someone else may have paid to replace their ships
const lossesFirm = losses?.totals.firmCost ?? 0;
const lossesInNet = !selected && losses ? losses.totals.walletEffect : 0;
const lossesOnlyEstimate = Math.abs(lossesFirm) < 0.5 && toReplace >= 0.5;

// Net with partial coverage: the title says so (90 days requested, 42 with history)
const coverageNote = partialHistory && summary ? ` (${m.onlyCovered(summary.coverage.coveredDays)})` : '';
// Breakdown by activity on the Net card (fixed API order: PvE, PvP, Trading, Other)
const actMax = Math.max(1, ...cardActivities.map((a) => Math.abs(a.net)));
const actBar = (v: number) => (v >= 0 ? `left:50%;width:${(v / actMax) * 50}%` : `right:50%;width:${(-v / actMax) * 50}%`);
const out = (v: number) => (v ? -v : 0);
// Units («3.840 PLEX») in the language's format
const count = (n: number) => new Intl.NumberFormat(lang).format(n);
// If one entry type is nearly all of the activity (donations in Other), the detail names it
const mainRef = (a: NonNullable<typeof summary>['byActivity'][number]) => {
  const top = a.refTypes[0];
  return top && a.refTypes.length > 1 && Math.abs(top.net) >= 0.6 * (a.income + a.expenses)
    ? ` · ${m.mainlyRef(refTypeLabel(top.refType, lang), fmt(top.net, { sign: true }))}`
    : '';
};

// Actual period range in EVE time, for the navigation subtitle
const range = summary ? `${date(summary.period.from)} – ${date(summary.period.to)}` : undefined;

// Player structures have no name without the structures scope
const locationLabel = (id: number, name: string | null) =>
  name ?? (id > 1_000_000_000_000 ? m.structure(id) : `#${id}`);
// "Jita IV - Moon 4 - Caldari Navy Assembly Plant" → "Jita IV - Moon 4" (the full name goes in the tooltip)
const shortStation = (name: string) => name.split(' - ').slice(0, 2).join(' - ');
// Locations in space (root = a system, not a station): plain «Amarr» was confused with the station
const inSpaceRange = (id: number) => id >= 30_000_000 && id <= 32_999_999;
const locationRows: BarRow[] =
  inventory?.byLocation.map((l) => {
    const full = locationLabel(l.locationId, l.name);
    const label = inSpaceRange(l.locationId) ? `${shortStation(full)} (${m.inSpace})` : shortStation(full);
    // Unnamed structures show a shortened ID: the full one goes in the detail
    const id = l.name ? '' : ` (#${l.locationId})`;
    return { label, value: l.value, detail: `${full}${id} · ${m.stacks(l.stacks)}` };
  }) ?? [];
// Most valuable: the top 6 (8 if the map shares the adjacent column); the full detail is in GET /assets
const valuableItems = inventory?.topItems.slice(0, mapBelow ? 8 : 6).map((i) => ({ ...i, isk: i.value })) ?? [];
const inventoryByChar = new Map(inventory?.byCharacter.map((c) => [c.characterId, c.value]));
// Total row of the pilots table: the sum of the pilots, which is the summary's consolidated total (the API excludes
// transfers between your pilots in each pilot too, so income, expenses and net add up exactly).
// Summed from `characters`, which comes complete in a pilot's view too
const pilotTotals = (summary?.characters ?? []).reduce(
  (t, c) => ({
    balance: t.balance + (c.balance ?? 0),
    inventory: t.inventory + (inventoryByChar.get(c.id) ?? 0),
    income: t.income + c.income,
    expenses: t.expenses + c.expenses,
    net: t.net + c.net,
    between: t.between + c.internalReceived - c.internalSent,
    opening: t.opening + (c.openingBalance ?? 0),
  }),
  { balance: 0, inventory: 0, income: 0, expenses: 0, net: 0, between: 0, opening: 0 },
);
// Between your pilots (received − sent): not net (not earned in game), but it changes the wallet; 0 in the Total
const between = (c: { internalReceived: number; internalSent: number }) => c.internalReceived - c.internalSent;
const betweenText = (v: number) => (Math.abs(v) < 0.5 ? '0' : fmt(v, { sign: true }));
// Opening balance + net + between your pilots = balance; if it doesn't match (entries ESI no longer returned at the
// first sync), the note says so
// (with the journal balance: the real wallet may include entries the journal doesn't return yet)
const gapOf = (c: { openingBalance: number | null; journalBalance: number | null; walletChange: number }) =>
  c.openingBalance === null || c.journalBalance === null ? 0 : c.journalBalance - c.openingBalance - c.walletChange;
const reconcileGaps = (summary?.characters ?? []).filter((c) => c.lastSyncAt && Math.abs(gapOf(c)) >= 1);
// The table's balance is the real one from ESI; if it's ahead of the journal (which arrives up to 1 h late), the
// note says by how much, so the row's arithmetic makes sense
const pendingOf = (c: { balance: number | null; journalBalance: number | null }) =>
  c.balance === null || c.journalBalance === null ? 0 : c.balance - c.journalBalance;
const reconcilePending = (summary?.characters ?? []).filter((c) => Math.abs(pendingOf(c)) >= 1);
// In a pilot's view the Total row is still the consolidated total: the label says so
const withData = (summary?.characters ?? []).filter((c) => c.lastSyncAt).length;
const totalLabel = selected ? m.pilotsTotalAll : m.pilotsTotal(summary?.characters.length ?? 0, withData);
// Pies of the pilots table: who the income comes from and who spends (gross, without what's moved between pilots).
// The color follows the pilot (their position in the list), also in their row's swatch; with more than 7, «Otros»
const pilotRows = summary?.characters ?? [];
const pilotColor = (i: number) => `var(--cat-${(pilotRows.length <= 7 ? i : Math.min(i, 6)) + 1})`;
const pilotIncomeSlices = fold(pilotRows.map((c) => ({ label: c.name, value: c.lastSyncAt ? c.income : 0 })), m.otherPilots);
const pilotExpensesSlices = fold(pilotRows.map((c) => ({ label: c.name, value: c.lastSyncAt ? c.expenses : 0 })), m.otherPilots);
// Columns that sort the table (and the cards on mobile): the data-* key of each row and its label
const sortCols = [
  { key: 'name', label: m.pilot, cls: '' },
  { key: 'opening', label: m.openingBalance, cls: 'opening' },
  { key: 'income', label: m.income, cls: '' },
  { key: 'expenses', label: m.expenses, cls: '' },
  { key: 'net', label: m.net, cls: '' },
  { key: 'between', label: m.betweenPilots, cls: '' },
  { key: 'balance', label: m.balance, cls: 'now-start' },
  ...(withInv ? [{ key: 'inventory', label: m.inventory, cls: '' }] : []),
  { key: 'sync', label: m.lastSync, cls: '' },
];
const rowData = (c: (typeof pilotRows)[number]) => ({
  'data-name': c.name,
  'data-opening': c.openingBalance ?? '',
  'data-income': c.lastSyncAt ? c.income : '',
  'data-expenses': c.lastSyncAt ? -c.expenses : '',
  'data-between': c.lastSyncAt ? between(c) : '',
  'data-net': c.lastSyncAt ? c.net : '',
  'data-balance': c.balance ?? '',
  'data-inventory': inventoryByChar.get(c.id) ?? '',
  'data-sync': c.lastSyncAt ? new Date(c.lastSyncAt).getTime() : '',
});
// What each pilot contributes to Net worth (balance + inventory): the coverage note says how much is stale
const worthByPilot: Record<number, number> = Object.fromEntries(
  (summary?.characters ?? []).map((c) => [c.id, (c.balance ?? 0) + (inventoryByChar.get(c.id) ?? 0)]),
);
// View of a pilot that isn't up to date (or lacks the inventory permission): how old their balance and inventory are
const selectedPilot = selected ? pilotById.get(selected.id) : undefined;
const selectedNoAssets = !!selectedPilot?.missingScopes.includes(ASSETS_SCOPE);
const selectedInvAt = selected ? inventory?.byCharacter.find((c) => c.characterId === selected.id)?.updatedAt : undefined;
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const worthNote =
  selected && selected.lastSyncAt && (selectedBroken || selectedNoAssets)
    ? capitalize(
        [
          selectedBroken ? m.worthStaleBalance(rel(selected.lastSyncAt)) : null,
          !withInv
            ? null
            : selectedInvAt
            ? m.worthStaleInventory(rel(selectedInvAt)) + (selectedNoAssets ? ` (${m.scopeMissingShort})` : '')
            : selectedNoAssets
              ? m.coverNoInventory(selected.name)
              : null,
        ]
          .filter(Boolean)
          .join(' · '),
      )
    : '';
---

<Base
  section="resumen"
  status={status}
  pilots={summary?.characters.length}
  pilotIssues={(pilotList ?? []).filter((p) => hasIssue(p, pilotStates.get(p.id)!)).length}
>
    {dashboard && (
    <nav class="main-nav shell" aria-label={m.period} slot="nav">
      <div class="nav-tabs">
        {
          PERIODS.map((p) => (
            <a class="nav-tab" href={href(p, pilotId)} aria-current={p === days ? 'true' : undefined}>
              {m.days(p)}
            </a>
          ))
        }
      </div>
      <p class="period-meta">
        {range && <span>{range} · {m.eveTime}</span>}
        {
          partialHistory && (
            <span class="coverage" title={m.coverageTitle}>
              <Icon name="info" />
              {m.coverage(date(summary!.coverage.firstEntryAt!), summary!.coverage.coveredDays, days)}
            </span>
          )
        }
      </p>
    </nav>
    )}

      <h1 class="sr-only">{selected ? m.summaryH1Pilot(selected.name, days) : m.summaryH1(days)}</h1>

      {
        synced !== null && (
          <div class="notice">
            <Icon name="info" />
            <p>
              {m.syncDone(synced)}
              {syncErrors && (
                <strong>
                  {' '}
                  · {m.syncErrors(Number(syncErrors))} <a href={syncLogUrl}>{m.syncLog}</a>
                </strong>
              )}
            </p>
          </div>
        )
      }
      {
        /* Global warning: only when the whole ledger is stale; a broken pilot is explained by its own card */
        dashboard && isStale(globalLastSync) && (
          <div class="notice warning" role="status">
            <Icon name="alert" />
            <p>
              <strong>{m.staleTitle}</strong> {m.staleLast(rel(globalLastSync ?? null))}{' '}
              {status && !status.enabled ? m.staleCronOff : m.staleCronFailed} {m.staleAction}{' '}
              <a href={syncLogUrl}>{m.syncLog}</a>.
            </p>
          </div>
        )
      }
      {
        syncFailed && (
          <div class="notice error">
            <Icon name="alert" />
            <p>{m.syncFailed} {syncFailed}</p>
          </div>
        )
      }

      {
        apiError && (
          <div class="notice error">
            <Icon name="alert" />
            <div>
              <strong>{m.apiDown}</strong>
              <p class="muted">{apiError}</p>
              <p>
                {m.apiRunning} <code>apps/api</code>: <code>bun run dev</code>
              </p>
            </div>
          </div>
        )
      }

      {
        noPilots && <FirstRun slots={PILOT_SLOTS} />
      }
      {
        waiting && <FirstSync pilots={summary!.characters} slots={PILOT_SLOTS} />
      }

      {
        dashboard && summary && (
          <>
            <nav class="pilot-strip" aria-label={m.filterByPilot}>
              <ul>
                <li>
                  <a
                    href={href(days)}
                    aria-current={!pilotId ? 'true' : undefined}
                    title={m.allPilotsTitle(full(allBalance))}
                    aria-label={m.chipLabel(m.allPilots, fmt(allBalance), null)}
                  >
                    <span class="pilot-name">{m.allPilots}</span>
                    <span class="pilot-balance">{fmt(allBalance)}</span>
                  </a>
                </li>
                {summary.characters.map((c) => {
                  const balance = chipBalance(c);
                  // The amber dot follows the health line (broken sync, no first sync, missing permission), not only the
                  // age of the data; the gray balance and the age stay for old data only
                  const issue = needsAttention(c);
                  return (
                    <li>
                      <a
                        href={href(days, c.id)}
                        aria-current={c.id === pilotId ? 'true' : undefined}
                        class:list={{ stale: isStale(c.lastSyncAt) }}
                        title={m.pilotBalanceTitle(c.name, balance === null ? null : full(balance)) + (isStale(c.lastSyncAt) ? m.noSyncSince(rel(c.lastSyncAt)) : '')}
                        aria-label={m.chipLabel(c.name, balance === null ? null : fmt(balance), isStale(c.lastSyncAt) ? rel(c.lastSyncAt) : null)}
                      >
                        {issue && <i class="stale-dot" aria-hidden="true" />}
                        <span class="pilot-name">{c.name}</span>
                        <span class="pilot-balance">{balance === null ? '—' : fmt(balance)}</span>
                        {isStale(c.lastSyncAt) && c.lastSyncAt && <span class="chip-age" aria-hidden="true">{rel(c.lastSyncAt)}</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>

            <script>
              // On mobile the row scrolls: keep the active pilot in view
              const strip = document.querySelector<HTMLElement>('.pilot-strip ul');
              const active = strip?.querySelector<HTMLElement>('[aria-current="true"]');
              const all = strip?.querySelector<HTMLElement>('li');
              if (strip && active && all && active.parentElement !== all && strip.scrollWidth > strip.clientWidth) {
                const want = active.parentElement!.offsetLeft - strip.offsetLeft - all.offsetWidth;
                const max = strip.scrollWidth - strip.clientWidth;
                // If the active chip is one of the last, the row can't scroll it next to «Todos» and the previous one
                // would peek half-hidden under «Todos» (reading «40 M» out of «1,40 B»): extend the end of the row
                if (want > max) strip.style.paddingRight = `${parseFloat(getComputedStyle(strip).paddingRight) + want - max}px`;
                strip.scrollLeft = want;
              }
            </script>

            {
              healthShown.length > 0 && (
                <div class="pilot-health" role="status">
                  <Icon name="alert" class="stale-icon" />
                  <ul class="health-full">
                    {healthShown.map((h) => (
                      <li>
                        <span class="health-name" title={h.names.length > 1 ? h.names.join(' · ') : undefined}>
                          {h.names.length > 1 ? m.healthPilots(h.names.length) : h.name}:
                        </span>{' '}
                        {h.cause}
                        {h.action === 'relink' && (
                          <>
                            {' → '}
                            <a class="inline-action" href={loginUrl} title={m.relinkAs(h.name)} aria-label={m.relinkAs(h.name)}>{m.relink}</a>
                          </>
                        )}
                        {h.action === 'review' && (
                          <>
                            {' → '}
                            <a class="inline-action" href="/pilotos" title={m.healthReviewOf(h.names.join(', '))} aria-label={m.healthReviewOf(h.names.join(', '))}>
                              {m.healthReview}
                            </a>
                          </>
                        )}
                        {h.action === 'sync' && (
                          <form method="post" action="/sync" class="sync-form inline">
                            <input type="hidden" name="back" value={href(days, pilotId)} />
                            {h.names.length === 1 && <input type="hidden" name="character" value={h.id} />}
                            {' → '}
                            <button type="submit" class="inline-action" title={h.names.length > 1 ? m.syncAllTitle : m.syncOneTitle(h.name)}>
                              {m.syncOne}
                            </button>
                          </form>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {pilotEmpty && selected && (
              <section class="panel empty-pilot" aria-labelledby="empty-pilot-title">
                <h2 id="empty-pilot-title">{m.emptyPilotTitle(selected.name)}</h2>
                <p>{selectedState?.kind === 'pending' ? m.emptyPilotPending : missingPerms(selected.id).length ? m.emptyPilotRelink : m.emptyPilotLead}</p>
                <div class="empty-actions">
                  {/* If a permission is also missing, relinking grants it and starts the first sync */}
                  {selectedState?.kind !== 'pending' && missingPerms(selected.id).length > 0 && (
                    <a class="secondary-button" href={loginUrl} title={m.relinkAs(selected.name)} aria-label={m.relinkAs(selected.name)}>
                      <Icon name="login" />
                      <span class="label">{m.relink}</span>
                    </a>
                  )}
                  {selectedState?.kind !== 'pending' && missingPerms(selected.id).length === 0 && (
                    <form method="post" action="/sync" class="sync-form">
                      <input type="hidden" name="back" value={href(days, pilotId)} />
                      <input type="hidden" name="character" value={selected.id} />
                      <button type="submit" class="secondary-button" title={m.syncOneTitle(selected.name)}>
                        <Icon name="refresh" />
                        <span class="label">{m.syncOne}</span>
                      </button>
                    </form>
                  )}
                  <a class="inline-action" href={href(days)}>{m.backToAll}</a>
                </div>
              </section>
            )}

            {!pilotEmpty && (
            <section class:list={['glance', { solo: !showMap }]} aria-labelledby="glance-title">
              <h2 id="glance-title" class="sr-only">{showResult ? m.result : m.net}{withInv && ` · ${m.netWorth}`}</h2>
              <div class:list={['panel', 'stat', 'hero-stat', { stale: selectedBroken }]}>
                <div class="hero-body">
                  <div class="headline">
                    <div class="fig">
                      <span class="label">
                        <Icon name="activity" />
                        {showResult
                          ? selected
                            ? m.resultPeriodPilot(selected.name, days)
                            : m.resultPeriod(days)
                          : selected
                            ? m.netPeriodPilot(selected.name, days)
                            : m.netPeriod(days)}
                        {coverageNote}
                      </span>
                      <span class:list={['value', 'signed', sign(headline)]} title={fullNet(headline)}>
                        {headline !== 0 && <Icon name={headline > 0 ? 'up' : 'down'} class="trend" />}
                        {fmt(headline, { sign: true })}
                        <small> ISK</small>
                        <span class="sr-only">{headline > 0 ? m.gain : headline < 0 ? m.loss : m.even} ({fullNet(headline)})</span>
                      </span>
                      {showResult && (
                        /* Where it comes from, as the equation Indicators uses (operator in its column, figures aligned):
                           the wallet net (what the activities, «Hoy» and the chart measure), the PLEX kept apart, the ships
                           that didn't come back and, in gray, the estimate. Before it was a four-term sentence on three lines */
                        <table class="equation hero-eq">
                          <caption class="sr-only">{m.resultBreakdown}</caption>
                          <tbody>
                            <tr>
                              <th scope="row">{selected ? m.resultWalletPilot : m.resultWallet}</th>
                              <td class="op" aria-hidden="true"></td>
                              <td title={fullNet(summary.totals.net)}>{fmt(summary.totals.net, { sign: true })}</td>
                            </tr>
                            {hasAccounts && (
                              /* The label says why the sign: PLEX bought left the wallet and comes back to the result
                                 (a UI review found that «PLEX (cuentas, aparte) + 4,09 B» read as paying more). The count and
                                 the Omega link, which were a second PLEX line at the card's foot with the opposite sign, go here */
                              <tr>
                                <th scope="row">
                                  {accountsNet < 0 ? m.resultAccountsBought : m.resultAccountsSold}
                                  <span class="row-meta">
                                    {[
                                      summary.accounts.plexBought ? m.plexBought(count(summary.accounts.plexBought)) : null,
                                      summary.accounts.plexSold ? m.plexSold(count(summary.accounts.plexSold)) : null,
                                    ]
                                      .filter(Boolean)
                                      .join(' · ')}
                                    {!selected && (
                                      <>
                                        {' · '}
                                        <a class="inline-action" href="/indicadores">{m.accountsOmegaLink}</a>
                                      </>
                                    )}
                                  </span>
                                </th>
                                <td class="op">{accountsNet < 0 ? '+' : '−'}</td>
                                <td title={full(Math.abs(accountsNet))}>{fmt(Math.abs(accountsNet))}</td>
                              </tr>
                            )}
                            {notBack >= 0.5 && (
                              <tr>
                                <th scope="row">{m.resultNotBackRow}</th>
                                <td class="op">−</td>
                                <td title={full(notBack)}>{fmt(notBack)}</td>
                              </tr>
                            )}
                            {toReplace >= 0.5 && (
                              <tr class="estimate">
                                <th scope="row">{m.resultToReplaceRow}</th>
                                <td class="op">−</td>
                                <td title={full(toReplace)}>{`~\u2009${fmt(toReplace)}`}</td>
                              </tr>
                            )}
                            <tr class="total">
                              <th scope="row">{m.result}</th>
                              <td class="op">=</td>
                              <td title={fullNet(headline)}>{fmt(headline, { sign: true })}</td>
                            </tr>
                          </tbody>
                        </table>
                      )}
                      {
                        delta !== undefined ? (
                          <p class="versus compare">
                            {/* Of the headline figure: the previous period's result takes out the same things (PLEX, ships) */}
                            {delta === 0 ? (
                              m.versusSame(days)
                            ) : (
                              <span class:list={['delta', sign(delta)]}>
                                <Icon name={delta > 0 ? 'up' : 'down'} />
                                {delta > 0
                                  ? m.versusMore(fmt(delta), days, fmt(previousHeadline, { sign: true }))
                                  : m.versusLess(fmt(-delta), days, fmt(previousHeadline, { sign: true }))}
                              </span>
                            )}
                          </p>
                        ) : (
                          <p class="versus">{firstHistory ? m.noPreviousSince(firstHistory, days) : m.noPrevious(days)}</p>
                        )
                      }
                      {staleNet !== 0 && staleNetOldest && (
                        <p
                          class="versus stale-share"
                          title={staleNetPilots.map((c) => `${c.name}: ${fmt(c.net, { sign: true })} (${rel(c.lastSyncAt)})`).join(' · ')}
                        >
                          <Icon name="alert" class="stale-icon" />
                          {Math.abs(staleNet - summary.totals.net) < 0.5
                            ? m.netStaleAll(nbsp(rel(staleNetOldest)))
                            : m.netStaleShare(fmt(staleNet, { sign: true }), nbsp(rel(staleNetOldest)))}
                        </p>
                      )}
                    </div>
                    <div class="fig today" title={todayUnknown ? m.todayNoData : m.todayTitle(fullNet(summary.today.net))}>
                      <span class="label">
                        <Icon name="clock" />
                        {m.today}
                        {/* The figure is announced by its value; here only since when (or that there's no data: the «—» is hidden) */}
                        <span class="sr-only"> · {todayUnknown ? m.todayNoData : m.todaySince}</span>
                      </span>
                      {todayUnknown && !summary.today.income && !summary.today.expenses ? (
                        /* No data for today (stuck sync): a «0» would read as «nothing happened today» */
                        <span class="value signed zero" aria-hidden="true">—</span>
                      ) : (
                        <span class:list={['value', 'signed', sign(summary.today.net)]}>
                          {summary.today.net !== 0 && <Icon name={summary.today.net > 0 ? 'up' : 'down'} class="trend" />}
                          {fmt(summary.today.net, { sign: true })}
                          <small> ISK</small>
                          <span class="sr-only">{summary.today.net > 0 ? m.gain : summary.today.net < 0 ? m.loss : m.even} ({fullNet(summary.today.net)})</span>
                        </span>
                      )}
                      <p class="versus">
                        {summary.today.income || summary.today.expenses
                          ? m.todayFlow(fmt(summary.today.income), fmt(summary.today.expenses))
                          : todayUnknown
                            ? m.todayNoData
                            : m.todayNone}
                      </p>
                      {/* Losing a ship doesn't move the wallet today, but that's when it matters most: which ship and its value
                          (no link: «Ver naves perdidas», at the card's foot, already leads to the panel) */}
                      {lostTodayList.length > 0 && (
                        <p class="versus today-lost">
                          {lostTodayList.length === 1
                            ? m.todayLostOne(lostTodayList[0].ship ?? '?', fmt(lostTodayList[0].value), lostTodayList[0].insurance > 0)
                            : m.todayLostMany(lostTodayList.length, fmt(lostTodayList.reduce((n, l) => n + l.value, 0)))}
                        </p>
                      )}
                      {
                        selected ? (
                          /* A single pilot: how old their data is. The cause and the action are in the health line */
                          lastSync && (
                            <p class:list={['versus', 'asof', { stale: selectedBroken }]}>
                              {selectedBroken && <Icon name="alert" class="stale-icon" />}
                              {selectedBroken ? m.asOfBroken('') : m.asOfSync('')}
                              <time datetime={lastSync} data-ago={lastSync}>{rel(lastSync)}</time>
                            </p>
                          )
                        ) : (
                          lastSync && (
                            /* Consolidated: how many pilots are up to date, in gray; amber only if the whole ledger is stale */
                            <p class:list={['versus', 'asof', { stale: isStale(lastSync) }]}>
                              {isStale(lastSync) && <Icon name="alert" class="stale-icon" />}
                              {freshCount < summary.characters.length
                                ? m.asOfPartial(freshCount, summary.characters.length, '')
                                : m.asOfSync('')}
                              <time datetime={lastSync} data-ago={lastSync}>{rel(lastSync)}</time>
                            </p>
                          )
                        )
                      }
                      {todayMap && (
                        /* Where you earned today: the systems with ISK today as a mini-map, whatever the inventory preference */
                        <NewEdenMap map={todayMap} mode="gains" width={260} height={120} />
                      )}
                    </div>
                  </div>
                  <div class="composition">
                    <div class="flow">
                      <div class="ratio" aria-hidden="true">
                        {summary.totals.income > 0 && (
                          <i class="income" style={`flex-grow:${share(summary.totals.income, flowTotal)}`} />
                        )}
                        {summary.totals.expenses > 0 && (
                          <i class="expenses" style={`flex-grow:${share(summary.totals.expenses, flowTotal)}`} />
                        )}
                      </div>
                      <dl class="breakdown">
                        <div>
                          <dt>
                            <i class="key income" />
                            {m.income}
                          </dt>
                          <dd title={full(summary.totals.income)}>{fmt(summary.totals.income)}</dd>
                        </div>
                        <div>
                          <dt>
                            <i class="key expenses" />
                            {m.expenses}
                          </dt>
                          <dd title={full(-summary.totals.expenses)}>{fmt(-summary.totals.expenses)}</dd>
                        </div>
                      </dl>
                      {/* At 520–879 px card width, the note goes here: otherwise a gap is left under Income/Expenses */}
                      {internalNote && <span class="sub in-flow">{internalNote}</span>}
                    </div>
                    {
                      cardActivities.length > 0 && (
                        <div class="acts-block">
                          <p class="acts-title">{m.byActivityPeriod(days)}</p>
                          <ul class="acts" aria-label={m.byActivity}>
                            {cardActivities.map((a) => (
                              /* The full detail goes in the bar's title (hidden from screen readers): the row is announced once */
                              <li>
                                <span class="act-name">{m.activityName[a.activity]}<span class="sr-only"> ({m.activityHint[a.activity]})</span></span>
                                <span
                                  class="act-bar"
                                  aria-hidden="true"
                                  title={`${m.activityHint[a.activity]} · ${m.activityInOut(full(a.income), full(out(a.expenses)))}${mainRef(a)}`}
                                >
                                  <i class:list={[sign(a.net)]} style={actBar(a.net)} />
                                </span>
                                <span class:list={['act-net', sign(a.net)]}>{fmt(a.net, { sign: true })}</span>
                              </li>
                            ))}
                          </ul>
                          <p class="acts-note">{m.actsNote}</p>
                          <a class="acts-link" href="#por-actividad">
                            {m.activityDetailLink}
                            <i class="chev" aria-hidden="true" />
                          </a>
                        </div>
                      )
                    }
                  </div>
                  <div class="hero-foot">
                    {losses && losses.totals.count > 0 && (
                      /* What the lost ships cost, full width (not a sixth activity): the firm part
                         with its sign, how much of it is already in the net (PvP) and the estimate in gray */
                      <p class="foot-losses">
                        <span>{m.actsLosses}</span>
                        {lossesOnlyEstimate ? (
                          /* Nothing firm yet (open windows not replaced): the figure is the estimate, in gray */
                          <span class="foot-losses-value estimate" title={fullNet(-toReplace)}>
                            ~{fmt(-toReplace, { sign: true })}
                            <span class="sr-only"> ({m.lossEstimate})</span>
                          </span>
                        ) : (
                          <>
                            <span class:list={['foot-losses-value', sign(lossesFirm)]} title={fullNet(lossesFirm)}>
                              {fmt(lossesFirm, { sign: true })}
                            </span>
                          </>
                        )}
                        <a class="inline-action" href="#perdidas">{nbsp(m.actsLossesLink)}</a>
                      </p>
                    )}
                    {internalNote && <span class="sub at-end">{internalNote}</span>}
                    {!withInv && (
                      /* Wallets only: no net-worth card (it repeated the active chip's balance 200 px below it); its Omega
                         line, its coverage note and the inventory toggle live here, at the card's foot */
                      <div class="hero-tools">
                        <div class="hero-tools-text">
                          {omega && omega.missing !== null && (
                            <p class="omega-line">
                              {omega.missing > 0 ? m.omegaLine(fmt(omega.missing)) : m.omegaLineCovered}
                              {' · '}
                              <a class="inline-action" href="/indicadores">{m.indicators}</a>
                            </p>
                          )}
                          {!selected && pilotList && (
                            <CoverageNote pilots={pilotList} staleAfterMs={staleAfterMs} syncRunning={status?.running} amounts={worthByPilot} walletOnly={true} />
                          )}
                          {worthNote && (
                            <p class="worth-note">
                              <Icon name="alert" class="stale-icon" />
                              {worthNote}
                            </p>
                          )}
                        </div>
                        <form class="inv-toggle" method="get" action="/inv">
                          <fieldset>
                            <legend class="sr-only">{m.invToggle}</legend>
                            <input type="hidden" name="back" value={invBack} />
                            <button type="submit" name="to" value="0" aria-pressed="true">{m.invWallets}</button>
                            <button type="submit" name="to" value="1" aria-pressed="false">{m.invPlus}</button>
                          </fieldset>
                        </form>
                      </div>
                    )}
                  </div>
                </div>
              </div>
              {withInv && (
              <div class:list={['panel', 'stat', 'worth', { compact: !showMap, stale: selectedBroken }]}>
                <div class="worth-head">
                  <div>
                    <span class="label">
                      <Icon name="wallet" />
                      {withInv ? m.netWorth : m.walletsOnly}
                    </span>
                    <span class="value" title={full(netWorth)}>
                      {fmt(netWorth)}
                      <small> ISK</small>
                    </span>
                  </div>
                  {withInv && (
                  <dl class="breakdown">
                    <div>
                      <dt>
                        <i class="key balance" />
                        {m.wallets}
                      </dt>
                      <dd title={full(summary.balance)}>{fmt(summary.balance)}</dd>
                    </div>
                    <div>
                      <dt>
                        <i class="key inventory" />
                        {m.inventory}
                      </dt>
                      <dd title={inventoryValue ? full(inventoryValue) : m.noInventory}>
                        {inventoryValue ? fmt(inventoryValue) : '—'}
                      </dd>
                    </div>
                  </dl>
                  )}
                  {/* What counts toward net worth: wallets only (what pays for Omega) or + inventory. Remembered (cookie) */}
                  <form class="inv-toggle" method="get" action="/inv">
                    <fieldset>
                      <legend class="sr-only">{m.invToggle}</legend>
                      <input type="hidden" name="back" value={invBack} />
                      <button type="submit" name="to" value="0" aria-pressed={withInv ? 'false' : 'true'}>{m.invWallets}</button>
                      <button type="submit" name="to" value="1" aria-pressed={withInv ? 'true' : 'false'}>{m.invPlus}</button>
                    </fieldset>
                  </form>
                </div>
                {omega && omega.missing !== null && (
                  <p class="omega-line">
                    {omega.missing > 0 ? m.omegaLine(fmt(omega.missing)) : m.omegaLineCovered}
                    {' · '}
                    <a class="inline-action" href="/indicadores">{m.indicators}</a>
                  </p>
                )}
                {!selected && pilotList && (
                  <CoverageNote
                    pilots={pilotList}
                    staleAfterMs={staleAfterMs}
                    syncRunning={status?.running}
                    amounts={worthByPilot}
                    walletOnly={!withInv}
                  />
                )}
                {worthNote && (
                  <p class="worth-note">
                    <Icon name="alert" class="stale-icon" />
                    {worthNote}
                  </p>
                )}
                {showMap && geo && <NewEdenMap map={geo} />}
              </div>
              )}
            </section>
            )}

            {!pilotEmpty && (
            <section class:list={['panel', { 'chart-stale': selectedBroken }]}>
              <div class="panel-heading">
                <h2>{m.dailyFlow}</h2>
                <span class="meta">{m.eveTimeUtc}</span>
              </div>
