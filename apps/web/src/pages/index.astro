                          <dt>{m.openingBalance}</dt>
                          <dd>{c.openingBalance === null ? '—' : fmt(c.openingBalance)}</dd>
                        </div>
                        <div class="minor">
                          <dt>{m.balance}</dt>
                          <dd>{c.balance === null ? '—' : fmt(c.balance)}</dd>
                        </div>
                        {withInv && (
                          <div class="minor">
                            <dt>{m.inventory}</dt>
