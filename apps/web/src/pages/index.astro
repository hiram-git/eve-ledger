---
import { PILOT_SLOTS } from 'astro:env/server';
import Base from '../layouts/Base.astro';
import FirstRun from '../components/FirstRun.astro';
import FirstSync from '../components/FirstSync.astro';
import DailyChart from '../components/DailyChart.astro';
import Icon from '../components/Icon.astro';
import NewEdenMap from '../components/NewEdenMap.astro';
import MarketItems from '../components/MarketItems.astro';
import MarketReview from '../components/MarketReview.astro';
import ActivityList from '../components/ActivityList.astro';
import BarList, { type BarRow } from '../components/BarList.astro';
import CoverageNote from '../components/CoverageNote.astro';
import {
  ApiError,
  getInventory,
  getMap,
  getPilots,
  getSummary,
  getSyncStatus,
  loginUrl,
  syncLogUrl,
  type GeoMap,
  type Inventory,
  type Pilot,
  type Summary,
  type SyncStatus,
} from '../lib/api';
import { ago, isk, iskFull, shortDate } from '../lib/format';
import { getLang, t } from '../lib/i18n';
import { hasIssue, pilotState } from '../lib/pilot-state';

const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const date = (iso: string) => shortDate(iso, lang);
const rel = (iso: string | null) => ago(iso, lang);

const PERIODS = [7, 30, 90];
const q = Astro.url.searchParams;
const days = PERIODS.includes(Number(q.get('days'))) ? Number(q.get('days')) : 30;
// ?pilot=ID: el ledger de un solo piloto
const pilotParam = Number(q.get('pilot'));
const pilotId = Number.isSafeInteger(pilotParam) && pilotParam > 0 ? pilotParam : undefined;
const href = (d: number, pilot?: number) => `/?days=${d}${pilot ? `&pilot=${pilot}` : ''}`;

let summary: Summary | undefined;
let status: SyncStatus | undefined;
let inventory: Inventory | undefined;
let geo: GeoMap | undefined;
let pilotList: Pilot[] | undefined;
let apiError: string | undefined;
try {
  // Inventario y mapa son opcionales: si fallan, el resto del dashboard se muestra igual
  const optional = <T,>(p: Promise<T>) => p.catch((err) => (console.error(err), undefined));
  [summary, status, inventory, geo, pilotList] = await Promise.all([
    getSummary(days, pilotId),
    getSyncStatus(),
    optional(getInventory(pilotId)),
    optional(getMap(pilotId)),
    optional(getPilots()),
  ]);
} catch (err) {
  // Un piloto que ya no está vinculado (enlace viejo): volver al consolidado
  if (pilotId && err instanceof ApiError && err.status === 404) return Astro.redirect(href(days));
  apiError = err instanceof Error ? err.message : String(err);
}
const selected = pilotId ? summary?.characters.find((c) => c.id === pilotId) : undefined;
// Primer uso: sin pilotos, o con pilotos pero ningún movimiento guardado todavía (primer sync)
const noPilots = !!summary && summary.characters.length === 0;
const waiting = !!summary && summary.characters.length > 0 && !pilotId && !summary.coverage.firstEntryAt;
const dashboard = !!summary && summary.characters.length > 0 && !waiting;
// Neto consolidado = suma de los netos por piloto (el trading se pliega por piloto, pero el neto es aditivo)
const allNet = summary?.characters.reduce((n, c) => n + c.net, 0) ?? 0;

const synced = q.get('synced');
const syncErrors = q.get('syncErrors');
const syncFailed = q.get('syncFailed');

// Patrimonio consolidado y proporciones para las barras de desglose
const inventoryValue = inventory && inventory.stacks > 0 ? inventory.value : 0;
const netWorth = (summary?.balance ?? 0) + inventoryValue;
const share = (part: number, total: number) => (total > 0 ? Math.max(0, Math.min(1, part / total)) : 0);
const flowTotal = (summary?.totals.income ?? 0) + (summary?.totals.expenses ?? 0);

// Sync más reciente entre todos los personajes: gobierna el aviso global de datos viejos
const globalLastSync = summary?.characters
  .map((c) => c.lastSyncAt)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);
// Frescura de la tarjeta: en la vista de un piloto, la de ese piloto (no la del más reciente de todos)
const lastSync = selected ? (selected.lastSyncAt ?? undefined) : globalLastSync;

// Antigüedad: datos «viejos» cuando superan dos intervalos de sync (o 2 h si el cron está apagado)
const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const isStale = (iso: string | null | undefined) => !iso || Date.now() - new Date(iso).getTime() > staleAfterMs;
// Pilotos que necesitan atención: el mismo estado que en /pilotos (error, primer sync o datos viejos),
// con su causa corta y la acción que toca, en una línea bajo el filtro
const pilotStates = new Map((pilotList ?? []).map((p) => [p.id, pilotState(p, m, staleAfterMs, status?.running)]));
const pilotById = new Map((pilotList ?? []).map((p) => [p.id, p]));
// La línea de salud es el único sitio con causa y acción: sync roto o viejo, sin primer sync o sin permiso
const needsAttention = (c: { id: number; lastSyncAt: string | null }) => {
  const st = pilotStates.get(c.id);
  const p = pilotById.get(c.id);
  return st && p ? hasIssue(p, st) : isStale(c.lastSyncAt);
};
type HealthAction = 'relink' | 'sync' | 'review' | null;
const healthItems =
  summary?.characters.filter(needsAttention).map((c): { id: number; name: string; cause: string; action: HealthAction } => {
    const st = pilotStates.get(c.id);
    if (!st) return { id: c.id, name: c.name, cause: m.healthStale(c.lastSyncAt ? rel(c.lastSyncAt) : m.never), action: 'sync' };
    if (st.kind === 'pending') return { id: c.id, name: c.name, cause: m.healthPending, action: null };
    if (st.kind === 'error') {
      const token = st.hint === m.errToken;
      const kinds: Record<string, string> = { journal: m.kindJournal, transactions: m.kindTransactions, assets: m.kindAssets };
      const raw = pilotById.get(c.id)?.lastError?.kind ?? '';
      return { id: c.id, name: c.name, cause: token ? m.healthToken : m.healthFailed(kinds[raw] ?? raw), action: token ? 'relink' : 'review' };
    }
    // Sync al día, pero le falta un permiso (el de inventario): se arregla revinculando
    if (st.kind === 'ok') return { id: c.id, name: c.name, cause: m.healthNoAssets, action: 'relink' };
    return { id: c.id, name: c.name, cause: c.lastSyncAt ? m.healthStale(rel(c.lastSyncAt)) : m.healthNoFirst, action: 'sync' };
  }) ?? [];
// Pilotos con el sync al día (un permiso que falta no cuenta aquí: no hace viejos los datos)
const freshCount =
  summary?.characters.filter((c) => {
    const st = pilotStates.get(c.id);
    return st ? st.kind === 'ok' : !isStale(c.lastSyncAt);
  }).length ?? 0;
// Estado del piloto filtrado: si está roto o viejo, toda la tarjeta de Neto lo dice
const selectedState = selected ? pilotStates.get(selected.id) : undefined;
const selectedBroken = !!selectedState && selectedState.kind !== 'ok';
// Piloto filtrado sin ningún sync: no hay datos, y un «0 ISK» se leería como un dato. Estado vacío propio
const pilotEmpty = !!selected && !selected.lastSyncAt;
// Su acción ya está en el estado vacío: la línea de salud no la repite
const healthShown = pilotEmpty ? healthItems.filter((h) => h.id !== selected!.id) : healthItems;
// Consolidado: cuánto del neto viene de pilotos con datos viejos o rotos. Una sola línea que cuantifica
// (el neto no cambia de color; quién y por qué está en la línea de salud)
const staleNetPilots = !selected
  ? (summary?.characters ?? []).filter((c) => c.lastSyncAt && c.net !== 0 && pilotStates.get(c.id) && pilotStates.get(c.id)!.kind !== 'ok')
  : [];
const staleNet = staleNetPilots.reduce((n, c) => n + c.net, 0);
const staleNetOldest = staleNetPilots.map((c) => c.lastSyncAt!).sort()[0];
// «hace 3 d» no se parte en dos líneas
const nbsp = (text: string) => text.replace(/ /g, '\u00a0');
// Vista de un piloto con el sync atascado: «Hoy» no es cero, es desconocido; el gráfico acaba en su último sync
const todayUnknown =
  !!selected && selectedBroken && !!selected.lastSyncAt && selected.lastSyncAt.slice(0, 10) < new Date().toISOString().slice(0, 10);
const chartLastDate = selected && selectedBroken && selected.lastSyncAt ? selected.lastSyncAt.slice(0, 10) : null;
// Conciliación de la revisión de mercado: lo que dice el wallet (market_transaction del journal)
const walletMarket = summary?.byActivity
  .find((a) => a.activity === 'trading')
  ?.refTypes.find((r) => r.refType === 'market_transaction');
// «Todos» al principio de la franja: se queda fijo en móvil mientras la fila se desliza
const firstHistory = summary?.coverage.firstEntryAt ? date(summary.coverage.firstEntryAt) : null;
// El mapa protagoniza la primera pantalla solo cuando hay algo que contar hoy (ISK ganado en algún sistema);
// si no, baja junto al inventario y Patrimonio queda como una franja compacta
const showMap = !!geo && geo.nodes.some((n) => n.earnedToday > 0);
const mapBelow = !!geo && !showMap && geo.nodes.length > 0;
const firstDate = summary?.coverage.firstEntryAt?.slice(0, 10) ?? null;
const partialHistory = summary && summary.coverage.firstEntryAt && summary.coverage.coveredDays < days;

// Signo del neto como estado semántico (verde/rojo + flecha), no como decoración
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
const delta = summary && summary.previous.complete ? summary.totals.net - summary.previous.net : undefined;

// Neto con cobertura parcial: el título lo dice (90 días pedidos, 42 con historial)
const coverageNote = partialHistory && summary ? ` (${m.onlyCovered(summary.coverage.coveredDays)})` : '';
// Desglose por actividad en la tarjeta de Neto (orden fijo de la API: PvE, PvP, Trading, Otros)
const actMax = Math.max(1, ...(summary?.byActivity ?? []).map((a) => Math.abs(a.net)));
const actBar = (v: number) => (v >= 0 ? `left:50%;width:${(v / actMax) * 50}%` : `right:50%;width:${(-v / actMax) * 50}%`);
const out = (v: number) => (v ? -v : 0);

// Rango real del período en hora de EVE, para el subtítulo de la navegación
const range = summary ? `${date(summary.period.from)} – ${date(summary.period.to)}` : undefined;

// Las estructuras de jugadores no tienen nombre sin el scope de estructuras
const locationLabel = (id: number, name: string | null) =>
  name ?? (id > 1_000_000_000_000 ? m.structure(id) : `#${id}`);
// "Jita IV - Moon 4 - Caldari Navy Assembly Plant" → "Jita IV - Moon 4" (el nombre completo va en el tooltip)
const shortStation = (name: string) => name.split(' - ').slice(0, 2).join(' - ');
// Ubicaciones en el espacio (raíz = un sistema, no una estación): «Amarr» a secas se confundía con la estación
const inSpaceRange = (id: number) => id >= 30_000_000 && id <= 32_999_999;
const locationRows: BarRow[] =
  inventory?.byLocation.map((l) => {
    const full = locationLabel(l.locationId, l.name);
    const label = inSpaceRange(l.locationId) ? `${shortStation(full)} (${m.inSpace})` : shortStation(full);
    // Las estructuras sin nombre muestran un ID acortado: el completo va en el detalle
    const id = l.name ? '' : ` (#${l.locationId})`;
    return { label, value: l.value, detail: `${full}${id} · ${m.stacks(l.stacks)}` };
  }) ?? [];
// Lo más valioso: los 6 primeros (8 si el mapa comparte la columna de al lado); el detalle completo está en GET /assets
const valuableItems = inventory?.topItems.slice(0, mapBelow ? 8 : 6).map((i) => ({ ...i, isk: i.value })) ?? [];
const inventoryByChar = new Map(inventory?.byCharacter.map((c) => [c.characterId, c.value]));
// Fila Total de la tabla de pilotos: la suma de los pilotos, que es el consolidado del resumen (la API excluye
// las transferencias entre tus pilotos también en cada piloto, así que ingresos, gastos y neto suman exacto).
// Se suma de `characters`, que viene completo también en la vista de un piloto
const pilotTotals = (summary?.characters ?? []).reduce(
  (t, c) => ({
    balance: t.balance + (c.balance ?? 0),
    inventory: t.inventory + (inventoryByChar.get(c.id) ?? 0),
    income: t.income + c.income,
    expenses: t.expenses + c.expenses,
    net: t.net + c.net,
  }),
  { balance: 0, inventory: 0, income: 0, expenses: 0, net: 0 },
);
// Lo que aporta cada piloto a Patrimonio (saldo + inventario): la nota de cobertura dice cuánto es viejo
const worthByPilot: Record<number, number> = Object.fromEntries(
  (summary?.characters ?? []).map((c) => [c.id, (c.balance ?? 0) + (inventoryByChar.get(c.id) ?? 0)]),
);
// Vista de un piloto que no está al día (o sin permiso de inventario): de cuándo son su saldo y su inventario
const selectedPilot = selected ? pilotById.get(selected.id) : undefined;
const selectedNoAssets = !!selectedPilot?.missingScopes.includes('esi-assets.read_assets.v1');
const selectedInvAt = selected ? inventory?.byCharacter.find((c) => c.characterId === selected.id)?.updatedAt : undefined;
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const worthNote =
  selected && selected.lastSyncAt && (selectedBroken || selectedNoAssets)
    ? capitalize(
        [
          selectedBroken ? m.worthStaleBalance(rel(selected.lastSyncAt)) : null,
          selectedInvAt
            ? m.worthStaleInventory(rel(selectedInvAt)) + (selectedNoAssets ? ` (${m.scopeMissingShort})` : '')
            : selectedNoAssets
              ? m.coverNoInventory(selected.name)
              : null,
        ]
          .filter(Boolean)
          .join(' · '),
      )
    : '';
---

<Base
  section="resumen"
  status={status}
  pilots={summary?.characters.length}
  pilotIssues={(pilotList ?? []).filter((p) => hasIssue(p, pilotStates.get(p.id)!)).length}
>
    {dashboard && (
    <nav class="main-nav shell" aria-label={m.period} slot="nav">
      <div class="nav-tabs">
        {
          PERIODS.map((p) => (
            <a class="nav-tab" href={href(p, pilotId)} aria-current={p === days ? 'page' : undefined}>
              <Icon name="clock" />
              {m.days(p)}
            </a>
          ))
        }
      </div>
      <p class="period-meta">
        {range && <span>{range} · {m.eveTime}</span>}
        {
          partialHistory && (
            <span class="coverage" title={m.coverageTitle}>
              <Icon name="info" />
              {m.coverage(date(summary!.coverage.firstEntryAt!), summary!.coverage.coveredDays, days)}
            </span>
          )
        }
      </p>
    </nav>
    )}

      <h1 class="sr-only">{selected ? m.summaryH1Pilot(selected.name, days) : m.summaryH1(days)}</h1>

      {
        synced !== null && (
          <div class="notice">
            <Icon name="info" />
            <p>
              {m.syncDone(synced)}
              {syncErrors && (
                <strong>
                  {' '}
                  · {m.syncErrors(Number(syncErrors))} <a href={syncLogUrl}>{m.syncLog}</a>
                </strong>
              )}
            </p>
          </div>
        )
      }
      {
        /* Aviso global: solo cuando todo el ledger está viejo; un piloto roto lo explica su propia tarjeta */
        dashboard && isStale(globalLastSync) && (
          <div class="notice warning" role="status">
            <Icon name="alert" />
            <p>
              <strong>{m.staleTitle}</strong> {m.staleLast(rel(globalLastSync ?? null))}{' '}
              {status && !status.enabled ? m.staleCronOff : m.staleCronFailed} {m.staleAction}{' '}
              <a href={syncLogUrl}>{m.syncLog}</a>.
            </p>
          </div>
        )
      }
      {
        syncFailed && (
          <div class="notice error">
            <Icon name="alert" />
            <p>{m.syncFailed} {syncFailed}</p>
          </div>
        )
      }

      {
        apiError && (
          <div class="notice error">
            <Icon name="alert" />
            <div>
              <strong>{m.apiDown}</strong>
              <p class="muted">{apiError}</p>
              <p>
                {m.apiRunning} <code>apps/api</code>: <code>bun run dev</code>
              </p>
            </div>
          </div>
        )
      }

      {
        noPilots && <FirstRun slots={PILOT_SLOTS} />
      }
      {
        waiting && <FirstSync pilots={summary!.characters} slots={PILOT_SLOTS} />
      }

      {
        dashboard && summary && (
          <>
            <nav class="pilot-strip" aria-label={m.filterByPilot}>
              <ul>
                <li>
                  <a
                    href={href(days)}
                    aria-current={!pilotId ? 'page' : undefined}
                    title={m.allPilotsTitle(full(allNet), days)}
                  >
                    <span class="pilot-name">{m.allPilots}</span>
                    <span class:list={['pilot-net', { pos: allNet > 0, neg: allNet < 0 }]}>{fmt(allNet, { sign: true })}</span>
                  </a>
                </li>
                {summary.characters.map((c) => (
                  <li>
                    <a
                      href={href(days, c.id)}
                      aria-current={c.id === pilotId ? 'page' : undefined}
                      class:list={{ stale: isStale(c.lastSyncAt) }}
                      title={m.pilotNetTitle(c.name, full(c.net), days) + (isStale(c.lastSyncAt) ? m.noSyncSince(rel(c.lastSyncAt)) : '')}
                    >
                      {isStale(c.lastSyncAt) && <i class="stale-dot" aria-hidden="true" />}
                      <span class="pilot-name">{c.name}</span>
                      <span class:list={['pilot-net', { pos: c.net > 0, neg: c.net < 0 }]}>
                        {c.lastSyncAt ? fmt(c.net, { sign: true }) : '—'}
                      </span>
                      {isStale(c.lastSyncAt) && c.lastSyncAt && <span class="chip-age" aria-hidden="true">{rel(c.lastSyncAt)}</span>}
                      {isStale(c.lastSyncAt) && <span class="sr-only">{m.noSyncSince(rel(c.lastSyncAt))}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <script>
              // En móvil la fila se desliza: que el piloto activo quede a la vista
              const strip = document.querySelector<HTMLElement>('.pilot-strip ul');
              const active = strip?.querySelector<HTMLElement>('[aria-current="page"]');
              const all = strip?.querySelector<HTMLElement>('li');
              if (strip && active && all && active.parentElement !== all && strip.scrollWidth > strip.clientWidth) {
                const want = active.parentElement!.offsetLeft - strip.offsetLeft - all.offsetWidth;
                const max = strip.scrollWidth - strip.clientWidth;
                // Si el chip activo es de los últimos, la fila no llega a ponerlo junto a «Todos» y el anterior
                // asomaría a medias bajo «Todos» (se leería «40 M» sin su signo): se alarga el final de la fila
                if (want > max) strip.style.paddingRight = `${parseFloat(getComputedStyle(strip).paddingRight) + want - max}px`;
                strip.scrollLeft = want;
              }
            </script>

            {
              healthShown.length > 0 && (
                <div class="pilot-health" role="status">
                  <Icon name="alert" class="stale-icon" />
                  <ul class="health-full">
                    {healthShown.map((h) => (
                      <li>
                        <span class="health-name">{h.name}:</span> {h.cause}
                        {h.action === 'relink' && (
                          <>
                            {' → '}
                            <a class="inline-action" href={loginUrl} title={m.relinkAs(h.name)} aria-label={m.relinkAs(h.name)}>{m.relink}</a>
                          </>
                        )}
                        {h.action === 'review' && (
                          <>
                            {' → '}
                            <a class="inline-action" href="/pilotos">{m.healthReview}</a>
                          </>
                        )}
                        {h.action === 'sync' && (
                          <form method="post" action="/sync" class="sync-form inline">
                            <input type="hidden" name="back" value={href(days, pilotId)} />
                            <input type="hidden" name="character" value={h.id} />
                            {' → '}
                            <button type="submit" class="inline-action" title={m.syncOneTitle(h.name)}>{m.syncOne}</button>
                          </form>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {pilotEmpty && selected && (
              <section class="panel empty-pilot" aria-labelledby="empty-pilot-title">
                <h2 id="empty-pilot-title">{m.emptyPilotTitle(selected.name)}</h2>
                <p>{selectedState?.kind === 'pending' ? m.emptyPilotPending : m.emptyPilotLead}</p>
                <div class="empty-actions">
                  {selectedState?.kind !== 'pending' && (
                    <form method="post" action="/sync" class="sync-form">
                      <input type="hidden" name="back" value={href(days, pilotId)} />
                      <input type="hidden" name="character" value={selected.id} />
                      <button type="submit" class="secondary-button" title={m.syncOneTitle(selected.name)}>
                        <Icon name="refresh" />
                        <span class="label">{m.syncOne}</span>
                      </button>
                    </form>
                  )}
                  <a class="inline-action" href={href(days)}>{m.backToAll}</a>
                </div>
              </section>
            )}

            {!pilotEmpty && (
            <section class:list={['glance', { solo: !showMap }]} aria-labelledby="glance-title">
              <h2 id="glance-title" class="sr-only">{m.net} · {m.netWorth}</h2>
              <div class:list={['panel', 'stat', 'hero-stat', { stale: selectedBroken }]}>
                <div class="hero-body">
                  <div class="headline">
                    <div class="fig">
                      <span class="label">
                        <Icon name="activity" />
                        {selected ? m.netPeriodPilot(selected.name, days) : m.netPeriod(days)}{coverageNote}
                      </span>
                      <span class:list={['value', 'signed', sign(summary.totals.net)]} title={full(summary.totals.net)}>
                        {summary.totals.net !== 0 && <Icon name={summary.totals.net > 0 ? 'up' : 'down'} class="trend" />}
                        {fmt(summary.totals.net, { sign: true })}
                        <small>ISK</small>
                        <span class="sr-only">{summary.totals.net > 0 ? m.gain : summary.totals.net < 0 ? m.loss : m.even} ({full(summary.totals.net)})</span>
                      </span>
                      {
                        delta !== undefined ? (
                          <p class="versus compare">
                            {delta === 0 ? (
                              m.versusSame(days)
                            ) : (
                              <span class:list={['delta', sign(delta)]}>
                                <Icon name={delta > 0 ? 'up' : 'down'} />
                                {delta > 0
                                  ? m.versusMore(fmt(delta), days, fmt(summary.previous.net, { sign: true }))
                                  : m.versusLess(fmt(-delta), days, fmt(summary.previous.net, { sign: true }))}
                              </span>
                            )}
                          </p>
                        ) : (
                          <p class="versus">{firstHistory ? m.noPreviousSince(firstHistory, days) : m.noPrevious(days)}</p>
                        )
                      }
                      {staleNet !== 0 && staleNetOldest && (
                        <p
                          class="versus stale-share"
                          title={staleNetPilots.map((c) => `${c.name}: ${fmt(c.net, { sign: true })} (${rel(c.lastSyncAt)})`).join(' · ')}
                        >
                          <Icon name="alert" class="stale-icon" />
                          {m.netStaleShare(fmt(staleNet, { sign: true }), nbsp(rel(staleNetOldest)))}
                        </p>
                      )}
                    </div>
                    <div class="fig today" title={m.todayTitle(full(summary.today.net))}>
                      <span class="label">
                        <Icon name="clock" />
                        {m.today}
                        <span class="sr-only"> · {m.todayTitle(full(summary.today.net))}</span>
                      </span>
                      <span class:list={['value', 'signed', sign(summary.today.net)]}>
                        {summary.today.net !== 0 && <Icon name={summary.today.net > 0 ? 'up' : 'down'} class="trend" />}
                        {fmt(summary.today.net, { sign: true })}
                        <small>ISK</small>
                        <span class="sr-only">{summary.today.net > 0 ? m.gain : summary.today.net < 0 ? m.loss : m.even} ({full(summary.today.net)})</span>
                      </span>
                      <p class="versus">
                        {summary.today.income || summary.today.expenses
                          ? m.todayFlow(fmt(summary.today.income), fmt(summary.today.expenses))
                          : todayUnknown
                            ? m.todayNoData
                            : m.todayNone}
                      </p>
                      {
                        selected ? (
                          /* Un solo piloto: de cuándo son sus datos. La causa y la acción están en la línea de salud */
                          lastSync && (
                            <p class:list={['versus', 'asof', { stale: selectedBroken }]}>
                              {selectedBroken && <Icon name="alert" class="stale-icon" />}
                              {selectedBroken ? m.asOfBroken('') : m.asOfSync('')}
                              <time datetime={lastSync} data-ago={lastSync}>{rel(lastSync)}</time>
                            </p>
                          )
                        ) : (
                          lastSync && (
                            /* Consolidado: cuántos pilotos están al día, en gris; ámbar solo si todo el ledger está viejo */
                            <p class:list={['versus', 'asof', { stale: isStale(lastSync) }]}>
                              {isStale(lastSync) && <Icon name="alert" class="stale-icon" />}
                              {freshCount < summary.characters.length
                                ? m.asOfPartial(freshCount, summary.characters.length, '')
                                : m.asOfSync('')}
                              <time datetime={lastSync} data-ago={lastSync}>{rel(lastSync)}</time>
                            </p>
                          )
                        )
                      }
                    </div>
                  </div>
                  <div class="composition">
                    <div class="flow">
                      <div class="ratio" aria-hidden="true">
                        {summary.totals.income > 0 && (
                          <i class="income" style={`flex-grow:${share(summary.totals.income, flowTotal)}`} />
                        )}
                        {summary.totals.expenses > 0 && (
                          <i class="expenses" style={`flex-grow:${share(summary.totals.expenses, flowTotal)}`} />
                        )}
                      </div>
                      <dl class="breakdown">
                        <div>
                          <dt>
                            <i class="key income" />
                            {m.income}
                          </dt>
                          <dd title={full(summary.totals.income)}>{fmt(summary.totals.income)}</dd>
                        </div>
                        <div>
                          <dt>
                            <i class="key expenses" />
                            {m.expenses}
                          </dt>
                          <dd title={full(-summary.totals.expenses)}>{fmt(-summary.totals.expenses)}</dd>
                        </div>
                      </dl>
                    </div>
                    {
                      summary.byActivity.length > 0 && (
                        <div class="acts-block">
                          <p class="acts-title">{m.byActivityPeriod(days)}</p>
                          <ul class="acts" aria-label={m.byActivity}>
                            {summary.byActivity.map((a) => (
                              <li title={`${m.activityHint[a.activity]} · ${m.activityInOut(full(a.income), full(out(a.expenses)))}`}>
                                <span class="act-name">{m.activityName[a.activity]}<span class="sr-only"> ({m.activityHint[a.activity]})</span></span>
                                <span class="act-bar" aria-hidden="true">
                                  <i class:list={[sign(a.net)]} style={actBar(a.net)} />
                                </span>
                                <span class:list={['act-net', sign(a.net)]}>{fmt(a.net, { sign: true })}</span>
                              </li>
                            ))}
                          </ul>
                          <p class="acts-note">{m.actsNote}</p>
                          <a class="acts-link" href="#por-actividad">
                            {m.activityDetailLink}
                            <i class="chev" aria-hidden="true" />
                          </a>
                        </div>
                      )
                    }
                  </div>
                  {summary.internalTransfers > 0 && (
                    <span class="sub">{(selected ? m.internalPilot : m.internal)(fmt(summary.internalTransfers))}</span>
                  )}
                </div>
              </div>
              <div class:list={['panel', 'stat', 'worth', { compact: !showMap, stale: selectedBroken }]}>
                <div class="worth-head">
                  <div>
                    <span class="label">
                      <Icon name="wallet" />
                      {m.netWorth}
                    </span>
                    <span class="value" title={full(netWorth)}>
                      {fmt(netWorth)}
                      <small>ISK</small>
                    </span>
                  </div>
                  <dl class="breakdown">
                    <div>
                      <dt>
                        <i class="key balance" />
                        {m.wallets}
                      </dt>
                      <dd title={full(summary.balance)}>{fmt(summary.balance)}</dd>
                    </div>
                    <div>
                      <dt>
                        <i class="key inventory" />
                        {m.inventory}
                      </dt>
                      <dd title={inventoryValue ? full(inventoryValue) : m.noInventory}>
                        {inventoryValue ? fmt(inventoryValue) : '—'}
                      </dd>
                    </div>
                  </dl>
                </div>
                {!selected && pilotList && (
                  <CoverageNote pilots={pilotList} staleAfterMs={staleAfterMs} syncRunning={status?.running} amounts={worthByPilot} />
                )}
                {worthNote && (
                  <p class="worth-note">
                    <Icon name="alert" class="stale-icon" />
                    {worthNote}
                  </p>
                )}
                {showMap && geo && <NewEdenMap map={geo} />}
              </div>
            </section>
            )}

            {!pilotEmpty && (
            <section class:list={['panel', { 'chart-stale': selectedBroken }]}>
              <div class="panel-heading">
                <h2>{m.dailyFlow}</h2>
                <span class="meta">{m.eveTimeUtc}</span>
              </div>
              <div class="panel-body">
                <DailyChart daily={summary.daily} firstDate={firstDate} lastDate={chartLastDate} />
              </div>
            </section>
            )}

            {!pilotEmpty && <ActivityList activities={summary.byActivity} />}

            <section class="panel">
              <div class="panel-heading">
                <h2 id="pilotos">{m.pilotsPeriod(days)}</h2>
                <a class="meta link" href="/pilotos">
                  <Icon name="users" />
                  {m.managePilots}
                </a>
              </div>
              <div class="scroll pilots-table" role="group" aria-label={m.pilots}>
                <table class="pilots">
                  <thead>
                    <tr>
                      <th>{m.pilot}</th>
                      <th>{m.balance}</th>
                      <th>{m.inventory}</th>
                      <th>{m.income}</th>
                      <th>{m.expenses}</th>
                      <th>{m.net}</th>
                      <th>{m.lastSync}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {summary.characters.map((c) => (
                      <tr class:list={{ selected: c.id === pilotId && !pilotEmpty }} aria-current={c.id === pilotId ? 'true' : undefined}>
                        <td>
                          <span class="who">
                            <img
                              src={`https://images.evetech.net/characters/${c.id}/portrait?size=64`}
                              alt=""
                              width="30"
                              height="30"
                              loading="lazy"
                              onerror="this.style.visibility='hidden'"
                            />
                            {c.name}
                          </span>
                        </td>
                        <td title={c.balance === null ? m.noEntries : full(c.balance)}>
                          {c.balance === null ? '—' : fmt(c.balance)}
                        </td>
                        <td
                          title={
                            inventoryByChar.has(c.id) ? full(inventoryByChar.get(c.id)!) : m.noInventory
                          }
                        >
                          {inventoryByChar.has(c.id) ? fmt(inventoryByChar.get(c.id)!) : '—'}
                        </td>
                        <td>{c.lastSyncAt ? fmt(c.income) : '—'}</td>
                        <td>{c.lastSyncAt ? fmt(-c.expenses) : '—'}</td>
                        <td class:list={{ pos: c.net > 0, neg: c.net < 0 }}>{c.lastSyncAt ? fmt(c.net, { sign: true }) : '—'}</td>
                        <td class:list={['last-sync', { stale: isStale(c.lastSyncAt) }]}>
                          {isStale(c.lastSyncAt) && <Icon name="alert" class="stale-icon" />}
                          {c.lastSyncAt ? <time datetime={c.lastSyncAt} data-ago={c.lastSyncAt}>{rel(c.lastSyncAt)}</time> : m.never}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    <tr>
                      <th scope="row">{m.pilotsTotal(summary.characters.length)}</th>
                      <td title={full(pilotTotals.balance)}>{fmt(pilotTotals.balance)}</td>
                      <td title={full(pilotTotals.inventory)}>{pilotTotals.inventory ? fmt(pilotTotals.inventory) : '—'}</td>
                      <td title={full(pilotTotals.income)}>{fmt(pilotTotals.income)}</td>
                      <td title={full(out(pilotTotals.expenses))}>{fmt(out(pilotTotals.expenses))}</td>
                      <td class:list={{ pos: pilotTotals.net > 0, neg: pilotTotals.net < 0 }} title={full(pilotTotals.net)}>
                        {fmt(pilotTotals.net, { sign: true })}
                      </td>
                      <td />
                    </tr>
                  </tfoot>
                </table>
              </div>
              {/* Móvil: una tarjeta por piloto con nombre, neto y último sync; la tabla de 7 columnas se oculta */}
              <ul class="pilot-cards">
                {
                  summary.characters.map((c) => (
                    <li class:list={{ selected: c.id === pilotId && !pilotEmpty }} aria-current={c.id === pilotId ? 'true' : undefined}>
                      <div class="card-head">
                        <a class="who" href={href(days, c.id)} title={m.viewLedger(c.name)}>
                          <img
                            src={`https://images.evetech.net/characters/${c.id}/portrait?size=64`}
                            alt=""
                            width="28"
                            height="28"
                            loading="lazy"
                            onerror="this.style.display='none'"
                          />
                          {c.name}
                        </a>
                        <span class:list={['last-sync', { stale: isStale(c.lastSyncAt) }]}>
                          {isStale(c.lastSyncAt) && <Icon name="alert" class="stale-icon" />}
                          {c.lastSyncAt ? <time datetime={c.lastSyncAt} data-ago={c.lastSyncAt}>{rel(c.lastSyncAt)}</time> : m.never}
                        </span>
                      </div>
                      <dl>
                        <div>
                          <dt>{m.income}</dt>
                          <dd title={full(c.income)}>{c.lastSyncAt ? fmt(c.income) : '—'}</dd>
                        </div>
                        <div>
                          <dt>{m.expenses}</dt>
                          <dd title={full(out(c.expenses))}>{c.lastSyncAt ? fmt(out(c.expenses)) : '—'}</dd>
                        </div>
                        <div class:list={['net', { pos: c.net > 0, neg: c.net < 0 }]}>
                          <dt>{m.net}</dt>
                          <dd title={full(c.net)}>{c.lastSyncAt ? fmt(c.net, { sign: true }) : '—'}</dd>
                        </div>
                        <div class="minor">
                          <dt>{m.balance}</dt>
                          <dd>{c.balance === null ? '—' : fmt(c.balance)}</dd>
                        </div>
                        <div class="minor">
                          <dt>{m.inventory}</dt>
                          <dd>{inventoryByChar.has(c.id) ? fmt(inventoryByChar.get(c.id)!) : '—'}</dd>
                        </div>
                      </dl>
                    </li>
                  ))
                }
                {/* La suma de los pilotos: el consolidado */}
                <li class="total">
                  <div class="card-head">
                    <span class="who">{m.pilotsTotal(summary.characters.length)}</span>
                  </div>
                  <dl>
                    <div>
                      <dt>{m.income}</dt>
                      <dd title={full(pilotTotals.income)}>{fmt(pilotTotals.income)}</dd>
                    </div>
                    <div>
                      <dt>{m.expenses}</dt>
                      <dd title={full(out(pilotTotals.expenses))}>{fmt(out(pilotTotals.expenses))}</dd>
                    </div>
                    <div class:list={['net', { pos: pilotTotals.net > 0, neg: pilotTotals.net < 0 }]}>
                      <dt>{m.net}</dt>
                      <dd title={full(pilotTotals.net)}>{fmt(pilotTotals.net, { sign: true })}</dd>
                    </div>
                    <div class="minor">
                      <dt>{m.balance}</dt>
                      <dd>{fmt(pilotTotals.balance)}</dd>
                    </div>
                    <div class="minor">
                      <dt>{m.inventory}</dt>
                      <dd>{pilotTotals.inventory ? fmt(pilotTotals.inventory) : '—'}</dd>
                    </div>
                  </dl>
                </li>
              </ul>
              <p class="panel-note">
                {m.pilotsTotalNote}{' '}
                {m.noteBalance}
                {inventory?.pricesUpdatedAt && m.notePrices(rel(inventory.pricesUpdatedAt))}
                {m.noteBpc}
                {inventory && inventory.unpricedTypes > 0 && m.noteUnpriced(inventory.unpricedTypes)}.
              </p>
            </section>

            {!pilotEmpty && inventory && inventory.stacks > 0 && (
              <div class="split">
                <div class="stack">
                  <BarList title={m.whereInventory} kind="inventory" rows={locationRows} limit={11} />
                  {
                    mapBelow && geo && (
                      /* Sin ganancias hoy, el mapa solo repite la lista de arriba: queda plegado */
                      <details class="panel map-fold" id="mapa">
                        <summary class="panel-heading">
                          <h2>{m.mapTitle}</h2>
                          <span class="meta">{m.seeOnMap}</span>
                        </summary>
                        <div class="panel-body">
                          <NewEdenMap map={geo} />
                        </div>
                      </details>
                    )
                  }
                </div>
                <MarketItems
                  title={m.mostValuable}
                  items={valuableItems}
                  iskLabel={m.value}
                  priceLabel={m.unitPrice}
                  empty={m.noInventoryDot}
                />
              </div>
            )}

            {!pilotEmpty && summary.market.items.length > 0 && (
              <MarketReview market={summary.market} wallet={walletMarket ? { sold: walletMarket.income, bought: walletMarket.expenses } : undefined} />
            )}

          </>
        )
      }
</Base>

<style>
  .glance {
    display: grid;
    /* El neto lidera (~60 %); Patrimonio y el mapa apoyan */
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 16px;
  }
  /* Neto del período y «Hoy» como pareja de cifras grandes: contenedor para que dependa del ancho de la tarjeta */
  .hero-stat {
    container-type: inline-size;
  }
  /* .hero-body es el cuerpo de la tarjeta (los container queries no pueden estilar al propio contenedor).
     Estrecho: Neto → composición del período → Hoy; «Hoy» ya no se interpone entre el neto y su desglose */
  .hero-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
  }
  .headline {
    display: contents;
  }
  .fig:not(.today) {
    order: 1;
  }
  /* Estrecho: «Hoy» como fila compacta justo bajo el neto (el par no se separa en móvil); la composición después */
  .fig.today {
    order: 2;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }
  .fig.today .asof {
    flex-basis: 100%;
  }
  .hero-body .sub {
    order: 4;
  }
  .fig {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .fig.today .value {
    font-size: 22px;
  }
  /* «Hoy» sin movimientos: un cero enorme parece un fallo; se apaga y se queda pequeño */
  .fig.today .value.zero {
    font-size: 22px;
    color: var(--text-muted);
  }
  .composition {
    order: 3;
    display: grid;
    gap: 14px;
    margin-top: 8px;
  }
  .flow {
    min-width: 0;
  }
  .acts-block {
    display: grid;
    align-content: start;
    gap: 4px;
    min-width: 0;
  }
  .acts-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .acts {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .acts li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 28px;
  }
  .act-name {
    font-size: 13px;
    color: var(--text-secondary);
  }
  /* Barra divergente desde un eje central: hacia la derecha suma, hacia la izquierda resta */
  .act-bar {
    position: relative;
    height: 8px;
  }
  .act-bar::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -4px;
    bottom: -4px;
    width: 1px;
    background: var(--axis);
  }
  .act-bar i {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Un neto pequeño frente al mayor no debe quedarse en un píxel */
    min-width: 3px;
    background: var(--positive);
    border-radius: 0 3px 3px 0;
  }
  .act-bar i.neg {
    background: var(--critical);
    border-radius: 3px 0 0 3px;
  }
  .acts-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    min-height: 40px;
    font-size: 13px;
    color: var(--cyan);
    text-decoration: none;
  }
  .acts-link:hover {
    text-decoration: underline;
  }
  /* Chevrón hacia abajo (una flecha de tendencia se leería como un dato negativo) */
  .acts-link .chev {
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
  .act-net {
    min-width: 4.5rem;
    font: 500 13px var(--mono);
    letter-spacing: -0.02em;
    text-align: right;
    color: var(--text);
  }
  .act-net.pos {
    color: var(--positive);
  }
  .act-net.neg {
    color: var(--critical);
  }
  .compare {
    font-size: 14px;
    color: var(--text-secondary);
  }
  /* La comparación es una frase, no una cifra: en la tipografía de la interfaz, no en monoespaciada */
  .compare .delta {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font: 500 14px/1.35 var(--font);
  }
  .compare .delta :global(.icon) {
    align-self: center;
    width: 14px;
    height: 14px;
  }
  @container (min-width: 520px) {
    .headline {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    .fig:not(.today),
    .fig.today,
    .composition,
    .hero-body .sub {
      order: 0;
    }
    .fig.today {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 6px;
      margin-top: 0;
      padding: 0 0 0 24px;
      border-top: 0;
      border-left: 1px solid var(--line);
    }
    .fig.today .asof {
      flex-basis: auto;
    }
    .fig.today .value {
      font-size: 44px;
    }
    .fig.today :global(.trend) {
      width: 28px;
      height: 28px;
    }
    .fig.today .value.zero {
      font-size: 28px;
    }
    /* Una línea separa el par del período/hoy de la composición del período: así las actividades no se leen como las de hoy */
    .composition {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 0;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }
    .flow {
      padding-right: 24px;
    }
    .acts-block {
      padding-left: 24px;
      border-left: 1px solid var(--line);
    }
  }
  /* Ancho completo (sin mapa al lado): Neto | Hoy | Por actividad en tres columnas, Ingresos/Gastos bajo el par */
  @container (min-width: 880px) {
    .hero-body {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-rows: auto 1fr auto;
      column-gap: 0;
      row-gap: 14px;
    }
    .headline,
    .composition {
      display: contents;
    }
    .fig:not(.today) {
      grid-column: 1;
      grid-row: 1;
      padding-right: 24px;
    }
    .fig.today {
      grid-column: 2;
      grid-row: 1;
    }
    .flow {
      grid-column: 1 / 3;
      grid-row: 2;
      padding: 14px 24px 0 0;
      border-top: 1px solid var(--line);
    }
    .acts-block {
      grid-column: 3;
      grid-row: 1 / 3;
    }
    .hero-body .sub {
      grid-column: 1 / -1;
      grid-row: 3;
    }
  }
  .signed {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  /* :global porque la clase se pasa al svg del componente Icon, que no lleva el ámbito de esta página */
  .signed :global(.trend) {
    align-self: center;
    width: 28px;
    height: 28px;
    stroke-width: 2;
  }
  .pos,
  .stat .value.pos {
    color: var(--positive);
  }
  .neg,
  .stat .value.neg {
    color: var(--critical);
  }
  .hero-stat .value.zero {
    color: var(--text);
  }
  .versus {
    font-size: 13px;
    color: var(--text-muted);
    /* Sin una palabra suelta en la última línea («… hace 3 / d») */
    text-wrap: pretty;
  }
  .asof {
    display: block;
  }
  .asof :global(.stale-icon) {
    margin-right: 6px;
    vertical-align: -2px;
  }
  .asof.stale {
    color: var(--warning);
  }
  .asof a {
    /* Zona táctil ampliada sin mover el texto */
    padding-block: 12px;
    margin-block: -12px;
  }
  /* Pilotos con datos viejos: la causa y el enlace, en una línea bajo el filtro */
  .pilot-health {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: -4px 0 0;
    font-size: 13px;
    color: var(--warning);
  }
  .keep {
    white-space: nowrap;
  }
  .health-full {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .health-full li + li::before {
    content: '·';
    margin-right: 6px;
    color: var(--text-muted);
  }
  .health-name {
    color: var(--text-secondary);
  }
  /* Piloto filtrado sin ningún sync: en vez de ceros, qué pasa y qué hacer */
  .empty-pilot {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 28px 32px;
  }
  .empty-pilot h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
  }
  .empty-pilot p {
    max-width: 60ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .acts-note {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .hero-stat.stale .value.zero {
    color: var(--text-muted);
  }
  /* Piloto roto: también la barra de ingresos/gastos se apaga, como el neto */
