              {/* Mobile: the cards have no sorting header; a select does the same */}
              <div class="cards-sort">
                <label class="sort-select">
                  {m.sortBy}
                  <select data-sort-select>
                    <option value="">{m.sortOriginal}</option>
                    {sortCols.map((col) => (
                      <option value={col.key}>{col.label}</option>
