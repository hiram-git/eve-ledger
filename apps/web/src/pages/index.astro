                        <div>
                          <dt>{m.expenses}</dt>
                          <dd title={full(out(c.expenses))}>{c.lastSyncAt ? fmt(out(c.expenses)) : '—'}</dd>
                        </div>
                        <div class:list={['net', { pos: c.net > 0, neg: c.net < 0 }]}>
                          <dt>{m.net}</dt>
