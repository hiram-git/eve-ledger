                <p>
                  {m.reconcileNote}
                  {reconcileGaps.length > 0 && m.reconcileGap(reconcileGaps.map((c) => m.reconcileItem(c.name, fmt(gapOf(c), { sign: true }))).join(', '))}
                  {reconcilePending.length > 0 && m.reconcilePending(reconcilePending.map((c) => m.reconcileItem(c.name, fmt(pendingOf(c), { sign: true }))).join(', '))}
                </p>
                <p>
                  {withInv ? (
                    <>
                      {m.noteBalance}
                      {inventory?.pricesUpdatedAt && (
                        <span class:list={{ 'prices-old': pricesOld }}>
                          {pricesOld && <Icon name="alert" class="stale-icon" />}
                          {m.notePrices(nbsp(rel(inventory.pricesUpdatedAt)))}
                        </span>
                      )}
                      {m.noteBpc}
                      {inventory && inventory.unpricedTypes > 0 && m.noteUnpriced(inventory.unpricedTypes)}.
                    </>
                  ) : (
                    <>{m.noteBalanceOnly}.</>
                  )}
                </p>
              </div>
            </section>

            {withInv && !pilotEmpty && inventory && inventory.stacks > 0 && (
              <div class="split">
                <div class="stack">
                  <BarList title={m.whereInventory} kind="inventory" rows={locationRows} limit={11} />
                  {
                    mapBelow && geo && (
                      /* With no earnings today, the map only repeats the list above: it stays collapsed */
                      <details class="panel map-fold" id="mapa">
                        <summary class="panel-heading">
                          <h2>{m.mapTitle}</h2>
                          <span class="meta">{m.seeOnMap}</span>
                        </summary>
                        <div class="panel-body">
                          <NewEdenMap map={geo} />
                        </div>
                      </details>
                    )
                  }
                </div>
                <MarketItems
                  title={m.mostValuable}
                  items={valuableItems}
                  iskLabel={m.value}
                  priceLabel={m.unitPrice}
                  empty={m.noInventoryDot}
                  note={valuableItems.some((i) => i.typeId === PLEX_TYPE_ID) ? m.valuablePlex : undefined}
                />
              </div>
            )}

            {!pilotEmpty && summary.market.items.length > 0 && (
              <MarketReview market={summary.market} wallet={walletMarket && (walletMarket.sold || walletMarket.bought) ? walletMarket : undefined} />
            )}

          </>
        )
      }
</Base>

<style>
  .glance {
    display: grid;
    /* The net leads (~60 %); Net worth and the map support it. Each card is as tall as its content: stretched to the
