---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/theme.css';
import DailyChart from '../components/DailyChart.astro';
import Icon from '../components/Icon.astro';
import StarMap from '../components/StarMap.astro';
import MarketItems from '../components/MarketItems.astro';
import BarList, { type BarRow } from '../components/BarList.astro';
import { getInventory, getSummary, getSyncStatus, loginUrl, type Inventory, type Summary, type SyncStatus } from '../lib/api';
import { ago, isk, iskFull, refTypeLabel, until } from '../lib/format';

const PERIODS = [7, 30, 90];
const q = Astro.url.searchParams;
const days = PERIODS.includes(Number(q.get('days'))) ? Number(q.get('days')) : 30;

let summary: Summary | undefined;
let status: SyncStatus | undefined;
let inventory: Inventory | undefined;
let apiError: string | undefined;
try {
  // El inventario es opcional: si falla, el resto del dashboard se muestra igual
  [summary, status, inventory] = await Promise.all([
    getSummary(days),
    getSyncStatus(),
    getInventory().catch((err) => (console.error(err), undefined)),
  ]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

const synced = q.get('synced');
const syncErrors = q.get('syncErrors');
const syncFailed = q.get('syncFailed');

// Estado del sync automático para la barra superior
const cron = !status
  ? undefined
  : !status.enabled
    ? { cls: 'off', text: 'Sync auto desactivado' }
    : status.running
      ? { cls: 'busy', text: 'Sincronizando…' }
      : {
          cls: '',
          text: `Sync auto · ${status.intervalMin} min` + (status.nextRunAt ? ` · próximo ${until(status.nextRunAt)}` : ''),
        };
const cronTitle = status?.lastRun
  ? `Último sync automático ${ago(status.lastRun.finishedAt)}: ${status.lastRun.inserted} movimientos nuevos` +
    (status.lastRun.errors ? `, ${status.lastRun.errors} personaje(s) con error` : '')
  : undefined;

// Patrimonio consolidado y proporciones para las barras de desglose
const inventoryValue = inventory && inventory.stacks > 0 ? inventory.value : 0;
const netWorth = (summary?.balance ?? 0) + inventoryValue;
const share = (part: number, total: number) => (total > 0 ? Math.max(0, Math.min(1, part / total)) : 0);
const flowTotal = (summary?.totals.income ?? 0) + (summary?.totals.expenses ?? 0);

// Sync más reciente entre todos los personajes
const lastSync = summary?.characters
  .map((c) => c.lastSyncAt)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);

// Telemetría para el ticker: neto por piloto, mayor fuente de ingresos, inventario
type Tick = { label: string; value: string; trend?: 'up' | 'down' };
const ticks: Tick[] = [];
if (summary) {
  for (const c of summary.characters) {
    ticks.push({ label: c.name.toUpperCase(), value: isk(c.net, { sign: true }), trend: c.net >= 0 ? 'up' : 'down' });
  }
  const topIncome = [...summary.byRefType].sort((a, b) => b.income - a.income)[0];
  if (topIncome?.income) ticks.push({ label: `TOP INGRESO · ${refTypeLabel(topIncome.refType).toUpperCase()}`, value: isk(topIncome.income) });
  const topSold = summary.market.sold[0];
  if (topSold) ticks.push({ label: `MÁS VENDIDO · ${(topSold.name ?? `#${topSold.typeId}`).toUpperCase()}`, value: isk(topSold.isk) });
}
if (inventory?.stacks) {
  ticks.push({ label: 'INVENTARIO', value: isk(inventory.value) });
  if (inventory.byLocation[0]) {
    ticks.push({ label: `HUB PRINCIPAL · ${(inventory.byLocation[0].name ?? 'ESTRUCTURA').split(' - ')[0].toUpperCase()}`, value: isk(inventory.byLocation[0].value) });
  }
}
if (lastSync) ticks.push({ label: 'ÚLTIMO SYNC', value: ago(lastSync).toUpperCase() });

const refRows = (pick: (r: Summary['byRefType'][number]) => number): BarRow[] =>
  summary?.byRefType.map((r) => ({ label: refTypeLabel(r.refType), value: pick(r), detail: `${r.count} movimientos` })) ?? [];
const incomeRows = refRows((r) => r.income);
const expenseRows = refRows((r) => r.expenses);

// Las estructuras de jugadores no tienen nombre sin el scope de estructuras
const locationLabel = (id: number, name: string | null) =>
  name ?? (id > 1_000_000_000_000 ? `Estructura #${id}` : `#${id}`);
// "Jita IV - Moon 4 - Caldari Navy Assembly Plant" → "Jita IV - Moon 4" (el nombre completo va en el tooltip)
const shortStation = (name: string) => name.split(' - ').slice(0, 2).join(' - ');
const locationRows: BarRow[] =
  inventory?.byLocation.map((l) => {
    const full = locationLabel(l.locationId, l.name);
    return { label: shortStation(full), value: l.value, detail: `${full} · ${l.stacks} stacks` };
  }) ?? [];
const valuableItems = inventory?.topItems.map((i) => ({ ...i, isk: i.value })) ?? [];
const inventoryByChar = new Map(inventory?.byCharacter.map((c) => [c.characterId, c.value]));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070c13" />
    <title>EVE Ledger</title>
  </head>
  <body>
    <header class="utility shell">
      <div class="micro-brand">
        <span class="brand-square">E</span>
        EVE LEDGER
        <span class="muted">· {summary ? `${summary.characters.length} pilotos` : 'sin conexión'}</span>
      </div>
      <div class="utility-right">
        {
          cron && (
            <span class:list={['status-badge', cron.cls]} title={cronTitle}>
              <i class="dot" />
              <span class="text">{cron.text}</span>
            </span>
          )
        }
        <form method="post" action="/sync" id="sync-form">
          <input type="hidden" name="days" value={days} />
          <button type="submit" class="primary-button">
            <Icon name="refresh" />
            <span class="label">Sincronizar</span>
          </button>
        </form>
      </div>
    </header>

    <section class="hero">
      <StarMap />
      <div class="hero-lockup shell">
        <div class="hero-title">
          <h1>EVE <span>Ledger</span><i>_</i></h1>
          <p>Ingresos, gastos e inventario consolidado de tus pilotos, vía ESI</p>
        </div>
      </div>
    </section>

    <nav class="main-nav shell" aria-label="Período">
      <div class="nav-tabs">
        {
          PERIODS.map((p) => (
            <a class="nav-tab" href={`/?days=${p}`} aria-current={p === days ? 'page' : undefined}>
              <Icon name="clock" />
              {p} días
            </a>
          ))
        }
      </div>
      <a class="secondary-button" href={loginUrl}>
        <Icon name="plus" />
        Vincular piloto
      </a>
    </nav>

    {
      ticks.length > 0 && (
        <div class="shell">
          <div class="ticker" role="marquee" aria-label="Telemetría">
            <span class="ticker-label">
              <Icon name="signal" />
              <span>TELEMETRÍA</span>
            </span>
            <div class="ticker-window">
              <div class="ticker-track">
                {/* Contenido duplicado: la animación desplaza -50% y el bucle no se nota */}
                {[0, 1].map((copy) =>
                  ticks.map((t) => (
                    <>
                      <span aria-hidden={copy === 1 ? 'true' : undefined}>
                        {t.label} <b class:list={{ up: t.trend === 'up', down: t.trend === 'down' }}>{t.value}</b>
                      </span>
                      <span class="sep" aria-hidden="true" />
                    </>
                  )),
                )}
              </div>
            </div>
          </div>
        </div>
      )
    }

    <main class="shell">
      <div class="page-heading">
        <div>
          <h2>Estado <span>de la flota</span></h2>
          <p class="subtitle">
            <span>Últimos {days} días</span>
            {
              lastSync && (
                <span class="fresh">
                  <Icon name="activity" />
                  Datos de ESI {ago(lastSync)}
                </span>
              )
            }
          </p>
        </div>
      </div>

      {
        synced !== null && (
          <div class="notice">
            <Icon name="info" />
            <p>
              Sincronización completa: {synced} movimientos nuevos
              {syncErrors && <strong> · {syncErrors} personaje(s) con error (revisa /sync/log en la API)</strong>}
            </p>
          </div>
        )
      }
      {
        syncFailed && (
          <div class="notice error">
            <Icon name="alert" />
            <p>No se pudo sincronizar: {syncFailed}</p>
          </div>
        )
      }

      {
        apiError && (
          <div class="notice error">
            <Icon name="alert" />
            <div>
              <strong>Sin enlace con la API</strong>
              <p class="muted">{apiError}</p>
              <p>
                ¿Está corriendo? En <code>apps/api</code>: <code>bun run dev</code>
              </p>
            </div>
          </div>
        )
      }

      {
        summary && summary.characters.length === 0 && (
          <div class="notice">
            <Icon name="users" />
            <p>
              Aún no hay pilotos vinculados. <a href={loginUrl}>Vincula tu primer personaje</a> y luego pulsa
              «Sincronizar».
            </p>
          </div>
        )
      }

      {
        summary && summary.characters.length > 0 && (
          <>
            <section class="stats">
              <div class="panel stat hero-stat">
                <span class="glow-line" />
                <span class="label">
                  <Icon name="activity" />
                  Neto del período
                </span>
                <span class="value" title={iskFull(summary.totals.net)}>
                  {isk(summary.totals.net, { sign: true })}
                  <small>ISK</small>
                </span>
                <div class="ratio" aria-hidden="true">
                  {summary.totals.income > 0 && <i class="income" style={`flex-grow:${share(summary.totals.income, flowTotal)}`} />}
                  {summary.totals.expenses > 0 && <i class="expenses" style={`flex-grow:${share(summary.totals.expenses, flowTotal)}`} />}
                </div>
                <dl class="breakdown">
                  <div>
                    <dt>
                      <i class="key income" />
                      Ingresos
                    </dt>
                    <dd title={iskFull(summary.totals.income)}>{isk(summary.totals.income)}</dd>
                  </div>
                  <div>
                    <dt>
                      <i class="key expenses" />
                      Gastos
                    </dt>
                    <dd title={iskFull(-summary.totals.expenses)}>{isk(-summary.totals.expenses)}</dd>
                  </div>
                </dl>
                {summary.internalTransfers > 0 && (
                  <span class="sub">No incluye {isk(summary.internalTransfers)} ISK movidos entre tus pilotos</span>
                )}
              </div>
              <div class="panel stat">
                <span class="label">
                  <Icon name="wallet" />
                  Patrimonio
                </span>
                <span class="value" title={iskFull(netWorth)}>
                  {isk(netWorth)}
                  <small>ISK</small>
                </span>
                <div class="ratio" aria-hidden="true">
                  {summary.balance > 0 && <i class="balance" style={`flex-grow:${share(summary.balance, netWorth)}`} />}
                  {inventoryValue > 0 && <i class="inventory" style={`flex-grow:${share(inventoryValue, netWorth)}`} />}
                </div>
                <dl class="breakdown">
                  <div>
                    <dt>
                      <i class="key balance" />
                      Saldo en wallets
                    </dt>
                    <dd title={iskFull(summary.balance)}>{isk(summary.balance)}</dd>
                  </div>
                  <div>
                    <dt>
                      <i class="key inventory" />
                      Inventario
                    </dt>
                    <dd title={inventoryValue ? iskFull(inventoryValue) : 'Sin inventario sincronizado'}>
                      {inventoryValue ? isk(inventoryValue) : '—'}
                    </dd>
                  </div>
                </dl>
              </div>
            </section>

            <section class="panel">
              <div class="panel-heading">
                <h3>Flujo diario</h3>
                <span class="meta">Hora de EVE (UTC)</span>
              </div>
              <div class="panel-body">
                <DailyChart daily={summary.daily} />
              </div>
            </section>

            <div class="split">
              <BarList title="De dónde viene el ISK" kind="income" rows={incomeRows} />
              <BarList title="En qué se va" kind="expenses" rows={expenseRows} />
            </div>

            {(summary.market.sold.length > 0 || summary.market.bought.length > 0) && (
              <div class="split">
                <MarketItems
                  title="Mercado: lo más vendido"
                  items={summary.market.sold.map((i) => ({ ...i, unitPrice: i.avgPrice }))}
                />
                <MarketItems
                  title="Mercado: lo más comprado"
                  items={summary.market.bought.map((i) => ({ ...i, unitPrice: i.avgPrice }))}
                />
              </div>
            )}

            {inventory && inventory.stacks > 0 && (
              <div class="split">
                <BarList title="Dónde está tu inventario" kind="inventory" rows={locationRows} limit={11} />
                <MarketItems
                  title="Lo más valioso"
                  items={valuableItems}
                  iskLabel="Valor"
                  priceLabel="Precio unitario"
                  empty="Sin inventario sincronizado."
                />
              </div>
            )}

            <section class="panel">
              <div class="panel-heading">
                <h3>Pilotos</h3>
                <a class="meta link" href={loginUrl}>
                  <Icon name="plus" />
                  Vincular piloto
                </a>
              </div>
              <div class="scroll">
                <table class="pilots">
                  <thead>
                    <tr>
                      <th>Piloto</th>
                      <th>Saldo</th>
                      <th>Inventario</th>
                      <th>Ingresos</th>
                      <th>Gastos</th>
                      <th>Neto</th>
                      <th>Último sync</th>
                    </tr>
                  </thead>
                  <tbody>
                    {summary.characters.map((c) => (
                      <tr>
                        <td>
                          <span class="who">
                            <img
                              src={`https://images.evetech.net/characters/${c.id}/portrait?size=64`}
                              alt=""
                              width="30"
                              height="30"
                              loading="lazy"
                              onerror="this.style.visibility='hidden'"
                            />
                            {c.name}
                          </span>
                        </td>
                        <td title={c.balance === null ? 'Sin movimientos sincronizados' : iskFull(c.balance)}>
                          {c.balance === null ? '—' : isk(c.balance)}
                        </td>
                        <td
                          title={
                            inventoryByChar.has(c.id) ? iskFull(inventoryByChar.get(c.id)!) : 'Sin inventario sincronizado'
                          }
                        >
                          {inventoryByChar.has(c.id) ? isk(inventoryByChar.get(c.id)!) : '—'}
                        </td>
                        <td>{isk(c.income)}</td>
                        <td>{isk(-c.expenses)}</td>
                        <td class:list={{ pos: c.net > 0, neg: c.net < 0 }}>{isk(c.net, { sign: true })}</td>
                        <td class="muted">{ago(c.lastSyncAt)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="panel-note">
                Saldo = balance del último movimiento sincronizado. Inventario valorado con el precio medio de ESI
                {inventory?.pricesUpdatedAt && <> (actualizado {ago(inventory.pricesUpdatedAt)})</>}; las copias de
                blueprint cuentan como 0
                {inventory && inventory.unpricedTypes > 0 && (
                  <>
                    {' '}
                    y hay {inventory.unpricedTypes} {inventory.unpricedTypes === 1 ? 'tipo de ítem' : 'tipos de ítem'} sin
                    precio
                  </>
                )}
                .
              </p>
            </section>
          </>
        )
      }
    </main>

    <footer class="shell">
      <span class="footer-brand">EVE LEDGER · localhost</span>
      <span>Datos vía ESI. EVE Online y todo lo relacionado son marcas de CCP hf.</span>
    </footer>
  </body>
</html>

<script>
  // Estado de carga: el sync de todos los pilotos puede tardar; evita envíos dobles
  const form = document.getElementById('sync-form') as HTMLFormElement | null;
  form?.addEventListener('submit', () => {
    const button = form.querySelector('button')!;
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.querySelector('.label')!.textContent = 'Sincronizando…';
  });
</script>

<style>
  .stats {
    grid-template-columns: 1.15fr 1fr;
  }
  .ratio {
    display: flex;
    gap: 2px;
    height: 6px;
    margin: 10px 0 4px;
  }
  .ratio i {
    flex-basis: 0;
    min-width: 2px;
    border-radius: 2px;
  }
  .income {
    background: var(--income);
  }
  .expenses {
    background: var(--expenses);
  }
  .balance {
    background: var(--balance);
  }
  .inventory {
    background: var(--inventory);
  }
  .breakdown {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 6px 0 0;
  }
  .breakdown div {
    min-width: 0;
  }
  .breakdown dt {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .breakdown dd {
    margin: 2px 0 0;
    font: 500 18px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .key {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .stat .sub {
    margin-top: 6px;
  }
  .panel-heading a.link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 12px var(--font);
    color: var(--cyan);
  }
  .panel-heading a.link .icon {
    width: 14px;
    height: 14px;
  }
  @media (max-width: 1040px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
  .pilots th:first-child,
  .pilots td:first-child {
    padding-left: 22px;
  }
  .pilots th:last-child,
  .pilots td:last-child {
    padding-right: 22px;
  }
  .panel-heading a.meta:hover {
    color: var(--cyan);
    text-decoration: none;
  }
  code {
    font: 12px var(--mono);
    color: var(--cyan);
  }
</style>
