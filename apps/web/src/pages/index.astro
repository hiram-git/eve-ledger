---
import Base from '../layouts/Base.astro';
import DailyChart from '../components/DailyChart.astro';
import Icon from '../components/Icon.astro';
import NewEdenMap from '../components/NewEdenMap.astro';
import MarketItems from '../components/MarketItems.astro';
import BarList, { type BarRow } from '../components/BarList.astro';
import {
  getInventory,
  getMap,
  getSummary,
  getSyncStatus,
  loginUrl,
  syncLogUrl,
  type GeoMap,
  type Inventory,
  type Summary,
  type SyncStatus,
} from '../lib/api';
import { ago, isk, iskFull, refTypeLabel, shortDate } from '../lib/format';

const PERIODS = [7, 30, 90];
const q = Astro.url.searchParams;
const days = PERIODS.includes(Number(q.get('days'))) ? Number(q.get('days')) : 30;

let summary: Summary | undefined;
let status: SyncStatus | undefined;
let inventory: Inventory | undefined;
let geo: GeoMap | undefined;
let apiError: string | undefined;
try {
  // Inventario y mapa son opcionales: si fallan, el resto del dashboard se muestra igual
  const optional = <T,>(p: Promise<T>) => p.catch((err) => (console.error(err), undefined));
  [summary, status, inventory, geo] = await Promise.all([
    getSummary(days),
    getSyncStatus(),
    optional(getInventory()),
    optional(getMap()),
  ]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

const synced = q.get('synced');
const syncErrors = q.get('syncErrors');
const syncFailed = q.get('syncFailed');

// Patrimonio consolidado y proporciones para las barras de desglose
const inventoryValue = inventory && inventory.stacks > 0 ? inventory.value : 0;
const netWorth = (summary?.balance ?? 0) + inventoryValue;
const share = (part: number, total: number) => (total > 0 ? Math.max(0, Math.min(1, part / total)) : 0);
const flowTotal = (summary?.totals.income ?? 0) + (summary?.totals.expenses ?? 0);

// Sync más reciente entre todos los personajes
const lastSync = summary?.characters
  .map((c) => c.lastSyncAt)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);

// Antigüedad: datos «viejos» cuando superan dos intervalos de sync (o 2 h si el cron está apagado)
const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const isStale = (iso: string | null | undefined) => !iso || Date.now() - new Date(iso).getTime() > staleAfterMs;
const firstDate = summary?.coverage.firstEntryAt?.slice(0, 10) ?? null;
const partialHistory = summary && summary.coverage.firstEntryAt && summary.coverage.coveredDays < days;

// Signo del neto como estado semántico (verde/rojo + flecha), no como decoración
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
const delta = summary && summary.previous.complete ? summary.totals.net - summary.previous.net : undefined;

// Rango real del período en hora de EVE, para el subtítulo de la navegación
const range = summary ? `${shortDate(summary.period.from)} – ${shortDate(summary.period.to)}` : undefined;

const refRows = (pick: (r: Summary['byRefType'][number]) => number): BarRow[] =>
  summary?.byRefType.map((r) => ({ label: refTypeLabel(r.refType), value: pick(r), detail: `${r.count} movimientos` })) ?? [];
const incomeRows = refRows((r) => r.income);
const expenseRows = refRows((r) => r.expenses);

// Las estructuras de jugadores no tienen nombre sin el scope de estructuras
const locationLabel = (id: number, name: string | null) =>
  name ?? (id > 1_000_000_000_000 ? `Estructura #${id}` : `#${id}`);
// "Jita IV - Moon 4 - Caldari Navy Assembly Plant" → "Jita IV - Moon 4" (el nombre completo va en el tooltip)
const shortStation = (name: string) => name.split(' - ').slice(0, 2).join(' - ');
const locationRows: BarRow[] =
  inventory?.byLocation.map((l) => {
    const full = locationLabel(l.locationId, l.name);
    return { label: shortStation(full), value: l.value, detail: `${full} · ${l.stacks} stacks` };
  }) ?? [];
const valuableItems = inventory?.topItems.map((i) => ({ ...i, isk: i.value })) ?? [];
const inventoryByChar = new Map(inventory?.byCharacter.map((c) => [c.characterId, c.value]));
---

<Base section="resumen" status={status} pilots={summary?.characters.length}>
    <nav class="main-nav shell" aria-label="Período" slot="nav">
      <div class="nav-tabs">
        {
          PERIODS.map((p) => (
            <a class="nav-tab" href={`/?days=${p}`} aria-current={p === days ? 'page' : undefined}>
              <Icon name="clock" />
              {p} días
            </a>
          ))
        }
      </div>
      <p class="period-meta">
        {range && <span>{range} · hora EVE</span>}
        {
          partialHistory && (
            <span class="coverage" title="ESI solo guarda ~30 días del journal: el historial crece desde el primer sync">
              <Icon name="info" />
              Historial desde {shortDate(summary!.coverage.firstEntryAt!)} ({summary!.coverage.coveredDays} de {days} días)
            </span>
          )
        }
        {
          lastSync && (
            <span class:list={['fresh', { stale: isStale(lastSync) }]}>
              <Icon name={isStale(lastSync) ? 'alert' : 'activity'} />
              Actualizado <time datetime={lastSync} data-ago={lastSync}>{ago(lastSync)}</time>
            </span>
          )
        }
      </p>
    </nav>

      <h1 class="sr-only">Resumen de los últimos {days} días</h1>

      {
        synced !== null && (
          <div class="notice">
            <Icon name="info" />
            <p>
              Sincronización completa: {synced} movimientos nuevos
              {syncErrors && (
                <strong>
                  {' '}
                  · {syncErrors} {syncErrors === '1' ? 'piloto con error' : 'pilotos con error'}: revisa el{' '}
                  <a href={syncLogUrl}>registro de sync</a>
                </strong>
              )}
            </p>
          </div>
        )
      }
      {
        summary && summary.characters.length > 0 && isStale(lastSync) && (
          <div class="notice warning" role="status">
            <Icon name="alert" />
            <p>
              <strong>Datos desactualizados:</strong> el último sync fue {lastSync ? ago(lastSync) : 'nunca'}.
              {status && !status.enabled
                ? ' El sync automático está desactivado (SYNC_INTERVAL_MIN=0); '
                : ' El sync automático no ha podido completarse; '}
              pulsa «Sincronizar» o revisa el <a href={syncLogUrl}>registro de sync</a>.
            </p>
          </div>
        )
      }
      {
        syncFailed && (
          <div class="notice error">
            <Icon name="alert" />
            <p>No se pudo sincronizar: {syncFailed}</p>
          </div>
        )
      }

      {
        apiError && (
          <div class="notice error">
            <Icon name="alert" />
            <div>
              <strong>Sin enlace con la API</strong>
              <p class="muted">{apiError}</p>
              <p>
                ¿Está corriendo? En <code>apps/api</code>: <code>bun run dev</code>
              </p>
            </div>
          </div>
        )
      }

      {
        summary && summary.characters.length === 0 && (
          <div class="notice">
            <Icon name="users" />
            <p>
              Aún no hay pilotos vinculados. <a href={loginUrl}>Vincula tu primer personaje</a> y luego pulsa
              «Sincronizar».
            </p>
          </div>
        )
      }

      {
        summary && summary.characters.length > 0 && (
          <>
            <section class="glance" aria-label="Resumen">
              <div class="panel stat hero-stat">
                <span class="label">
                  <Icon name="activity" />
                  Neto · últimos {days} días
                </span>
                <span class:list={['value', 'signed', sign(summary.totals.net)]} title={iskFull(summary.totals.net)}>
                  {summary.totals.net !== 0 && <Icon name={summary.totals.net > 0 ? 'up' : 'down'} class="trend" />}
                  {isk(summary.totals.net, { sign: true })}
                  <small>ISK</small>
                  <span class="sr-only">{summary.totals.net >= 0 ? '(ganancia)' : '(pérdida)'}</span>
                </span>
                <p class="versus">
                  {delta !== undefined ? (
                    <>
                      <span class:list={['delta', sign(delta)]}>{isk(delta, { sign: true })}</span> frente a los {days} días
                      anteriores ({isk(summary.previous.net, { sign: true })})
                    </>
                  ) : (
                    <>Sin {days} días anteriores completos para comparar todavía</>
                  )}
                </p>
                <div class="ratio" aria-hidden="true">
                  {summary.totals.income > 0 && (
                    <i class="income" style={`flex-grow:${share(summary.totals.income, flowTotal)}`} />
                  )}
                  {summary.totals.expenses > 0 && (
                    <i class="expenses" style={`flex-grow:${share(summary.totals.expenses, flowTotal)}`} />
                  )}
                </div>
                <dl class="breakdown">
                  <div>
                    <dt>
                      <i class="key income" />
                      Ingresos
                    </dt>
                    <dd title={iskFull(summary.totals.income)}>{isk(summary.totals.income)}</dd>
                  </div>
                  <div>
                    <dt>
                      <i class="key expenses" />
                      Gastos
                    </dt>
                    <dd title={iskFull(-summary.totals.expenses)}>{isk(-summary.totals.expenses)}</dd>
                  </div>
                </dl>
                <div class="today" title={`Desde las 00:00 EVE (UTC): ${iskFull(summary.today.net)}`}>
                  <span class="today-label">
                    <Icon name="clock" />
                    Hoy (EVE)
                  </span>
                  <span class:list={['today-value', sign(summary.today.net)]}>{isk(summary.today.net, { sign: true })}</span>
                  <span class="today-detail">
                    {isk(summary.today.income)} entran · {isk(summary.today.expenses)} salen
                  </span>
                </div>
                {summary.internalTransfers > 0 && (
                  <span class="sub">No incluye {isk(summary.internalTransfers)} ISK movidos entre tus pilotos</span>
                )}
              </div>
              <div class="panel stat worth">
                <div class="worth-head">
                  <div>
                    <span class="label">
                      <Icon name="wallet" />
                      Patrimonio
                    </span>
                    <span class="value" title={iskFull(netWorth)}>
                      {isk(netWorth)}
                      <small>ISK</small>
                    </span>
                  </div>
                  <dl class="breakdown">
                    <div>
                      <dt>
                        <i class="key balance" />
                        Wallets
                      </dt>
                      <dd title={iskFull(summary.balance)}>{isk(summary.balance)}</dd>
                    </div>
                    <div>
                      <dt>
                        <i class="key inventory" />
                        Inventario
                      </dt>
                      <dd title={inventoryValue ? iskFull(inventoryValue) : 'Sin inventario sincronizado'}>
                        {inventoryValue ? isk(inventoryValue) : '—'}
                      </dd>
                    </div>
                  </dl>
                </div>
                {geo && <NewEdenMap map={geo} />}
              </div>
            </section>

            <ul class="pilot-strip" aria-label="Neto por piloto">
              {summary.characters.map((c) => (
                <li>
                  <a
                    href="#pilotos"
                    class:list={{ stale: isStale(c.lastSyncAt) }}
                    title={`${c.name}: neto ${iskFull(c.net)} en ${days} días` + (isStale(c.lastSyncAt) ? ` · sin sync ${ago(c.lastSyncAt)}` : '')}
                  >
                    {isStale(c.lastSyncAt) && <Icon name="alert" class="stale-icon" />}
                    <span class="pilot-name">{c.name}</span>
                    <span class:list={['pilot-net', { pos: c.net > 0, neg: c.net < 0 }]}>{isk(c.net, { sign: true })}</span>
                  </a>
                </li>
              ))}
            </ul>

            <section class="panel">
              <div class="panel-heading">
                <h3>Flujo diario</h3>
                <span class="meta">Hora de EVE (UTC)</span>
              </div>
              <div class="panel-body">
                <DailyChart daily={summary.daily} firstDate={firstDate} />
              </div>
            </section>

            <div class="split">
              <BarList title="De dónde viene el ISK" kind="income" rows={incomeRows} />
              <BarList title="En qué se va" kind="expenses" rows={expenseRows} />
            </div>

            {(summary.market.sold.length > 0 || summary.market.bought.length > 0) && (
              <div class="split">
                <MarketItems
                  title="Mercado: lo más vendido"
                  items={summary.market.sold.map((i) => ({ ...i, unitPrice: i.avgPrice }))}
                />
                <MarketItems
                  title="Mercado: lo más comprado"
                  items={summary.market.bought.map((i) => ({ ...i, unitPrice: i.avgPrice }))}
                />
              </div>
            )}

            {inventory && inventory.stacks > 0 && (
              <div class="split">
                <BarList title="Dónde está tu inventario" kind="inventory" rows={locationRows} limit={11} />
                <MarketItems
                  title="Lo más valioso"
                  items={valuableItems}
                  iskLabel="Valor"
                  priceLabel="Precio unitario"
                  empty="Sin inventario sincronizado."
                />
              </div>
            )}

            <section class="panel">
              <div class="panel-heading">
                <h3 id="pilotos">Pilotos</h3>
                <a class="meta link" href="/pilotos">
                  <Icon name="users" />
                  Gestionar pilotos
                </a>
              </div>
              <div class="scroll">
                <table class="pilots">
                  <thead>
                    <tr>
                      <th>Piloto</th>
                      <th>Saldo</th>
                      <th>Inventario</th>
                      <th>Ingresos</th>
                      <th>Gastos</th>
                      <th>Neto</th>
                      <th>Último sync</th>
                    </tr>
                  </thead>
                  <tbody>
                    {summary.characters.map((c) => (
                      <tr>
                        <td>
                          <span class="who">
                            <img
                              src={`https://images.evetech.net/characters/${c.id}/portrait?size=64`}
                              alt=""
                              width="30"
                              height="30"
                              loading="lazy"
                              onerror="this.style.visibility='hidden'"
                            />
                            {c.name}
                          </span>
                        </td>
                        <td title={c.balance === null ? 'Sin movimientos sincronizados' : iskFull(c.balance)}>
                          {c.balance === null ? '—' : isk(c.balance)}
                        </td>
                        <td
                          title={
                            inventoryByChar.has(c.id) ? iskFull(inventoryByChar.get(c.id)!) : 'Sin inventario sincronizado'
                          }
                        >
                          {inventoryByChar.has(c.id) ? isk(inventoryByChar.get(c.id)!) : '—'}
                        </td>
                        <td>{isk(c.income)}</td>
                        <td>{isk(-c.expenses)}</td>
                        <td class:list={{ pos: c.net > 0, neg: c.net < 0 }}>{isk(c.net, { sign: true })}</td>
                        <td class:list={['last-sync', { stale: isStale(c.lastSyncAt) }]}>
                          {isStale(c.lastSyncAt) && <Icon name="alert" class="stale-icon" />}
                          {c.lastSyncAt ? <time datetime={c.lastSyncAt} data-ago={c.lastSyncAt}>{ago(c.lastSyncAt)}</time> : 'nunca'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="panel-note">
                Saldo = balance del último movimiento sincronizado. Inventario valorado con el precio medio de ESI
                {inventory?.pricesUpdatedAt && <> (actualizado {ago(inventory.pricesUpdatedAt)})</>}; las copias de
                blueprint cuentan como 0
                {inventory && inventory.unpricedTypes > 0 && (
                  <>
                    {' '}
                    y hay {inventory.unpricedTypes} {inventory.unpricedTypes === 1 ? 'tipo de ítem' : 'tipos de ítem'} sin
                    precio
                  </>
                )}
                .
              </p>
            </section>
          </>
        )
      }
</Base>

<style>
  .glance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 16px;
  }
  .today {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 2px 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .today-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .today-label .icon {
    width: 14px;
    height: 14px;
  }
  .today-value {
    font: 500 22px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .signed {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .signed .trend {
    align-self: center;
    width: 28px;
    height: 28px;
    stroke-width: 2;
  }
  .pos,
  .stat .value.pos {
    color: var(--positive);
  }
  .neg,
  .stat .value.neg {
    color: var(--critical);
  }
  .hero-stat .value.zero {
    color: var(--text);
  }
  .versus {
    font-size: 12px;
    color: var(--text-muted);
  }
  .delta {
    font: 500 12px var(--mono);
  }
  .today-detail {
    grid-column: 2;
    font-size: 12px;
    color: var(--text-muted);
  }
  .worth-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .worth-head > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .worth .breakdown {
    grid-template-columns: repeat(2, auto);
    gap: 20px;
  }
  .pilot-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pilot-strip a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-2);
    color: var(--text-secondary);
    font-size: 13px;
    text-decoration: none;
  }
  .pilot-strip a:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .stale,
  .period-meta .fresh.stale {
    color: var(--warning);
  }
  .pilot-strip a.stale {
    border-color: #6b5530;
  }
  .stale-icon {
    width: 13px;
    height: 13px;
    color: var(--warning);
  }
  td.last-sync {
    color: var(--text-muted);
  }
  td.last-sync.stale {
    color: var(--warning);
  }
  td.last-sync .stale-icon {
    margin-right: 6px;
    vertical-align: -2px;
  }
  .period-meta .coverage {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }
  .period-meta .coverage .icon {
    width: 14px;
    height: 14px;
    color: var(--cyan-dim);
  }
  .pilot-net {
    font: 500 13px var(--mono);
    color: var(--text);
  }
  .pilot-net.pos {
    color: var(--positive);
  }
  .pilot-net.neg {
    color: var(--critical);
  }
  .ratio {
    display: flex;
    gap: 2px;
    height: 6px;
    margin: 10px 0 4px;
  }
  .ratio i {
    flex-basis: 0;
    min-width: 2px;
    border-radius: 2px;
  }
  .income {
    background: var(--income);
  }
  .expenses {
    background: var(--expenses);
  }
  .balance {
    background: var(--balance);
  }
  .inventory {
    background: var(--inventory);
  }
  .breakdown {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 6px 0 0;
  }
  .breakdown div {
    min-width: 0;
  }
  .breakdown dt {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .breakdown dd {
    margin: 2px 0 0;
    font: 500 18px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .key {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .stat .sub {
    margin-top: 6px;
  }
  .panel-heading a.link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 12px var(--font);
    color: var(--cyan);
  }
  .panel-heading a.link .icon {
    width: 14px;
    height: 14px;
  }
  @media (max-width: 1040px) {
    .glance {
      grid-template-columns: 1fr;
    }
  }
  .pilots th:first-child,
  .pilots td:first-child {
    padding-left: 22px;
  }
  .pilots th:last-child,
  .pilots td:last-child {
    padding-right: 22px;
  }
  .panel-heading a.meta:hover {
    color: var(--cyan);
    text-decoration: none;
  }
  code {
    font: 12px var(--mono);
    color: var(--cyan);
  }
</style>
