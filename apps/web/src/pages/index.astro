---
import Base from '../layouts/Base.astro';
import DailyChart from '../components/DailyChart.astro';
import Icon from '../components/Icon.astro';
import NewEdenMap from '../components/NewEdenMap.astro';
import MarketItems from '../components/MarketItems.astro';
import BarList, { type BarRow } from '../components/BarList.astro';
import {
  getInventory,
  getMap,
  getSummary,
  getSyncStatus,
  loginUrl,
  syncLogUrl,
  type GeoMap,
  type Inventory,
  type Summary,
  type SyncStatus,
} from '../lib/api';
import { ago, isk, iskFull, refTypeLabel, shortDate } from '../lib/format';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro);
const m = t(lang);
const fmt = (v: number, o: { sign?: boolean } = {}) => isk(v, { ...o, lang });
const full = (v: number) => iskFull(v, lang);
const date = (iso: string) => shortDate(iso, lang);
const rel = (iso: string | null) => ago(iso, lang);
const refLabel = (ref: string) => refTypeLabel(ref, lang);

const PERIODS = [7, 30, 90];
const q = Astro.url.searchParams;
const days = PERIODS.includes(Number(q.get('days'))) ? Number(q.get('days')) : 30;

let summary: Summary | undefined;
let status: SyncStatus | undefined;
let inventory: Inventory | undefined;
let geo: GeoMap | undefined;
let apiError: string | undefined;
try {
  // Inventario y mapa son opcionales: si fallan, el resto del dashboard se muestra igual
  const optional = <T,>(p: Promise<T>) => p.catch((err) => (console.error(err), undefined));
  [summary, status, inventory, geo] = await Promise.all([
    getSummary(days),
    getSyncStatus(),
    optional(getInventory()),
    optional(getMap()),
  ]);
} catch (err) {
  apiError = err instanceof Error ? err.message : String(err);
}

const synced = q.get('synced');
const syncErrors = q.get('syncErrors');
const syncFailed = q.get('syncFailed');

// Patrimonio consolidado y proporciones para las barras de desglose
const inventoryValue = inventory && inventory.stacks > 0 ? inventory.value : 0;
const netWorth = (summary?.balance ?? 0) + inventoryValue;
const share = (part: number, total: number) => (total > 0 ? Math.max(0, Math.min(1, part / total)) : 0);
const flowTotal = (summary?.totals.income ?? 0) + (summary?.totals.expenses ?? 0);

// Sync más reciente entre todos los personajes
const lastSync = summary?.characters
  .map((c) => c.lastSyncAt)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);

// Antigüedad: datos «viejos» cuando superan dos intervalos de sync (o 2 h si el cron está apagado)
const staleAfterMs = 2 * (status?.enabled ? status.intervalMin : 60) * 60_000;
const isStale = (iso: string | null | undefined) => !iso || Date.now() - new Date(iso).getTime() > staleAfterMs;
const firstDate = summary?.coverage.firstEntryAt?.slice(0, 10) ?? null;
const partialHistory = summary && summary.coverage.firstEntryAt && summary.coverage.coveredDays < days;

// Signo del neto como estado semántico (verde/rojo + flecha), no como decoración
const sign = (v: number) => (v > 0 ? 'pos' : v < 0 ? 'neg' : 'zero');
const delta = summary && summary.previous.complete ? summary.totals.net - summary.previous.net : undefined;

// Rango real del período en hora de EVE, para el subtítulo de la navegación
const range = summary ? `${date(summary.period.from)} – ${date(summary.period.to)}` : undefined;

const refRows = (pick: (r: Summary['byRefType'][number]) => number): BarRow[] =>
  summary?.byRefType.map((r) => ({ label: refLabel(r.refType), value: pick(r), detail: m.entries(r.count) })) ?? [];
const incomeRows = refRows((r) => r.income);
const expenseRows = refRows((r) => r.expenses);

// Las estructuras de jugadores no tienen nombre sin el scope de estructuras
const locationLabel = (id: number, name: string | null) =>
  name ?? (id > 1_000_000_000_000 ? m.structure(id) : `#${id}`);
// "Jita IV - Moon 4 - Caldari Navy Assembly Plant" → "Jita IV - Moon 4" (el nombre completo va en el tooltip)
const shortStation = (name: string) => name.split(' - ').slice(0, 2).join(' - ');
const locationRows: BarRow[] =
  inventory?.byLocation.map((l) => {
    const full = locationLabel(l.locationId, l.name);
    return { label: shortStation(full), value: l.value, detail: `${full} · ${m.stacks(l.stacks)}` };
  }) ?? [];
const valuableItems = inventory?.topItems.map((i) => ({ ...i, isk: i.value })) ?? [];
const inventoryByChar = new Map(inventory?.byCharacter.map((c) => [c.characterId, c.value]));
---

<Base section="resumen" status={status} pilots={summary?.characters.length}>
    <nav class="main-nav shell" aria-label={m.period} slot="nav">
      <div class="nav-tabs">
        {
          PERIODS.map((p) => (
            <a class="nav-tab" href={`/?days=${p}`} aria-current={p === days ? 'page' : undefined}>
              <Icon name="clock" />
              {m.days(p)}
            </a>
          ))
        }
      </div>
      <p class="period-meta">
        {range && <span>{range} · {m.eveTime}</span>}
        {
          partialHistory && (
            <span class="coverage" title={m.coverageTitle}>
              <Icon name="info" />
              {m.coverage(date(summary!.coverage.firstEntryAt!), summary!.coverage.coveredDays, days)}
            </span>
          )
        }
        {
          lastSync && (
            <span class:list={['fresh', { stale: isStale(lastSync) }]}>
              <Icon name={isStale(lastSync) ? 'alert' : 'activity'} />
              {m.updated} <time datetime={lastSync} data-ago={lastSync}>{rel(lastSync)}</time>
            </span>
          )
        }
      </p>
    </nav>

      <h1 class="sr-only">{m.summaryH1(days)}</h1>

      {
        synced !== null && (
          <div class="notice">
            <Icon name="info" />
            <p>
              {m.syncDone(synced)}
              {syncErrors && (
                <strong>
                  {' '}
                  · {m.syncErrors(Number(syncErrors))} <a href={syncLogUrl}>{m.syncLog}</a>
                </strong>
              )}
            </p>
          </div>
        )
      }
      {
        summary && summary.characters.length > 0 && isStale(lastSync) && (
          <div class="notice warning" role="status">
            <Icon name="alert" />
            <p>
              <strong>{m.staleTitle}</strong> {m.staleLast(rel(lastSync ?? null))}{' '}
              {status && !status.enabled ? m.staleCronOff : m.staleCronFailed} {m.staleAction}{' '}
              <a href={syncLogUrl}>{m.syncLog}</a>.
            </p>
          </div>
        )
      }
      {
        syncFailed && (
          <div class="notice error">
            <Icon name="alert" />
            <p>{m.syncFailed} {syncFailed}</p>
          </div>
        )
      }

      {
        apiError && (
          <div class="notice error">
            <Icon name="alert" />
            <div>
              <strong>{m.apiDown}</strong>
              <p class="muted">{apiError}</p>
              <p>
                {m.apiRunning} <code>apps/api</code>: <code>bun run dev</code>
              </p>
            </div>
          </div>
        )
      }

      {
        summary && summary.characters.length === 0 && (
          <div class="notice">
            <Icon name="users" />
            <p>
              {m.noPilots} <a href={loginUrl}>{m.linkFirst}</a> {m.thenSync}
            </p>
          </div>
        )
      }

      {
        summary && summary.characters.length > 0 && (
          <>
            <section class="glance" aria-label={m.summary}>
              <div class="panel stat hero-stat">
                <span class="label">
                  <Icon name="activity" />
                  {m.netPeriod(days)}
                </span>
                <span class:list={['value', 'signed', sign(summary.totals.net)]} title={full(summary.totals.net)}>
                  {summary.totals.net !== 0 && <Icon name={summary.totals.net > 0 ? 'up' : 'down'} class="trend" />}
                  {fmt(summary.totals.net, { sign: true })}
                  <small>ISK</small>
                  <span class="sr-only">{summary.totals.net >= 0 ? m.gain : m.loss}</span>
                </span>
                <p class="versus">
                  {delta !== undefined ? (
                    <>
                      <span class:list={['delta', sign(delta)]}>{fmt(delta, { sign: true })}</span>{' '}
                      {m.versus(days, fmt(summary.previous.net, { sign: true }))}
                    </>
                  ) : (
                    <>{m.noPrevious(days)}</>
                  )}
                </p>
                <div class="ratio" aria-hidden="true">
                  {summary.totals.income > 0 && (
                    <i class="income" style={`flex-grow:${share(summary.totals.income, flowTotal)}`} />
                  )}
                  {summary.totals.expenses > 0 && (
                    <i class="expenses" style={`flex-grow:${share(summary.totals.expenses, flowTotal)}`} />
                  )}
                </div>
                <dl class="breakdown">
                  <div>
                    <dt>
                      <i class="key income" />
                      {m.income}
                    </dt>
                    <dd title={full(summary.totals.income)}>{fmt(summary.totals.income)}</dd>
                  </div>
                  <div>
                    <dt>
                      <i class="key expenses" />
                      {m.expenses}
                    </dt>
                    <dd title={full(-summary.totals.expenses)}>{fmt(-summary.totals.expenses)}</dd>
                  </div>
                </dl>
                <div class="today" title={m.todayTitle(full(summary.today.net))}>
                  <span class="today-label">
                    <Icon name="clock" />
                    {m.today}
                  </span>
                  <span class:list={['today-value', sign(summary.today.net)]}>{fmt(summary.today.net, { sign: true })}</span>
                  <span class="today-detail">
                    {m.todayFlow(fmt(summary.today.income), fmt(summary.today.expenses))}
                  </span>
                </div>
                {summary.internalTransfers > 0 && (
                  <span class="sub">{m.internal(fmt(summary.internalTransfers))}</span>
                )}
              </div>
              <div class="panel stat worth">
                <div class="worth-head">
                  <div>
                    <span class="label">
                      <Icon name="wallet" />
                      {m.netWorth}
                    </span>
                    <span class="value" title={full(netWorth)}>
                      {fmt(netWorth)}
                      <small>ISK</small>
                    </span>
                  </div>
                  <dl class="breakdown">
                    <div>
                      <dt>
                        <i class="key balance" />
                        {m.wallets}
                      </dt>
                      <dd title={full(summary.balance)}>{fmt(summary.balance)}</dd>
                    </div>
                    <div>
                      <dt>
                        <i class="key inventory" />
                        {m.inventory}
                      </dt>
                      <dd title={inventoryValue ? full(inventoryValue) : m.noInventory}>
                        {inventoryValue ? fmt(inventoryValue) : '—'}
                      </dd>
                    </div>
                  </dl>
                </div>
                {geo && <NewEdenMap map={geo} />}
              </div>
            </section>

            <ul class="pilot-strip" aria-label={m.netByPilot}>
              {summary.characters.map((c) => (
                <li>
                  <a
                    href="#pilotos"
                    class:list={{ stale: isStale(c.lastSyncAt) }}
                    title={m.pilotNetTitle(c.name, full(c.net), days) + (isStale(c.lastSyncAt) ? m.noSyncSince(rel(c.lastSyncAt)) : '')}
                  >
                    {isStale(c.lastSyncAt) && <Icon name="alert" class="stale-icon" />}
                    <span class="pilot-name">{c.name}</span>
                    <span class:list={['pilot-net', { pos: c.net > 0, neg: c.net < 0 }]}>
                      {c.lastSyncAt ? fmt(c.net, { sign: true }) : '—'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>

            <section class="panel">
              <div class="panel-heading">
                <h3>{m.dailyFlow}</h3>
                <span class="meta">{m.eveTimeUtc}</span>
              </div>
              <div class="panel-body">
                <DailyChart daily={summary.daily} firstDate={firstDate} />
              </div>
            </section>

            <div class="split">
              <BarList title={m.whereFrom} kind="income" rows={incomeRows} />
              <BarList title={m.whereTo} kind="expenses" rows={expenseRows} />
            </div>

            {(summary.market.sold.length > 0 || summary.market.bought.length > 0) && (
              <div class="split">
                <MarketItems
                  title={m.topSold}
                  items={summary.market.sold.map((i) => ({ ...i, unitPrice: i.avgPrice }))}
                />
                <MarketItems
                  title={m.topBought}
                  items={summary.market.bought.map((i) => ({ ...i, unitPrice: i.avgPrice }))}
                />
              </div>
            )}

            {inventory && inventory.stacks > 0 && (
              <div class="split">
                <BarList title={m.whereInventory} kind="inventory" rows={locationRows} limit={11} />
                <MarketItems
                  title={m.mostValuable}
                  items={valuableItems}
                  iskLabel={m.value}
                  priceLabel={m.unitPrice}
                  empty={m.noInventoryDot}
                />
              </div>
            )}

            <section class="panel">
              <div class="panel-heading">
                <h3 id="pilotos">{m.pilots}</h3>
                <a class="meta link" href="/pilotos">
                  <Icon name="users" />
                  {m.managePilots}
                </a>
              </div>
              <div class="scroll">
                <table class="pilots">
                  <thead>
                    <tr>
                      <th>{m.pilot}</th>
                      <th>{m.balance}</th>
                      <th>{m.inventory}</th>
                      <th>{m.income}</th>
                      <th>{m.expenses}</th>
                      <th>{m.net}</th>
                      <th>{m.lastSync}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {summary.characters.map((c) => (
                      <tr>
                        <td>
                          <span class="who">
                            <img
                              src={`https://images.evetech.net/characters/${c.id}/portrait?size=64`}
                              alt=""
                              width="30"
                              height="30"
                              loading="lazy"
                              onerror="this.style.visibility='hidden'"
                            />
                            {c.name}
                          </span>
                        </td>
                        <td title={c.balance === null ? m.noEntries : full(c.balance)}>
                          {c.balance === null ? '—' : fmt(c.balance)}
                        </td>
                        <td
                          title={
                            inventoryByChar.has(c.id) ? full(inventoryByChar.get(c.id)!) : m.noInventory
                          }
                        >
                          {inventoryByChar.has(c.id) ? fmt(inventoryByChar.get(c.id)!) : '—'}
                        </td>
                        <td>{fmt(c.income)}</td>
                        <td>{fmt(-c.expenses)}</td>
                        <td class:list={{ pos: c.net > 0, neg: c.net < 0 }}>{fmt(c.net, { sign: true })}</td>
                        <td class:list={['last-sync', { stale: isStale(c.lastSyncAt) }]}>
                          {isStale(c.lastSyncAt) && <Icon name="alert" class="stale-icon" />}
                          {c.lastSyncAt ? <time datetime={c.lastSyncAt} data-ago={c.lastSyncAt}>{rel(c.lastSyncAt)}</time> : m.never}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="panel-note">
                {m.noteBalance}
                {inventory?.pricesUpdatedAt && m.notePrices(rel(inventory.pricesUpdatedAt))}
                {m.noteBpc}
                {inventory && inventory.unpricedTypes > 0 && m.noteUnpriced(inventory.unpricedTypes)}.
              </p>
            </section>
          </>
        )
      }
</Base>

<style>
  .glance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 16px;
  }
  .today {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 2px 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .today-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .today-label .icon {
    width: 14px;
    height: 14px;
  }
  .today-value {
    font: 500 22px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .signed {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .signed .trend {
    align-self: center;
    width: 28px;
    height: 28px;
    stroke-width: 2;
  }
  .pos,
  .stat .value.pos {
    color: var(--positive);
  }
  .neg,
  .stat .value.neg {
    color: var(--critical);
  }
  .hero-stat .value.zero {
    color: var(--text);
  }
  .versus {
    font-size: 12px;
    color: var(--text-muted);
  }
  .delta {
    font: 500 12px var(--mono);
  }
  .today-detail {
    grid-column: 2;
    font-size: 12px;
    color: var(--text-muted);
  }
  .worth-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .worth-head > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .worth .breakdown {
    grid-template-columns: repeat(2, auto);
    gap: 20px;
  }
  .pilot-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pilot-strip a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-2);
    color: var(--text-secondary);
    font-size: 13px;
    text-decoration: none;
  }
  .pilot-strip a:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .stale,
  .period-meta .fresh.stale {
    color: var(--warning);
  }
  .pilot-strip a.stale {
    border-color: #6b5530;
  }
  .stale-icon {
    width: 13px;
    height: 13px;
    color: var(--warning);
  }
  td.last-sync {
    color: var(--text-muted);
  }
  td.last-sync.stale {
    color: var(--warning);
  }
  td.last-sync .stale-icon {
    margin-right: 6px;
    vertical-align: -2px;
  }
  .period-meta .coverage {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }
  .period-meta .coverage .icon {
    width: 14px;
    height: 14px;
    color: var(--cyan-dim);
  }
  .pilot-net {
    font: 500 13px var(--mono);
    color: var(--text);
  }
  .pilot-net.pos {
    color: var(--positive);
  }
  .pilot-net.neg {
    color: var(--critical);
  }
  .ratio {
    display: flex;
    gap: 2px;
    height: 6px;
    margin: 10px 0 4px;
  }
  .ratio i {
    flex-basis: 0;
    min-width: 2px;
    border-radius: 2px;
  }
  .income {
    background: var(--income);
  }
  .expenses {
    background: var(--expenses);
  }
  .balance {
    background: var(--balance);
  }
  .inventory {
    background: var(--inventory);
  }
  .breakdown {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 6px 0 0;
  }
  .breakdown div {
    min-width: 0;
  }
  .breakdown dt {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .breakdown dd {
    margin: 2px 0 0;
    font: 500 18px var(--mono);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .key {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .stat .sub {
    margin-top: 6px;
  }
  .panel-heading a.link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 12px var(--font);
    color: var(--cyan);
  }
  .panel-heading a.link .icon {
    width: 14px;
    height: 14px;
  }
  @media (max-width: 1040px) {
    .glance {
      grid-template-columns: 1fr;
    }
  }
  .pilots th:first-child,
  .pilots td:first-child {
    padding-left: 22px;
  }
  .pilots th:last-child,
  .pilots td:last-child {
    padding-right: 22px;
  }
  .panel-heading a.meta:hover {
    color: var(--cyan);
    text-decoration: none;
  }
  code {
    font: 12px var(--mono);
    color: var(--cyan);
  }
</style>
